+static const char* paper_waveform_name(int32_t mode) {
+    switch (mode & 0x0f) {
+        case 0: return "INIT";
+        case 1: return "DU";
+        case 2: return "GC16";
+        case 3: return "GC4";
+        case 4: return "ANIM";
+        case 5: return "A2/AUTO";
+        case 6: return "GL16";
+        case 7: return "GLR16";
+        case 8: return "GLD16";
+        default: return "UNKNOWN";
+    }
+}
+
+/* Mirror the PAPER PRO periodic cleanup policy for emulator log validation. */
+static void paper_apply_periodic_refresh(hwc_layer_1_t* layer) {
+    int32_t mode = -1;
+    memcpy(&mode, layer->reserved, sizeof(mode));
+    if (mode == -1) return;
+
+    char value[PROPERTY_VALUE_MAX];
+    property_get("persist.sys.ridi.epd.full_refresh_interval", value, "10");
+    const int requested_interval = atoi(value);
+    const int interval = requested_interval == 0 || requested_interval == 1 ||
+            requested_interval == 3 || requested_interval == 5 ||
+            requested_interval == 10 || requested_interval == 20
+            ? requested_interval : 10;
+
+    static unsigned int partial_updates = 0;
+    static unsigned int force_serial_seen = 0;
+    property_get("sys.ridi.epd.full_refresh_seq", value, "0");
+    const unsigned int force_serial = (unsigned int)strtoul(value, NULL, 10);
+    const bool forced = force_serial != 0 && force_serial != force_serial_seen;
+    if (forced) force_serial_seen = force_serial;
+
+    const bool already_full = (mode & 0x20) != 0;
+    const bool periodic = interval > 0 && partial_updates + 1 >=
+            (unsigned int)interval;
+    if (forced || periodic) {
+        mode = (mode & ~0x0f) | 0x02; // GC16
+        mode |= 0x20;                // FULL
+        memcpy(layer->reserved, &mode, sizeof(mode));
+        partial_updates = 0;
+    } else if (already_full) {
+        partial_updates = 0;
+    } else {
+        partial_updates++;
+    }
+}
+
+static void paper_log_epdc_update(uint64_t frame, size_t layer,
+                                  const hwc_layer_1_t* hwcLayer) {
+    int32_t mode = -1;
+    static_assert(sizeof(hwcLayer->reserved) >= sizeof(mode),
+                  "hwc_layer_1_t reserved area is too small for E Ink policy");
+    memcpy(&mode, hwcLayer->reserved, sizeof(mode));
+    if (mode == -1) return;
+
+    const hwc_region_t& damage = hwcLayer->surfaceDamage;
+    if (damage.numRects == 0 || damage.rects == NULL) {
+        __android_log_print(ANDROID_LOG_INFO, "PAPER_EPDC",
+              "frame=%llu layer=%zu mode=0x%08x wave=%s "
+              "update=%s wait=%s source=%s damage=FULL_OR_UNKNOWN",
+              (unsigned long long)frame, layer, (unsigned int)mode,
+              paper_waveform_name(mode), (mode & 0x20) ? "FULL" : "PARTIAL",
+              (mode & 0x40) ? "WAIT" : "NOWAIT",
+              (mode & 0x10000000) ? "SYSTEM" : "APP");
+        return;
+    }
+
+    int left = damage.rects[0].left;
+    int top = damage.rects[0].top;
+    int right = damage.rects[0].right;
+    int bottom = damage.rects[0].bottom;
+    for (size_t i = 1; i < damage.numRects; ++i) {
+        if (damage.rects[i].left < left) left = damage.rects[i].left;
+        if (damage.rects[i].top < top) top = damage.rects[i].top;
+        if (damage.rects[i].right > right) right = damage.rects[i].right;
+        if (damage.rects[i].bottom > bottom) bottom = damage.rects[i].bottom;
+    }
+    __android_log_print(ANDROID_LOG_INFO, "PAPER_EPDC",
+          "frame=%llu layer=%zu mode=0x%08x wave=%s "
+          "update=%s wait=%s source=%s damage=%d,%d-%d,%d rects=%zu",
+          (unsigned long long)frame, layer, (unsigned int)mode,
+          paper_waveform_name(mode), (mode & 0x20) ? "FULL" : "PARTIAL",
+          (mode & 0x40) ? "WAIT" : "NOWAIT",
+          (mode & 0x10000000) ? "SYSTEM" : "APP",
+          left, top, right, bottom, damage.numRects);
+}
