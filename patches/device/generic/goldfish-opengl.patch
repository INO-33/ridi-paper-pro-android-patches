 #define PARTITION "/vendor"
 #else
 #define PARTITION "/system"
@@ -571,4 +573,3 @@ void eglDisplay::onDestroySurface(EGLSurface surface) {
     m_surfaces.erase(surface);
     pthread_mutex_unlock(&m_surfaceLock);
 }
