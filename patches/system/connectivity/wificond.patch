+void AppendLegacyStationInfoAttributes(NL80211Packet* packet) {
+  NL80211NestedAttr tx_bitrate(NL80211_STA_INFO_TX_BITRATE);
+  tx_bitrate.AddAttribute(NL80211Attr<uint16_t>(
+      NL80211_RATE_INFO_BITRATE, kFakeLegacyTxBitrate));
+
+  NL80211NestedAttr station_info(NL80211_ATTR_STA_INFO);
+  station_info.AddAttribute(NL80211Attr<int32_t>(
+      NL80211_STA_INFO_TX_PACKETS, kFakeTxPackets));
+  station_info.AddAttribute(NL80211Attr<int8_t>(
+      NL80211_STA_INFO_SIGNAL, kFakeRssi));
+  station_info.AddAttribute(tx_bitrate);
+  packet->AddAttribute(station_info);
+}
