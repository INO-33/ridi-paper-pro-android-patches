diff --git a/java/lite/res/xml/method.xml b/java/lite/res/xml/method.xml
new file mode 100644
index 0000000000000000000000000000000000000000..6f38efc04d05f3d7ef887f4bd09d93951104b318
--- /dev/null
+++ b/java/lite/res/xml/method.xml
@@ -0,0 +1,14 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Default IME discovery requires a keyboard subtype matching the locale,
+     or an English fallback. The service handles both layouts internally. -->
+<input-method xmlns:android="http://schemas.android.com/apk/res/android"
+    android:isDefault="@bool/im_is_default"
+    android:supportsSwitchingToNextInputMethod="false">
+    <subtype
+        android:imeSubtypeLocale="ko_KR"
+        android:imeSubtypeMode="keyboard" />
+    <subtype
+        android:imeSubtypeLocale="en_US"
+        android:imeSubtypeMode="keyboard"
+        android:isAsciiCapable="true" />
+</input-method>
