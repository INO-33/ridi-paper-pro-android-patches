diff --git a/java/lite/src/com/android/inputmethod/latin/KoreanAutomata.java b/java/lite/src/com/android/inputmethod/latin/KoreanAutomata.java
new file mode 100644
index 0000000000000000000000000000000000000000..28ca9a9c072d3e6ac092de900fcd97107c3e3b8a
--- /dev/null
+++ b/java/lite/src/com/android/inputmethod/latin/KoreanAutomata.java
@@ -0,0 +1,303 @@
+/*
+ * Copyright (C) 2026
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.inputmethod.latin;
+
+/** Minimal two-set Korean automata for an e-reader keyboard. */
+final class KoreanAutomata {
+    static final class Result {
+        final String committed;
+        final String composing;
+
+        Result(final String committed, final String composing) {
+            this.committed = committed;
+            this.composing = composing;
+        }
+    }
+
+    private static final char[] INITIAL_JAMO = {
+            'ㄱ', 'ㄲ', 'ㄴ', 'ㄷ', 'ㄸ', 'ㄹ', 'ㅁ', 'ㅂ', 'ㅃ', 'ㅅ',
+            'ㅆ', 'ㅇ', 'ㅈ', 'ㅉ', 'ㅊ', 'ㅋ', 'ㅌ', 'ㅍ', 'ㅎ'
+    };
+    private static final char[] MEDIAL_JAMO = {
+            'ㅏ', 'ㅐ', 'ㅑ', 'ㅒ', 'ㅓ', 'ㅔ', 'ㅕ', 'ㅖ', 'ㅗ', 'ㅘ',
+            'ㅙ', 'ㅚ', 'ㅛ', 'ㅜ', 'ㅝ', 'ㅞ', 'ㅟ', 'ㅠ', 'ㅡ', 'ㅢ', 'ㅣ'
+    };
+
+    private int mInitial = -1;
+    private int mMedial = -1;
+    private int mFinal;
+
+    boolean hasComposing() {
+        return mInitial >= 0 || mMedial >= 0;
+    }
+
+    void reset() {
+        mInitial = -1;
+        mMedial = -1;
+        mFinal = 0;
+    }
+
+    String getComposing() {
+        if (mInitial >= 0 && mMedial >= 0) {
+            return String.valueOf((char) (0xAC00 + ((mInitial * 21 + mMedial) * 28) + mFinal));
+        }
+        if (mInitial >= 0) {
+            return String.valueOf(INITIAL_JAMO[mInitial]);
+        }
+        if (mMedial >= 0) {
+            return String.valueOf(MEDIAL_JAMO[mMedial]);
+        }
+        return "";
+    }
+
+    Result input(final int compatibilityJamo) {
+        final int initial = indexOf(INITIAL_JAMO, compatibilityJamo);
+        if (initial >= 0) {
+            return inputConsonant(initial);
+        }
+        final int medial = indexOf(MEDIAL_JAMO, compatibilityJamo);
+        if (medial >= 0) {
+            return inputVowel(medial);
+        }
+        return new Result("", getComposing());
+    }
+
+    String backspace() {
+        if (mFinal != 0) {
+            final int firstFinal = firstFinalOfCompound(mFinal);
+            mFinal = firstFinal != 0 ? firstFinal : 0;
+        } else if (mMedial >= 0) {
+            final int firstMedial = firstMedialOfCompound(mMedial);
+            mMedial = firstMedial >= 0 ? firstMedial : -1;
+        } else {
+            mInitial = -1;
+        }
+        return getComposing();
+    }
+
+    private Result inputConsonant(final int nextInitial) {
+        String committed = "";
+        if (!hasComposing()) {
+            mInitial = nextInitial;
+        } else if (mInitial >= 0 && mMedial < 0) {
+            committed = getComposing();
+            mInitial = nextInitial;
+        } else if (mInitial < 0) {
+            committed = getComposing();
+            mMedial = -1;
+            mInitial = nextInitial;
+        } else if (mFinal == 0) {
+            final int nextFinal = initialToFinal(nextInitial);
+            if (nextFinal != 0) {
+                mFinal = nextFinal;
+            } else {
+                committed = getComposing();
+                mInitial = nextInitial;
+                mMedial = -1;
+            }
+        } else {
+            final int compoundFinal = combineFinal(mFinal, nextInitial);
+            if (compoundFinal != 0) {
+                mFinal = compoundFinal;
+            } else {
+                committed = getComposing();
+                mInitial = nextInitial;
+                mMedial = -1;
+                mFinal = 0;
+            }
+        }
+        return new Result(committed, getComposing());
+    }
+
+    private Result inputVowel(final int nextMedial) {
+        String committed = "";
+        if (!hasComposing()) {
+            mMedial = nextMedial;
+        } else if (mInitial < 0) {
+            final int compoundMedial = combineMedial(mMedial, nextMedial);
+            if (compoundMedial >= 0) {
+                mMedial = compoundMedial;
+            } else {
+                committed = getComposing();
+                mMedial = nextMedial;
+            }
+        } else if (mMedial < 0) {
+            mMedial = nextMedial;
+        } else if (mFinal == 0) {
+            final int compoundMedial = combineMedial(mMedial, nextMedial);
+            if (compoundMedial >= 0) {
+                mMedial = compoundMedial;
+            } else {
+                committed = getComposing();
+                mInitial = -1;
+                mMedial = nextMedial;
+            }
+        } else {
+            final int oldInitial = mInitial;
+            final int oldMedial = mMedial;
+            final int firstFinal = firstFinalOfCompound(mFinal);
+            final int movedInitial;
+            if (firstFinal != 0) {
+                movedInitial = secondInitialOfCompound(mFinal);
+                committed = compose(oldInitial, oldMedial, firstFinal);
+            } else {
+                movedInitial = finalToInitial(mFinal);
+                committed = compose(oldInitial, oldMedial, 0);
+            }
+            mInitial = movedInitial;
+            mMedial = nextMedial;
+            mFinal = 0;
+        }
+        return new Result(committed, getComposing());
+    }
+
+    static int mapTwoSetKey(final int codePoint, final boolean shifted) {
+        final char key = Character.toLowerCase((char) codePoint);
+        final boolean useShift = shifted || Character.isUpperCase((char) codePoint);
+        switch (key) {
+            case 'q': return useShift ? 'ㅃ' : 'ㅂ';
+            case 'w': return useShift ? 'ㅉ' : 'ㅈ';
+            case 'e': return useShift ? 'ㄸ' : 'ㄷ';
+            case 'r': return useShift ? 'ㄲ' : 'ㄱ';
+            case 't': return useShift ? 'ㅆ' : 'ㅅ';
+            case 'y': return 'ㅛ';
+            case 'u': return 'ㅕ';
+            case 'i': return 'ㅑ';
+            case 'o': return useShift ? 'ㅒ' : 'ㅐ';
+            case 'p': return useShift ? 'ㅖ' : 'ㅔ';
+            case 'a': return 'ㅁ';
+            case 's': return 'ㄴ';
+            case 'd': return 'ㅇ';
+            case 'f': return 'ㄹ';
+            case 'g': return 'ㅎ';
+            case 'h': return 'ㅗ';
+            case 'j': return 'ㅓ';
+            case 'k': return 'ㅏ';
+            case 'l': return 'ㅣ';
+            case 'z': return 'ㅋ';
+            case 'x': return 'ㅌ';
+            case 'c': return 'ㅊ';
+            case 'v': return 'ㅍ';
+            case 'b': return 'ㅠ';
+            case 'n': return 'ㅜ';
+            case 'm': return 'ㅡ';
+            default: return 0;
+        }
+    }
+
+    private static String compose(final int initial, final int medial, final int finalIndex) {
+        return String.valueOf((char) (0xAC00 + ((initial * 21 + medial) * 28) + finalIndex));
+    }
+
+    private static int indexOf(final char[] values, final int value) {
+        for (int i = 0; i < values.length; i++) {
+            if (values[i] == value) return i;
+        }
+        return -1;
+    }
+
+    private static int combineMedial(final int first, final int second) {
+        if (first == 8 && second == 0) return 9;   // ㅗ + ㅏ = ㅘ
+        if (first == 8 && second == 1) return 10;  // ㅗ + ㅐ = ㅙ
+        if (first == 8 && second == 20) return 11; // ㅗ + ㅣ = ㅚ
+        if (first == 13 && second == 4) return 14; // ㅜ + ㅓ = ㅝ
+        if (first == 13 && second == 5) return 15; // ㅜ + ㅔ = ㅞ
+        if (first == 13 && second == 20) return 16;// ㅜ + ㅣ = ㅟ
+        if (first == 18 && second == 20) return 19;// ㅡ + ㅣ = ㅢ
+        return -1;
+    }
+
+    private static int firstMedialOfCompound(final int medial) {
+        switch (medial) {
+            case 9: case 10: case 11: return 8;
+            case 14: case 15: case 16: return 13;
+            case 19: return 18;
+            default: return -1;
+        }
+    }
+
+    private static int initialToFinal(final int initial) {
+        switch (initial) {
+            case 0: return 1;   // ㄱ
+            case 1: return 2;   // ㄲ
+            case 2: return 4;   // ㄴ
+            case 3: return 7;   // ㄷ
+            case 5: return 8;   // ㄹ
+            case 6: return 16;  // ㅁ
+            case 7: return 17;  // ㅂ
+            case 9: return 19;  // ㅅ
+            case 10: return 20; // ㅆ
+            case 11: return 21; // ㅇ
+            case 12: return 22; // ㅈ
+            case 14: return 23; // ㅊ
+            case 15: return 24; // ㅋ
+            case 16: return 25; // ㅌ
+            case 17: return 26; // ㅍ
+            case 18: return 27; // ㅎ
+            default: return 0;
+        }
+    }
+
+    private static int finalToInitial(final int finalIndex) {
+        switch (finalIndex) {
+            case 1: return 0;
+            case 2: return 1;
+            case 4: return 2;
+            case 7: return 3;
+            case 8: return 5;
+            case 16: return 6;
+            case 17: return 7;
+            case 19: return 9;
+            case 20: return 10;
+            case 21: return 11;
+            case 22: return 12;
+            case 23: return 14;
+            case 24: return 15;
+            case 25: return 16;
+            case 26: return 17;
+            case 27: return 18;
+            default: return -1;
+        }
+    }
+
+    private static int combineFinal(final int firstFinal, final int secondInitial) {
+        if (firstFinal == 1 && secondInitial == 9) return 3;   // ㄳ
+        if (firstFinal == 4 && secondInitial == 12) return 5;  // ㄵ
+        if (firstFinal == 4 && secondInitial == 18) return 6;  // ㄶ
+        if (firstFinal == 8 && secondInitial == 0) return 9;   // ㄺ
+        if (firstFinal == 8 && secondInitial == 6) return 10;  // ㄻ
+        if (firstFinal == 8 && secondInitial == 7) return 11;  // ㄼ
+        if (firstFinal == 8 && secondInitial == 9) return 12;  // ㄽ
+        if (firstFinal == 8 && secondInitial == 16) return 13; // ㄾ
+        if (firstFinal == 8 && secondInitial == 17) return 14; // ㄿ
+        if (firstFinal == 8 && secondInitial == 18) return 15; // ㅀ
+        if (firstFinal == 17 && secondInitial == 9) return 18; // ㅄ
+        return 0;
+    }
+
+    private static int firstFinalOfCompound(final int finalIndex) {
+        switch (finalIndex) {
+            case 3: return 1;
+            case 5: case 6: return 4;
+            case 9: case 10: case 11: case 12: case 13: case 14: case 15: return 8;
+            case 18: return 17;
+            default: return 0;
+        }
+    }
+
+    private static int secondInitialOfCompound(final int finalIndex) {
+        switch (finalIndex) {
+            case 3: case 12: case 18: return 9;
+            case 5: return 12;
+            case 6: case 15: return 18;
+            case 9: return 0;
+            case 10: return 6;
+            case 11: return 7;
+            case 13: return 16;
+            case 14: return 17;
+            default: return -1;
+        }
+    }
+}
diff --git a/java/lite/src/com/android/inputmethod/latin/LatinIME.java b/java/lite/src/com/android/inputmethod/latin/LatinIME.java
new file mode 100644
index 0000000000000000000000000000000000000000..71b36b3bb752a89489a089ad2c7958fd358dff26
--- /dev/null
+++ b/java/lite/src/com/android/inputmethod/latin/LatinIME.java
@@ -0,0 +1,497 @@
+/*
+ * Copyright (C) 2026
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.inputmethod.latin;
+
+import android.inputmethodservice.InputMethodService;
+import android.inputmethodservice.Keyboard;
+import android.inputmethodservice.KeyboardView;
+import android.os.SystemClock;
+import android.text.InputType;
+import android.view.KeyEvent;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.inputmethod.EditorInfo;
+import android.view.inputmethod.ExtractedText;
+import android.view.inputmethod.ExtractedTextRequest;
+import android.view.inputmethod.InputConnection;
+
+import java.util.List;
+
+/**
+ * Small, dependency-free Korean/English IME for an e-ink reader.
+ *
+ * <p>It intentionally has no dictionary, suggestions, gesture typing, emoji, telemetry,
+ * network access, settings UI, or native library.</p>
+ */
+public final class LatinIME extends InputMethodService
+        implements KeyboardView.OnKeyboardActionListener {
+    private static final int KEYCODE_LANGUAGE = -6;
+    private static final int KEYCODE_CURSOR_LEFT = -5335;
+    private static final int KEYCODE_HIDE = -5337;
+    private static final int KEYCODE_CURSOR_RIGHT = -5336;
+    private static final int KEYCODE_DOT_COM = -5338;
+    private static final int KEYCODE_DOT_NET = -5339;
+    private static final long CAPS_LOCK_INTERVAL_MILLIS = 800;
+
+    private final KoreanAutomata mKoreanAutomata = new KoreanAutomata();
+
+    private KeyboardView mKeyboardView;
+    private Keyboard mKoreanKeyboard;
+    private Keyboard mQwertyKeyboard;
+    private Keyboard mQwertyOnlyKeyboard;
+    private Keyboard mEmailKeyboard;
+    private Keyboard mSymbolsKeyboard;
+    private Keyboard mSymbolsShiftKeyboard;
+    private Keyboard mForcedAlphabetKeyboard;
+    private EditorInfo mEditorInfo;
+
+    private boolean mKoreanMode = true;
+    private boolean mNoKorean;
+    private boolean mSymbolsMode;
+    private boolean mSymbolsShifted;
+    private boolean mShifted;
+    private boolean mCapsLock;
+    private long mLastShiftTime;
+    // Expected editor positions, advanced before our InputConnection calls.
+    // Selection callbacks can describe an older edit or omit composing bounds.
+    private int mSelectionStart = -1;
+    private int mSelectionEnd = -1;
+
+    @Override
+    public View onCreateInputView() {
+        ensureKeyboards();
+        mKeyboardView = (KeyboardView) LayoutInflater.from(this).inflate(R.layout.input, null);
+        mKeyboardView.setOnKeyboardActionListener(this);
+        mKeyboardView.setPreviewEnabled(false);
+        showKeyboard();
+        return mKeyboardView;
+    }
+
+    @Override
+    public void onStartInput(final EditorInfo attribute, final boolean restarting) {
+        super.onStartInput(attribute, restarting);
+        ensureKeyboards();
+        mEditorInfo = attribute;
+        mKoreanAutomata.reset();
+        mShifted = false;
+        mCapsLock = false;
+        mSymbolsShifted = false;
+        mLastShiftTime = 0;
+        mSelectionStart = attribute != null ? attribute.initialSelStart : -1;
+        mSelectionEnd = attribute != null ? attribute.initialSelEnd : -1;
+
+        final int inputType = attribute != null ? attribute.inputType : InputType.TYPE_CLASS_TEXT;
+        final int inputClass = inputType & InputType.TYPE_MASK_CLASS;
+        final int variation = inputType & InputType.TYPE_MASK_VARIATION;
+        mNoKorean = inputClass != InputType.TYPE_CLASS_TEXT || isAsciiOnlyVariation(variation);
+        mSymbolsMode = inputClass == InputType.TYPE_CLASS_NUMBER
+                || inputClass == InputType.TYPE_CLASS_PHONE
+                || inputClass == InputType.TYPE_CLASS_DATETIME;
+        mKoreanMode = !mNoKorean;
+
+        if (isEmailVariation(variation)) {
+            mForcedAlphabetKeyboard = mEmailKeyboard;
+        } else if (mNoKorean) {
+            mForcedAlphabetKeyboard = mQwertyOnlyKeyboard;
+        } else {
+            mForcedAlphabetKeyboard = null;
+        }
+        showKeyboard();
+    }
+
+    @Override
+    public void onStartInputView(final EditorInfo info, final boolean restarting) {
+        super.onStartInputView(info, restarting);
+        showKeyboard();
+    }
+
+    @Override
+    public void onFinishInput() {
+        finishKoreanComposition();
+        mKoreanAutomata.reset();
+        super.onFinishInput();
+    }
+
+    @Override
+    public void onUpdateSelection(final int oldSelStart, final int oldSelEnd,
+            final int newSelStart, final int newSelEnd, final int candidatesStart,
+            final int candidatesEnd) {
+        super.onUpdateSelection(oldSelStart, oldSelEnd, newSelStart, newSelEnd,
+                candidatesStart, candidatesEnd);
+        if (isExpectedSelectionUpdate(oldSelStart, oldSelEnd, newSelStart, newSelEnd)) {
+            return;
+        }
+        final boolean unknownSelection = mSelectionStart < 0 || mSelectionEnd < 0;
+        mSelectionStart = newSelStart;
+        mSelectionEnd = newSelEnd;
+        if (unknownSelection && newSelStart >= 0 && newSelStart == newSelEnd
+                && (candidatesEnd < 0 || newSelEnd == candidatesEnd)) {
+            return;
+        }
+        if (mKoreanAutomata.hasComposing()) {
+            // A real cursor move/selection invalidates our syllable. Reset
+            // first: finishComposingText can itself cause a selection callback.
+            mKoreanAutomata.reset();
+            final InputConnection connection = getCurrentInputConnection();
+            if (connection != null) connection.finishComposingText();
+        }
+    }
+
+    private boolean isExpectedSelectionUpdate(final int oldStart, final int oldEnd,
+            final int newStart, final int newEnd) {
+        if (mSelectionStart < 0 || mSelectionEnd < 0 || newStart < 0 || newEnd < 0) {
+            return false;
+        }
+        if (newStart == mSelectionStart && newEnd == mSelectionEnd) return true;
+        if (oldStart == mSelectionStart && oldEnd == mSelectionEnd) return false;
+        // Same bounded-progress heuristic as the full LatinIME connection:
+        // accept delayed updates between their old cursor and our expected one.
+        return oldStart >= 0 && oldEnd >= 0 && newStart == newEnd
+                && (long) (newStart - oldStart) * (mSelectionStart - newStart) >= 0
+                && (long) (newEnd - oldEnd) * (mSelectionEnd - newEnd) >= 0;
+    }
+
+    private int getReplacementStart() {
+        if (mSelectionStart < 0 || mSelectionEnd < 0) return -1;
+        return mKoreanAutomata.hasComposing()
+                ? Math.max(0, mSelectionEnd - mKoreanAutomata.getComposing().length())
+                : Math.min(mSelectionStart, mSelectionEnd);
+    }
+
+    private void expectCursorAfter(final int start, final int length) {
+        if (start < 0) return;
+        mSelectionStart = mSelectionEnd = start + length;
+    }
+
+    @Override
+    public boolean onEvaluateFullscreenMode() {
+        return false;
+    }
+
+    @Override
+    public void onKey(final int primaryCode, final int[] keyCodes) {
+        switch (primaryCode) {
+            case Keyboard.KEYCODE_DELETE:
+                handleBackspace();
+                return;
+            case Keyboard.KEYCODE_SHIFT:
+                handleShift();
+                return;
+            case Keyboard.KEYCODE_MODE_CHANGE:
+                finishKoreanComposition();
+                mSymbolsMode = !mSymbolsMode;
+                mSymbolsShifted = false;
+                mShifted = false;
+                showKeyboard();
+                return;
+            case KEYCODE_LANGUAGE:
+                if (!mNoKorean) {
+                    finishKoreanComposition();
+                    mKoreanMode = !mKoreanMode;
+                    clearShift();
+                    showKeyboard();
+                }
+                return;
+            case KEYCODE_CURSOR_LEFT:
+                moveCursor(-1);
+                return;
+            case KEYCODE_CURSOR_RIGHT:
+                moveCursor(1);
+                return;
+            case KEYCODE_HIDE:
+                finishKoreanComposition();
+                requestHideSelf(0);
+                return;
+            case KEYCODE_DOT_COM:
+                commitText(".com");
+                return;
+            case KEYCODE_DOT_NET:
+                commitText(".net");
+                return;
+            case '\n':
+                handleEnter();
+                return;
+            default:
+                handleCharacter(primaryCode);
+        }
+    }
+
+    private void handleCharacter(final int codePoint) {
+        final InputConnection connection = getCurrentInputConnection();
+        if (connection == null || codePoint <= 0) return;
+
+        if (!mSymbolsMode && mKoreanMode && !mNoKorean) {
+            final int jamo = KoreanAutomata.mapTwoSetKey(codePoint, isShiftActive());
+            if (jamo != 0) {
+                final int start = getReplacementStart();
+                final KoreanAutomata.Result result = mKoreanAutomata.input(jamo);
+                connection.beginBatchEdit();
+                try {
+                    if (!result.committed.isEmpty()) {
+                        expectCursorAfter(start, result.committed.length());
+                        connection.commitText(result.committed, 1);
+                    }
+                    expectCursorAfter(start,
+                            result.committed.length() + result.composing.length());
+                    connection.setComposingText(result.composing, 1);
+                } finally {
+                    connection.endBatchEdit();
+                }
+                consumeOneShotShift();
+                return;
+            }
+        }
+
+        finishKoreanComposition();
+        int outputCodePoint = codePoint;
+        if (!mSymbolsMode && !mKoreanMode && Character.isLetter(codePoint)
+                && isShiftActive()) {
+            outputCodePoint = Character.toUpperCase(codePoint);
+        }
+        commitText(connection, new String(Character.toChars(outputCodePoint)));
+        consumeOneShotShift();
+    }
+
+    private void handleBackspace() {
+        final InputConnection connection = getCurrentInputConnection();
+        if (connection == null) return;
+        if (mKoreanAutomata.hasComposing()) {
+            final int start = getReplacementStart();
+            final String composing = mKoreanAutomata.backspace();
+            connection.beginBatchEdit();
+            try {
+                expectCursorAfter(start, composing.length());
+                connection.setComposingText(composing, 1);
+                if (composing.isEmpty()) connection.finishComposingText();
+            } finally {
+                connection.endBatchEdit();
+            }
+            return;
+        }
+
+        final ExtractedText extracted = getExtractedText(connection);
+        if (extracted != null && extracted.selectionStart != extracted.selectionEnd) {
+            expectCursorAfter(extracted.startOffset
+                    + Math.min(extracted.selectionStart, extracted.selectionEnd), 0);
+            connection.commitText("", 1);
+            return;
+        }
+        if (extracted != null && extracted.text != null && extracted.selectionStart > 0
+                && extracted.selectionStart <= extracted.text.length()) {
+            expectCursorAfter(extracted.startOffset + moveOneCodePoint(
+                    extracted.text, extracted.selectionStart, -1), 0);
+        } else if (mSelectionStart >= 0) {
+            final CharSequence before = connection.getTextBeforeCursor(2, 0);
+            final int length = before != null && before.length() > 0
+                    ? Character.charCount(Character.codePointBefore(before, before.length())) : 1;
+            expectCursorAfter(Math.max(0, mSelectionStart - length), 0);
+        }
+        if (!connection.deleteSurroundingTextInCodePoints(1, 0)) {
+            sendDownUpKeyEvent(connection, KeyEvent.KEYCODE_DEL);
+        }
+    }
+
+    private void handleShift() {
+        if (mSymbolsMode) {
+            mSymbolsShifted = !mSymbolsShifted;
+            showKeyboard();
+            return;
+        }
+        final long now = SystemClock.uptimeMillis();
+        if (mLastShiftTime != 0 && now - mLastShiftTime <= CAPS_LOCK_INTERVAL_MILLIS) {
+            mCapsLock = !mCapsLock;
+            mShifted = mCapsLock;
+            mLastShiftTime = 0;
+        } else {
+            mShifted = !mShifted;
+            if (!mShifted) mCapsLock = false;
+            mLastShiftTime = now;
+        }
+        updateAlphabetLabels();
+    }
+
+    private void handleEnter() {
+        finishKoreanComposition();
+        final InputConnection connection = getCurrentInputConnection();
+        if (connection == null) return;
+        final int imeOptions = mEditorInfo != null ? mEditorInfo.imeOptions : EditorInfo.IME_ACTION_NONE;
+        final int action = imeOptions & EditorInfo.IME_MASK_ACTION;
+        final boolean hasAction = action != EditorInfo.IME_ACTION_NONE
+                && action != EditorInfo.IME_ACTION_UNSPECIFIED
+                && (imeOptions & EditorInfo.IME_FLAG_NO_ENTER_ACTION) == 0;
+        if (hasAction) {
+            connection.performEditorAction(action);
+        } else {
+            commitText(connection, "\n");
+        }
+    }
+
+    private void moveCursor(final int direction) {
+        finishKoreanComposition();
+        final InputConnection connection = getCurrentInputConnection();
+        if (connection == null) return;
+        final ExtractedText extracted = getExtractedText(connection);
+        int start = mSelectionStart;
+        int end = mSelectionEnd;
+        if (extracted != null) {
+            start = extracted.startOffset + extracted.selectionStart;
+            end = extracted.startOffset + extracted.selectionEnd;
+        }
+        if (start < 0 || end < 0) return;
+
+        final int target;
+        if (start != end) {
+            target = direction < 0 ? Math.min(start, end) : Math.max(start, end);
+        } else if (extracted != null && extracted.text != null) {
+            final int relative = start - extracted.startOffset;
+            final int moved = moveOneCodePoint(extracted.text, relative, direction);
+            target = extracted.startOffset + moved;
+        } else {
+            target = Math.max(0, start + direction);
+        }
+        if (connection.setSelection(target, target)) {
+            mSelectionStart = target;
+            mSelectionEnd = target;
+        }
+    }
+
+    private static int moveOneCodePoint(final CharSequence text, final int offset,
+            final int direction) {
+        final int safeOffset = Math.max(0, Math.min(offset, text.length()));
+        if (direction < 0) {
+            if (safeOffset == 0) return 0;
+            return Character.offsetByCodePoints(text, safeOffset, -1);
+        }
+        if (safeOffset == text.length()) return text.length();
+        return Character.offsetByCodePoints(text, safeOffset, 1);
+    }
+
+    private void commitText(final String text) {
+        finishKoreanComposition();
+        final InputConnection connection = getCurrentInputConnection();
+        if (connection != null) commitText(connection, text);
+        consumeOneShotShift();
+    }
+
+    private void commitText(final InputConnection connection, final String text) {
+        expectCursorAfter(getReplacementStart(), text.length());
+        connection.commitText(text, 1);
+    }
+
+    private void finishKoreanComposition() {
+        if (!mKoreanAutomata.hasComposing()) return;
+        mKoreanAutomata.reset();
+        final InputConnection connection = getCurrentInputConnection();
+        if (connection != null) connection.finishComposingText();
+    }
+
+    private void consumeOneShotShift() {
+        if (mShifted && !mCapsLock) {
+            mShifted = false;
+            updateAlphabetLabels();
+        }
+    }
+
+    private void clearShift() {
+        mShifted = false;
+        mCapsLock = false;
+        mLastShiftTime = 0;
+    }
+
+    private boolean isShiftActive() {
+        return mShifted || mCapsLock;
+    }
+
+    private void ensureKeyboards() {
+        if (mKoreanKeyboard != null) return;
+        mKoreanKeyboard = new Keyboard(this, R.xml.korean);
+        mQwertyKeyboard = new Keyboard(this, R.xml.qwerty);
+        mQwertyOnlyKeyboard = new Keyboard(this, R.xml.qwerty_only);
+        mEmailKeyboard = new Keyboard(this, R.xml.email);
+        mSymbolsKeyboard = new Keyboard(this, R.xml.symbols);
+        mSymbolsShiftKeyboard = new Keyboard(this, R.xml.symbols_shift);
+        updateLabels(mKoreanKeyboard, true, false);
+        updateLabels(mQwertyKeyboard, false, false);
+    }
+
+    private void showKeyboard() {
+        if (mKeyboardView == null) return;
+        ensureKeyboards();
+        final Keyboard keyboard;
+        if (mSymbolsMode) {
+            keyboard = mSymbolsShifted ? mSymbolsShiftKeyboard : mSymbolsKeyboard;
+        } else if (mForcedAlphabetKeyboard != null) {
+            keyboard = mForcedAlphabetKeyboard;
+        } else {
+            keyboard = mKoreanMode ? mKoreanKeyboard : mQwertyKeyboard;
+        }
+        mKeyboardView.setKeyboard(keyboard);
+        updateAlphabetLabels();
+    }
+
+    private void updateAlphabetLabels() {
+        if (mKoreanKeyboard == null) return;
+        updateLabels(mKoreanKeyboard, true, isShiftActive());
+        updateLabels(mQwertyKeyboard, false, isShiftActive());
+        updateLabels(mQwertyOnlyKeyboard, false, isShiftActive());
+        updateLabels(mEmailKeyboard, false, isShiftActive());
+        if (mKeyboardView != null && !mSymbolsMode) {
+            mKeyboardView.setShifted(isShiftActive());
+            mKeyboardView.invalidateAllKeys();
+        }
+    }
+
+    private static void updateLabels(final Keyboard keyboard, final boolean korean,
+            final boolean shifted) {
+        final List<Keyboard.Key> keys = keyboard.getKeys();
+        for (final Keyboard.Key key : keys) {
+            if (key.codes == null || key.codes.length == 0) continue;
+            final int code = key.codes[0];
+            if (code < 'a' || code > 'z') continue;
+            if (korean) {
+                final int jamo = KoreanAutomata.mapTwoSetKey(code, shifted);
+                key.label = jamo == 0 ? null : String.valueOf((char) jamo);
+            } else {
+                key.label = String.valueOf((char) (shifted ? Character.toUpperCase(code) : code));
+            }
+        }
+    }
+
+    private static boolean isEmailVariation(final int variation) {
+        return variation == InputType.TYPE_TEXT_VARIATION_EMAIL_ADDRESS
+                || variation == InputType.TYPE_TEXT_VARIATION_WEB_EMAIL_ADDRESS;
+    }
+
+    private static boolean isAsciiOnlyVariation(final int variation) {
+        return isEmailVariation(variation)
+                || variation == InputType.TYPE_TEXT_VARIATION_URI
+                || variation == InputType.TYPE_TEXT_VARIATION_PASSWORD
+                || variation == InputType.TYPE_TEXT_VARIATION_VISIBLE_PASSWORD
+                || variation == InputType.TYPE_TEXT_VARIATION_WEB_PASSWORD;
+    }
+
+    private static ExtractedText getExtractedText(final InputConnection connection) {
+        final ExtractedTextRequest request = new ExtractedTextRequest();
+        request.hintMaxChars = 4096;
+        request.hintMaxLines = 32;
+        return connection.getExtractedText(request, 0);
+    }
+
+    private static void sendDownUpKeyEvent(final InputConnection connection, final int keyCode) {
+        final long now = SystemClock.uptimeMillis();
+        connection.sendKeyEvent(new KeyEvent(now, now, KeyEvent.ACTION_DOWN, keyCode, 0));
+        connection.sendKeyEvent(new KeyEvent(now, now, KeyEvent.ACTION_UP, keyCode, 0));
+    }
+
+    @Override public void onText(final CharSequence text) {
+        if (text != null) commitText(text.toString());
+    }
+    @Override public void onPress(final int primaryCode) { }
+    @Override public void onRelease(final int primaryCode) { }
+    @Override public void swipeLeft() { moveCursor(-1); }
+    @Override public void swipeRight() { moveCursor(1); }
+    @Override public void swipeDown() { requestHideSelf(0); }
+    @Override public void swipeUp() { }
+}
