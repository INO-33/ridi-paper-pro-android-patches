+<resources>
+    <style name="Theme.RidiBrowser" parent="@android:style/Theme.Material.Light.NoActionBar">
+        <item name="android:windowBackground">@color/browser_background</item>
+        <item name="android:colorAccent">@color/browser_text</item>
+        <item name="android:colorPrimary">@color/browser_toolbar</item>
+        <item name="android:colorPrimaryDark">@color/browser_divider</item>
