diff --git a/res/layout/ridi_files_activity.xml b/res/layout/ridi_files_activity.xml
new file mode 100644
index 0000000000000000000000000000000000000000..a3d478d3d59f1de0deae2a991765f4ece64fc6ce
--- /dev/null
+++ b/res/layout/ridi_files_activity.xml
@@ -0,0 +1,150 @@
+<?xml version="1.0" encoding="utf-8"?>
+<android.support.design.widget.CoordinatorLayout
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    android:id="@+id/coordinator_layout"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="#ffffffff">
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="match_parent"
+        android:background="#ffffffff"
+        android:orientation="vertical">
+
+        <!-- Kept only as an invisible ActionBar host for DocumentsUI's existing menu logic. -->
+        <Toolbar
+            android:id="@+id/toolbar"
+            android:layout_width="match_parent"
+            android:layout_height="0dp"
+            android:visibility="invisible">
+            <com.android.documentsui.DropdownBreadcrumb
+                android:id="@+id/dropdown_breadcrumb"
+                android:layout_width="1dp"
+                android:layout_height="1dp"
+                android:visibility="gone" />
+        </Toolbar>
+
+        <LinearLayout
+            android:layout_width="match_parent"
+            android:layout_height="48dp"
+            android:gravity="center_vertical"
+            android:orientation="horizontal"
+            android:paddingStart="4dp"
+            android:paddingEnd="8dp">
+
+            <ImageView
+                android:layout_width="40dp"
+                android:layout_height="40dp"
+                android:contentDescription="@null"
+                android:padding="5dp"
+                android:src="@drawable/ic_doc_folder" />
+
+            <TextView
+                android:layout_width="0dp"
+                android:layout_height="match_parent"
+                android:layout_weight="1"
+                android:gravity="center_vertical"
+                android:text="@string/files_label"
+                android:textColor="#ff000000"
+                android:textSize="18sp"
+                android:textStyle="bold" />
+
+            <TextView
+                android:id="@+id/ridi_create_folder"
+                style="@style/RidiFileHeaderAction"
+                android:visibility="gone"
+                android:text="@string/menu_create_dir" />
+
+            <TextView
+                android:id="@+id/ridi_select_all"
+                style="@style/RidiFileHeaderAction"
+                android:visibility="gone"
+                android:text="@string/menu_select_all" />
+        </LinearLayout>
+
+        <View
+            android:layout_width="match_parent"
+            android:layout_height="1dp"
+            android:background="#ff000000" />
+
+        <FrameLayout
+            android:layout_width="match_parent"
+            android:layout_height="0dp"
+            android:layout_weight="1">
+
+            <com.android.documentsui.EinkScrollView
+                android:id="@+id/ridi_file_home"
+                android:layout_width="match_parent"
+                android:layout_height="match_parent"
+                android:background="#ffffffff"
+                android:fillViewport="true"
+                android:overScrollMode="never"
+                android:scrollbars="none">
+                <LinearLayout
+                    android:layout_width="match_parent"
+                    android:layout_height="wrap_content"
+                    android:orientation="vertical">
+                    <TextView
+                        android:id="@+id/ridi_shortcuts_header"
+                        style="@style/RidiFileSectionHeader"
+                        android:text="@string/ridi_file_shortcuts" />
+                    <LinearLayout
+                        android:id="@+id/ridi_home_shortcuts"
+                        android:layout_width="match_parent"
+                        android:layout_height="wrap_content"
+                        android:orientation="vertical" />
+                    <TextView
+                        android:id="@+id/ridi_storage_header"
+                        style="@style/RidiFileSectionHeader"
+                        android:text="@string/ridi_file_storage" />
+                    <LinearLayout
+                        android:id="@+id/ridi_home_storage"
+                        android:layout_width="match_parent"
+                        android:layout_height="wrap_content"
+                        android:orientation="vertical" />
+                </LinearLayout>
+            </com.android.documentsui.EinkScrollView>
+
+            <LinearLayout
+                android:id="@+id/ridi_file_browser"
+                android:layout_width="match_parent"
+                android:layout_height="match_parent"
+                android:background="#ffffffff"
+                android:orientation="vertical"
+                android:visibility="gone">
+                <TextView
+                    android:id="@+id/ridi_path_title"
+                    android:layout_width="match_parent"
+                    android:layout_height="40dp"
+                    android:background="@drawable/ridi_flat_background"
+                    android:drawablePadding="10dp"
+                    android:ellipsize="start"
+                    android:gravity="center_vertical"
+                    android:paddingStart="16dp"
+                    android:paddingEnd="16dp"
+                    android:singleLine="true"
+                    android:textColor="#ff000000"
+                    android:textSize="15sp"
+                    android:textStyle="bold" />
+                <View
+                    android:layout_width="match_parent"
+                    android:layout_height="1dp"
+                    android:background="#ffb0b0b0" />
+                <FrameLayout
+                    android:layout_width="match_parent"
+                    android:layout_height="0dp"
+                    android:layout_weight="1">
+                    <include layout="@layout/directory_cluster" />
+                </FrameLayout>
+            </LinearLayout>
+        </FrameLayout>
+
+        <!-- RootsFragment still provides storage data, but no drawer is rendered. -->
+        <FrameLayout
+            android:id="@+id/container_roots"
+            android:layout_width="1dp"
+            android:layout_height="1dp"
+            android:visibility="gone" />
+    </LinearLayout>
+</android.support.design.widget.CoordinatorLayout>
