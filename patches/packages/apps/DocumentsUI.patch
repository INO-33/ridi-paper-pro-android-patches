@@ -0,0 +1,58 @@
+package com.android.documentsui.dirlist;
+
+import android.content.Context;
+import android.support.v7.widget.RecyclerView;
+import android.util.AttributeSet;
+
+/** RecyclerView with immediate, non-animated navigation for E Ink. */
+public final class EinkRecyclerView extends RecyclerView {
+    public EinkRecyclerView(Context context) {
+        super(context);
+        configure();
+    }
+
+    public EinkRecyclerView(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        configure();
+    }
+
+    public EinkRecyclerView(Context context, AttributeSet attrs, int defStyle) {
+        super(context, attrs, defStyle);
+        configure();
+    }
+
+    private void configure() {
+        setOverScrollMode(OVER_SCROLL_NEVER);
+        setItemAnimator(null);
+        setNestedScrollingEnabled(false);
+        setVerticalScrollBarEnabled(false);
+        setHorizontalScrollBarEnabled(false);
+    }
+
+    @Override
+    public boolean fling(int velocityX, int velocityY) {
+        stopScroll();
+        return false;
+    }
+
+    @Override
+    public boolean dispatchNestedPreFling(float velocityX, float velocityY) {
+        return true;
+    }
+
+    @Override
+    public void smoothScrollBy(int dx, int dy) {
+        stopScroll();
+        scrollBy(dx, dy);
+    }
+
+    @Override
+    public void smoothScrollBy(int dx, int dy, android.view.animation.Interpolator interpolator) {
+        smoothScrollBy(dx, dy);
+    }
+
+    @Override
+    public void smoothScrollToPosition(int position) {
+        scrollToPosition(position);
+    }
+}
