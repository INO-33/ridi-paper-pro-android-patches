diff --git a/src/com/android/documentsui/EinkScrollView.java b/src/com/android/documentsui/EinkScrollView.java
new file mode 100644
index 0000000000000000000000000000000000000000..9988f348598350ea273f88ea7243b0102184ad0d
--- /dev/null
+++ b/src/com/android/documentsui/EinkScrollView.java
@@ -0,0 +1,40 @@
+package com.android.documentsui;
+
+import android.content.Context;
+import android.util.AttributeSet;
+import android.widget.ScrollView;
+
+/** ScrollView whose movement stops with the user's finger on an E Ink panel. */
+public final class EinkScrollView extends ScrollView {
+    public EinkScrollView(Context context) {
+        super(context);
+        configure();
+    }
+
+    public EinkScrollView(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        configure();
+    }
+
+    public EinkScrollView(Context context, AttributeSet attrs, int defStyleAttr) {
+        super(context, attrs, defStyleAttr);
+        configure();
+    }
+
+    private void configure() {
+        setSmoothScrollingEnabled(false);
+        setOverScrollMode(OVER_SCROLL_NEVER);
+        setVerticalScrollBarEnabled(false);
+        setHorizontalScrollBarEnabled(false);
+    }
+
+    @Override
+    public void fling(int velocityY) {
+        // Deliberately no momentum: every intermediate position costs an EPDC update.
+    }
+
+    @Override
+    public boolean dispatchNestedPreFling(float velocityX, float velocityY) {
+        return true;
+    }
+}
