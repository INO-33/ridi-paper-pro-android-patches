+/*
+ * Copyright (C) 2026 E70Q10 Android port
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ */
+package com.android.settings.ridi;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+
+/** Applies the last committed frontlight levels once boot has completed. */
+public final class RidiFrontlightBootReceiver extends BroadcastReceiver {
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        if (Intent.ACTION_BOOT_COMPLETED.equals(intent.getAction())) {
+            RidiFrontlightController.restoreSavedState(context.getContentResolver());
+        }
+    }
+}
diff --git a/src/com/android/settings/ridi/RidiFrontlightController.java b/src/com/android/settings/ridi/RidiFrontlightController.java
new file mode 100644
index 0000000000000000000000000000000000000000..b075add9710764da6e3f096fff3711c0c4fe2ff3
--- /dev/null
+++ b/src/com/android/settings/ridi/RidiFrontlightController.java
@@ -0,0 +1,192 @@
+/*
+ * Copyright (C) 2026 E70Q10 Android port
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ */
+package com.android.settings.ridi;
+
+import android.content.ContentResolver;
+import android.provider.Settings;
+import android.util.Log;
+
+import java.io.BufferedReader;
+import java.io.FileReader;
+import java.io.FileWriter;
+import java.io.IOException;
+
+/**
+ * Small synchronous controller for the E70Q10 two-channel LM3630A frontlight.
+ *
+ * The kernel owns the brightness/color mixing policy. Settings only writes the
+ * two stable backlight class attributes exposed by the board driver.
+ */
+final class RidiFrontlightController {
+    private static final String TAG = "RidiFrontlight";
+    private static final String BASE = "/sys/class/backlight/lm3630a_led/";
+    private static final String BRIGHTNESS = BASE + "brightness";
+    private static final String MAX_BRIGHTNESS = BASE + "max_brightness";
+    private static final String COLOR = BASE + "color";
+    private static final String MAX_COLOR = BASE + "max_color";
+
+    private static final String SETTING_BRIGHTNESS = "ridi_frontlight_level";
+    private static final String SETTING_COLOR = "ridi_frontlight_color";
+
+    private RidiFrontlightController() {}
+
+    static int getBrightness() {
+        return readInt(BRIGHTNESS, 0);
+    }
+
+    static int getMaxBrightness() {
+        return Math.max(1, readInt(MAX_BRIGHTNESS, 100));
+    }
+
+    static int getColor() {
+        return readInt(COLOR, 0);
+    }
+
+    static int getMaxColor() {
+        return Math.max(1, readInt(MAX_COLOR, 10));
+    }
+
+    /** Restore the last committed levels after the backlight driver is ready. */
+    static void restoreSavedState(ContentResolver resolver) {
+        final int savedColor = Settings.System.getInt(resolver, SETTING_COLOR, -1);
+        final int savedBrightness = Settings.System.getInt(resolver, SETTING_BRIGHTNESS, -1);
+
+        // On the first boot, keep the board defaults until the user sets a level.
+        if (savedColor >= 0 && !setColor(resolver, savedColor)) {
+            Log.e(TAG, "Cannot restore frontlight color");
+        }
+        if (savedBrightness >= 0 && !setBrightness(resolver, savedBrightness)) {
+            Log.e(TAG, "Cannot restore frontlight brightness");
+        }
+    }
+
+    static boolean setBrightness(ContentResolver resolver, int requested) {
+        final int maxBrightness = getMaxBrightness();
+        final int value = clamp(requested, 0, maxBrightness);
+        if (!previewBrightness(value, maxBrightness)) {
+            return false;
+        }
+
+        return persistBrightness(resolver, value, maxBrightness);
+    }
+
+    /** Save an already applied level, or a final level selected during screen-off. */
+    static boolean persistBrightness(ContentResolver resolver, int requested,
+            int maxBrightness) {
+        final int value = clamp(requested, 0, maxBrightness);
+
+        /*
+         * Keep Android's display-power brightness in sync with the RIDI
+         * frontlight level.  The stock 4.4.2 app did the same: it applied the
+         * value immediately and also wrote Settings.System.SCREEN_BRIGHTNESS.
+         * DisplayPowerController can then drive the light to zero for screen
+         * off/suspend and restore this value when the display wakes.
+         *
+         * The NXP lights HAL accepts Android's 0..255 range and scales it to
+         * the backlight class device's 0..max range.  Pick the first 0..255
+         * value that maps back to the requested frontlight step so all 100
+         * RIDI levels survive an off/on cycle exactly.
+         */
+        final int systemBrightness = toSystemBrightness(value, maxBrightness);
+        if (!Settings.System.putInt(
+                resolver, Settings.System.SCREEN_BRIGHTNESS, systemBrightness)) {
+            Log.e(TAG, "Cannot persist Android screen brightness");
+            return false;
+        }
+        if (!Settings.System.putInt(resolver, SETTING_BRIGHTNESS, value)) {
+            Log.e(TAG, "Cannot persist frontlight brightness");
+            return false;
+        }
+        return true;
+    }
+
+    /**
+     * Applies a drag-preview directly to the frontlight hardware. Persistence
+     * is deliberately deferred until setBrightness() is called on release, so
+     * a continuous gesture does not flood SettingsProvider or retrigger the
+     * display power controller for every intermediate level.
+     */
+    static boolean previewBrightness(int requested) {
+        return previewBrightness(requested, getMaxBrightness());
+    }
+
+    static boolean previewBrightness(int requested, int maxBrightness) {
+        final int value = clamp(requested, 0, maxBrightness);
+        return writeInt(BRIGHTNESS, value);
+    }
+
+    static boolean setColor(ContentResolver resolver, int requested) {
+        final int maxColor = getMaxColor();
+        final int value = clamp(requested, 0, maxColor);
+        if (!previewColor(value, maxColor)) {
+            return false;
+        }
+        return persistColor(resolver, value);
+    }
+
+    static boolean persistColor(ContentResolver resolver, int value) {
+        if (!Settings.System.putInt(resolver, SETTING_COLOR, value)) {
+            Log.e(TAG, "Cannot persist frontlight color");
+            return false;
+        }
+        return true;
+    }
+
+    /** Applies color temperature immediately while persistence waits for release. */
+    static boolean previewColor(int requested) {
+        return previewColor(requested, getMaxColor());
+    }
+
+    static boolean previewColor(int requested, int maxColor) {
+        final int value = clamp(requested, 0, maxColor);
+        return writeInt(COLOR, value);
+    }
+
+    private static int readInt(String path, int fallback) {
+        try (BufferedReader reader = new BufferedReader(new FileReader(path))) {
+            return Integer.parseInt(reader.readLine().trim());
+        } catch (IOException | NumberFormatException e) {
+            Log.w(TAG, "Cannot read " + path, e);
+            return fallback;
+        }
+    }
+
+    private static boolean writeInt(String path, int value) {
+        try (FileWriter writer = new FileWriter(path, false)) {
+            writer.write(Integer.toString(value));
+            writer.write('\n');
+            writer.flush();
+            return true;
+        } catch (IOException e) {
+            Log.e(TAG, "Cannot write " + path, e);
+            return false;
+        }
+    }
+
+    private static int clamp(int value, int min, int max) {
+        return Math.max(min, Math.min(max, value));
+    }
+
+    private static int toSystemBrightness(int frontlight, int maxFrontlight) {
+        if (frontlight <= 0) {
+            return 0;
+        }
+        for (int system = 1; system <= 255; system++) {
+            if (scaleLikeNxpLightsHal(system, maxFrontlight) >= frontlight) {
+                return system;
+            }
+        }
+        return 255;
+    }
+
+    private static int scaleLikeNxpLightsHal(int system, int maxFrontlight) {
+        if (maxFrontlight < 255) {
+            return maxFrontlight
+                    * (system + 255 / maxFrontlight - 1) / 255;
+        }
+        return maxFrontlight * system / 255;
+    }
+}
