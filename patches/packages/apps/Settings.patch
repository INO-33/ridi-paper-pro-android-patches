diff --git a/res/layout/ridi_setting_row.xml b/res/layout/ridi_setting_row.xml
new file mode 100644
index 0000000000000000000000000000000000000000..245155be5e26792dc0c2f44973bc5db935e3c6ae
--- /dev/null
+++ b/res/layout/ridi_setting_row.xml
@@ -0,0 +1,68 @@
+<?xml version="1.0" encoding="utf-8"?>
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="@dimen/ridi_setting_row_height"
+    android:background="@drawable/ridi_row_background"
+    android:clickable="true"
+    android:focusable="true"
+    android:gravity="center_vertical"
+    android:orientation="horizontal"
+    android:paddingStart="@dimen/ridi_setting_horizontal_padding"
+    android:paddingEnd="@dimen/ridi_setting_horizontal_padding">
+
+    <ImageView
+        android:id="@+id/icon"
+        android:layout_width="@dimen/ridi_setting_icon_size"
+        android:layout_height="@dimen/ridi_setting_icon_size"
+        android:layout_marginEnd="12dp"
+        android:contentDescription="@null"
+        android:scaleType="centerInside" />
+
+    <LinearLayout
+        android:layout_width="0dp"
+        android:layout_height="wrap_content"
+        android:layout_weight="1"
+        android:orientation="vertical">
+
+        <TextView
+            android:id="@+id/title"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:includeFontPadding="false"
+            android:textColor="#ff000000"
+            android:textSize="@dimen/ridi_primary_text_size"
+            android:textStyle="bold" />
+
+        <TextView
+            android:id="@+id/summary"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:includeFontPadding="false"
+            android:maxLines="1"
+            android:textColor="#ff666666"
+            android:textSize="@dimen/ridi_secondary_text_size" />
+    </LinearLayout>
+
+    <CheckBox
+        android:id="@+id/toggle"
+        android:layout_width="71dp"
+        android:layout_height="30dp"
+        android:layout_marginStart="10dp"
+        android:background="@drawable/ridi_stock_onoff_button"
+        android:button="@null"
+        android:clickable="false"
+        android:focusable="false"
+        android:minHeight="0dp"
+        android:minWidth="0dp"
+        android:padding="0dp"
+        android:visibility="gone" />
+
+    <TextView
+        android:id="@+id/chevron"
+        android:layout_width="26dp"
+        android:layout_height="match_parent"
+        android:gravity="center"
+        android:text="›"
+        android:textColor="#ff666666"
+        android:textSize="24sp" />
+</LinearLayout>
