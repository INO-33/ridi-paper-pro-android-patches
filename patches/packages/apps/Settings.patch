@@ -0,0 +1,57 @@
+/*
+ * Copyright (C) 2026 E70Q10 Android port
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ */
+package com.android.settings.ridi;
+
+import android.graphics.Rect;
+import android.view.View;
+
+/** Settings-side use of the stock RIDI/Onyx packed E Ink View ABI. */
+final class RidiEinkRefresh {
+    static final int REAGL_PARTIAL_NOWAIT =
+            View.EINK_WAVEFORM_MODE_REAGL
+                    | View.EINK_UPDATE_MODE_PARTIAL
+                    | View.EINK_WAIT_MODE_NOWAIT;
+
+    static final int GC16_FULL_NOWAIT =
+            View.EINK_WAVEFORM_MODE_GC16
+                    | View.EINK_UPDATE_MODE_FULL
+                    | View.EINK_WAIT_MODE_NOWAIT;
+
+    private RidiEinkRefresh() {}
+
+    /**
+     * Settings is its own process, so this process-global default covers the
+     * AOSP detail activities launched from the RIDI settings home without
+     * changing the policy of launcher or reader applications.
+     */
+    static void configure(View decorView) {
+        View.setGlobalUpdateMode(REAGL_PARTIAL_NOWAIT);
+        View.setFirstDrawUpdateMode(REAGL_PARTIAL_NOWAIT);
+        decorView.setDefaultUpdateMode(REAGL_PARTIAL_NOWAIT);
+    }
+
+    /** One full update after a popup window has been removed. */
+    static void fullRefreshOnce(View view) {
+        if (view != null) {
+            view.invalidate(GC16_FULL_NOWAIT);
+        }
+    }
+
+    static void invalidate(View view) {
+        if (view == null) {
+            return;
+        }
+        view.setDefaultUpdateMode(REAGL_PARTIAL_NOWAIT);
+        final int width = view.getWidth();
+        final int height = view.getHeight();
+        if (width > 0 && height > 0) {
+            view.invalidate(new Rect(0, 0, width, height),
+                    REAGL_PARTIAL_NOWAIT);
+        } else {
+            view.invalidate(REAGL_PARTIAL_NOWAIT);
+        }
+    }
+}
