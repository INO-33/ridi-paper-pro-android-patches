@@ -0,0 +1,49 @@
+/*
+ * Copyright (C) 2026 E70Q10 Android port
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ */
+package com.android.settings.ridi;
+
+import android.content.ContentResolver;
+import android.provider.Settings;
+
+/**
+ * Settings-side mirror of SystemUI's reader system bar keys.
+ *
+ * Keep the key name and the range in sync with
+ * {@code com.android.systemui.ridi.ReaderBarSettings}.
+ */
+final class RidiBarSettings {
+    static final String NAV_ALWAYS_VISIBLE = "ridi_nav_bar_always_visible";
+    static final String NAV_BAR_TIMEOUT = "ridi_nav_bar_timeout_seconds";
+
+    static final int DEFAULT_TIMEOUT_SECONDS = 3;
+    static final int MIN_TIMEOUT_SECONDS = 1;
+    static final int MAX_TIMEOUT_SECONDS = 15;
+
+    static final int[] TIMEOUT_CHOICES_SECONDS = {2, 3, 5, 8, 10, 15};
+
+    private RidiBarSettings() {}
+
+    static boolean isAlwaysVisible(ContentResolver resolver) {
+        return Settings.System.getInt(resolver, NAV_ALWAYS_VISIBLE, 1) != 0;
+    }
+
+    static void setAlwaysVisible(ContentResolver resolver, boolean visible) {
+        Settings.System.putInt(resolver, NAV_ALWAYS_VISIBLE, visible ? 1 : 0);
+    }
+
+    static int getTimeoutSeconds(ContentResolver resolver) {
+        return clamp(Settings.System.getInt(resolver, NAV_BAR_TIMEOUT,
+                DEFAULT_TIMEOUT_SECONDS));
+    }
+
+    static void setTimeoutSeconds(ContentResolver resolver, int seconds) {
+        Settings.System.putInt(resolver, NAV_BAR_TIMEOUT, clamp(seconds));
+    }
+
+    private static int clamp(int seconds) {
+        return Math.max(MIN_TIMEOUT_SECONDS, Math.min(MAX_TIMEOUT_SECONDS, seconds));
+    }
+}
