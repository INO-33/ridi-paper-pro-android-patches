@@ -0,0 +1,139 @@
+/*
+ * Copyright (C) 2026 E70Q10 Android port
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ */
+package com.android.settings.ridi;
+
+import android.app.Activity;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.os.Bundle;
+import android.util.DisplayMetrics;
+import android.view.View;
+import android.view.WindowManager;
+import android.widget.ImageView;
+import android.widget.TextView;
+
+import com.android.settings.R;
+
+import java.io.File;
+
+/** Stock-style popup for built-in and user-selected sleep images. */
+public class RidiScreensaverSettingsActivity extends Activity {
+
+    private ImageView mPreview;
+    private TextView mEmptyPreview;
+    private TextView mImageName;
+    private ImageView mSelectedCheck;
+    private Bitmap mPreviewBitmap;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        RidiEinkRefresh.configure(getWindow().getDecorView());
+        setContentView(R.layout.ridi_screensaver_settings);
+
+        mPreview = findViewById(R.id.screensaver_preview);
+        mEmptyPreview = findViewById(R.id.screensaver_preview_empty);
+        mImageName = findViewById(R.id.screensaver_image_name);
+        mSelectedCheck = findViewById(R.id.screensaver_selected_check);
+
+        findViewById(R.id.screensaver_back).setOnClickListener(v -> finish());
+        findViewById(R.id.screensaver_user_image).setOnClickListener(v ->
+                startActivity(new android.content.Intent(this,
+                        RidiScreensaverImagePickerActivity.class)));
+    }
+
+    @Override
+    protected void onStart() {
+        super.onStart();
+        final DisplayMetrics metrics = new DisplayMetrics();
+        getWindowManager().getDefaultDisplay().getMetrics(metrics);
+        final int panelWidth = Math.min(Math.round(510f * metrics.density),
+                Math.round(metrics.widthPixels * 0.94f));
+        final int panelHeight = Math.min(Math.round(685f * metrics.density),
+                Math.round(metrics.heightPixels * 0.92f));
+        getWindow().setDimAmount(0f);
+        getWindow().clearFlags(WindowManager.LayoutParams.FLAG_DIM_BEHIND);
+        getWindow().getDecorView().setElevation(0f);
+        getWindow().setLayout(panelWidth, panelHeight);
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        overridePendingTransition(0, 0);
+        refreshPreview();
+    }
+
+    @Override
+    protected void onDestroy() {
+        clearPreviewBitmap();
+        super.onDestroy();
+    }
+
+    @Override
+    public void finish() {
+        super.finish();
+        overridePendingTransition(0, 0);
+    }
+
+    private void refreshPreview() {
+        clearPreviewBitmap();
+        final String selectedPath = RidiScreensaverSettings.getUserImagePath(
+                getContentResolver());
+        final String path = selectedPath == null ? "/system/usr/sleep/suspend.jpg" : selectedPath;
+        final File image = new File(path);
+        if (image != null && image.isFile() && image.canRead()) {
+            mPreviewBitmap = decodeSampledBitmap(path, 312, 416);
+        }
+
+        final boolean hasPreview = mPreviewBitmap != null;
+        if (hasPreview && selectedPath != null
+                && RidiScreensaverSettings.getStyle(getContentResolver())
+                != RidiScreensaverSettings.STYLE_USER) {
+            // Keep a registered selection authoritative without migrating
+            // the default image merely because its preview is available.
+            RidiScreensaverSettings.setStyle(getContentResolver(),
+                    RidiScreensaverSettings.STYLE_USER);
+        }
+        mPreview.setImageBitmap(mPreviewBitmap);
+        mPreview.setVisibility(hasPreview ? View.VISIBLE : View.INVISIBLE);
+        mEmptyPreview.setVisibility(hasPreview ? View.GONE : View.VISIBLE);
+        mSelectedCheck.setVisibility(hasPreview ? View.VISIBLE : View.INVISIBLE);
+        mImageName.setText(hasPreview ? (selectedPath == null
+                ? "기본 슬립 화면" : image.getName()) : "선택된 이미지 없음");
+        RidiEinkRefresh.invalidate(findViewById(android.R.id.content));
+    }
+
+    private void clearPreviewBitmap() {
+        if (mPreviewBitmap != null) {
+            mPreview.setImageDrawable(null);
+            mPreviewBitmap.recycle();
+            mPreviewBitmap = null;
+        }
+    }
+
+    static Bitmap decodeSampledBitmap(String path, int requestedWidth,
+            int requestedHeight) {
+        final BitmapFactory.Options bounds = new BitmapFactory.Options();
+        bounds.inJustDecodeBounds = true;
+        BitmapFactory.decodeFile(path, bounds);
+        if (bounds.outWidth <= 0 || bounds.outHeight <= 0) {
+            return null;
+        }
+
+        int sample = 1;
+        // Limit either unusually long edge as well. This keeps panoramic or
+        // very tall photos from consuming tens of megabytes on the 1 GB reader.
+        while (bounds.outWidth / (sample * 2) >= requestedWidth
+                || bounds.outHeight / (sample * 2) >= requestedHeight) {
+            sample *= 2;
+        }
+        final BitmapFactory.Options options = new BitmapFactory.Options();
+        options.inSampleSize = sample;
+        options.inPreferredConfig = Bitmap.Config.RGB_565;
+        return BitmapFactory.decodeFile(path, options);
+    }
+}
