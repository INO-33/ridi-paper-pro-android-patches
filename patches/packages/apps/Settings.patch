diff --git a/res/layout/ridi_screensaver_picker.xml b/res/layout/ridi_screensaver_picker.xml
new file mode 100644
index 0000000000000000000000000000000000000000..4eae8fa84751de656c7ab472b22ce61097cc6f3b
--- /dev/null
+++ b/res/layout/ridi_screensaver_picker.xml
@@ -0,0 +1,105 @@
+<?xml version="1.0" encoding="utf-8"?>
+<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="@drawable/ridi_panel_background">
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="match_parent"
+        android:layout_margin="3dp"
+        android:orientation="vertical">
+
+        <TextView
+            android:id="@+id/screensaver_picker_back"
+            android:layout_width="match_parent"
+            android:layout_height="46dp"
+            android:background="@drawable/ridi_row_background"
+            android:drawableStart="@drawable/ridi_sleep_panel_back"
+            android:drawablePadding="7dp"
+            android:gravity="center_vertical"
+            android:paddingStart="5dp"
+            android:text="슬립 이미지 선택"
+            android:textColor="#ff000000"
+            android:textSize="18sp"
+            android:textStyle="bold" />
+
+        <View
+            android:layout_width="match_parent"
+            android:layout_height="1dp"
+            android:background="#ff000000" />
+
+        <TextView
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginStart="20dp"
+            android:layout_marginTop="15dp"
+            android:layout_marginEnd="20dp"
+            android:layout_marginBottom="12dp"
+            android:text="기본 이미지 및 Sleepingscreen 폴더의 이미지"
+            android:textColor="#ff000000"
+            android:textSize="15sp"
+            android:textStyle="bold" />
+
+        <FrameLayout
+            android:layout_width="match_parent"
+            android:layout_height="0dp"
+            android:layout_weight="1">
+
+            <com.android.settings.ridi.RidiEinkGridView
+                android:id="@+id/screensaver_image_grid"
+                android:layout_width="match_parent"
+                android:layout_height="match_parent"
+                android:columnWidth="140dp"
+                android:gravity="center_horizontal"
+                android:horizontalSpacing="10dp"
+                android:listSelector="@android:color/transparent"
+                android:numColumns="auto_fit"
+                android:overScrollMode="never"
+                android:paddingStart="10dp"
+                android:paddingEnd="10dp"
+                android:paddingBottom="12dp"
+                android:scrollbars="none"
+                android:smoothScrollbar="false"
+                android:stretchMode="columnWidth"
+                android:verticalSpacing="18dp" />
+
+            <LinearLayout
+                android:id="@+id/screensaver_picker_empty"
+                android:layout_width="match_parent"
+                android:layout_height="match_parent"
+                android:gravity="center"
+                android:orientation="vertical"
+                android:padding="42dp">
+
+                <TextView
+                    android:layout_width="wrap_content"
+                    android:layout_height="wrap_content"
+                    android:gravity="center"
+                    android:text="직접 슬립 화면을 골라보세요."
+                    android:textColor="#ff000000"
+                    android:textSize="17sp"
+                    android:textStyle="bold" />
+
+                <TextView
+                    android:layout_width="wrap_content"
+                    android:layout_height="wrap_content"
+                    android:layout_marginTop="12dp"
+                    android:gravity="center"
+                    android:lineSpacingExtra="3dp"
+                    android:text="내부 저장소의 Sleepingscreen 폴더에 JPG, PNG, GIF, BMP 이미지를 복사한 뒤 이 화면을 다시 열어주세요."
+                    android:textColor="#ff666666"
+                    android:textSize="14sp" />
+
+                <TextView
+                    android:layout_width="wrap_content"
+                    android:layout_height="wrap_content"
+                    android:layout_marginTop="18dp"
+                    android:gravity="center"
+                    android:text="권장 크기 1404 × 1872 px\n다른 크기는 자동으로 확대·축소됩니다."
+                    android:textColor="#ff777777"
+                    android:textSize="13sp" />
+            </LinearLayout>
+        </FrameLayout>
+    </LinearLayout>
+</FrameLayout>
diff --git a/res/layout/ridi_screensaver_row.xml b/res/layout/ridi_screensaver_row.xml
new file mode 100644
index 0000000000000000000000000000000000000000..cb4744c054ccd36016ba2bbcd0ba443cd03369f3
--- /dev/null
+++ b/res/layout/ridi_screensaver_row.xml
@@ -0,0 +1,58 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Row for the full-screen screensaver page: icon, title/summary, state. -->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="@dimen/ridi_setting_row_height"
+    android:background="@drawable/ridi_row_background"
+    android:clickable="true"
+    android:focusable="true"
+    android:gravity="center_vertical"
+    android:orientation="horizontal"
+    android:paddingStart="@dimen/ridi_setting_horizontal_padding"
+    android:paddingEnd="@dimen/ridi_setting_horizontal_padding">
+
+    <ImageView
+        android:id="@+id/icon"
+        android:layout_width="@dimen/ridi_setting_icon_size"
+        android:layout_height="@dimen/ridi_setting_icon_size"
+        android:layout_marginEnd="12dp"
+        android:contentDescription="@null"
+        android:scaleType="centerInside" />
+
+    <LinearLayout
+        android:layout_width="0dp"
+        android:layout_height="wrap_content"
+        android:layout_weight="1"
+        android:orientation="vertical">
+
+        <TextView
+            android:id="@+id/title"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:includeFontPadding="false"
+            android:textColor="#ff000000"
+            android:textSize="@dimen/ridi_primary_text_size"
+            android:textStyle="bold" />
+
+        <TextView
+            android:id="@+id/summary"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:includeFontPadding="false"
+            android:maxLines="1"
+            android:textColor="#ff666666"
+            android:textSize="@dimen/ridi_secondary_text_size" />
+    </LinearLayout>
+
+    <TextView
+        android:id="@+id/state"
+        android:layout_width="wrap_content"
+        android:layout_height="match_parent"
+        android:layout_marginStart="12dp"
+        android:gravity="center"
+        android:includeFontPadding="false"
+        android:minWidth="56dp"
+        android:textColor="#ff000000"
+        android:textSize="@dimen/ridi_primary_text_size"
+        android:textStyle="bold" />
+</LinearLayout>
diff --git a/res/layout/ridi_screensaver_settings.xml b/res/layout/ridi_screensaver_settings.xml
new file mode 100644
index 0000000000000000000000000000000000000000..e106a8f7caacd961178de310babc876a4ac71c1e
--- /dev/null
+++ b/res/layout/ridi_screensaver_settings.xml
@@ -0,0 +1,160 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Stock RIDI sleep-screen popup for built-in and user-selected images. -->
+<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="@drawable/ridi_panel_background">
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="match_parent"
+        android:layout_margin="3dp"
+        android:orientation="vertical">
+
+        <TextView
+            android:id="@+id/screensaver_back"
+            android:layout_width="match_parent"
+            android:layout_height="46dp"
+            android:background="@drawable/ridi_row_background"
+            android:drawableStart="@drawable/ridi_sleep_panel_back"
+            android:drawablePadding="7dp"
+            android:gravity="center_vertical"
+            android:paddingStart="5dp"
+            android:text="슬립 화면"
+            android:textColor="#ff000000"
+            android:textSize="18sp"
+            android:textStyle="bold" />
+
+        <View
+            android:layout_width="match_parent"
+            android:layout_height="1dp"
+            android:background="#ff000000" />
+
+        <TextView
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:layout_marginStart="20dp"
+            android:layout_marginTop="15dp"
+            android:text="현재 슬립 화면"
+            android:textColor="#ff000000"
+            android:textSize="15sp"
+            android:textStyle="bold" />
+
+        <FrameLayout
+            android:layout_width="200dp"
+            android:layout_height="267dp"
+            android:layout_gravity="center_horizontal"
+            android:background="@drawable/ridi_sleep_screen_outline">
+
+            <FrameLayout
+                android:layout_width="158dp"
+                android:layout_height="210dp"
+                android:layout_gravity="center"
+                android:background="@drawable/ridi_preview_frame"
+                android:padding="1dp">
+
+                <ImageView
+                    android:id="@+id/screensaver_preview"
+                    android:layout_width="156dp"
+                    android:layout_height="208dp"
+                    android:contentDescription="현재 슬립 화면 미리보기"
+                    android:scaleType="fitCenter" />
+
+                <TextView
+                    android:id="@+id/screensaver_preview_empty"
+                    android:layout_width="match_parent"
+                    android:layout_height="match_parent"
+                    android:gravity="center"
+                    android:padding="14dp"
+                    android:text="슬립 이미지를\n선택해 주세요"
+                    android:textColor="#ff777777"
+                    android:textSize="13sp" />
+            </FrameLayout>
+        </FrameLayout>
+
+        <TextView
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:layout_marginStart="20dp"
+            android:layout_marginTop="27dp"
+            android:layout_marginBottom="10dp"
+            android:text="슬립 화면 선택"
+            android:textColor="#ff000000"
+            android:textSize="15sp"
+            android:textStyle="bold" />
+
+        <LinearLayout
+            android:id="@+id/screensaver_user_image"
+            android:layout_width="match_parent"
+            android:layout_height="51dp"
+            android:layout_marginStart="31dp"
+            android:layout_marginEnd="16dp"
+            android:background="@drawable/ridi_row_background"
+            android:clickable="true"
+            android:focusable="true"
+            android:gravity="center_vertical"
+            android:orientation="horizontal">
+
+            <ImageView
+                android:id="@+id/screensaver_selected_check"
+                android:layout_width="30dp"
+                android:layout_height="match_parent"
+                android:layout_marginEnd="8dp"
+                android:contentDescription="선택됨"
+                android:scaleType="centerInside"
+                android:src="@drawable/ridi_sleep_check" />
+
+            <LinearLayout
+                android:layout_width="0dp"
+                android:layout_height="match_parent"
+                android:layout_weight="1"
+                android:gravity="center_vertical"
+                android:orientation="vertical">
+
+                <TextView
+                    android:layout_width="match_parent"
+                    android:layout_height="wrap_content"
+                    android:ellipsize="end"
+                    android:singleLine="true"
+                    android:text="슬립 이미지 선택"
+                    android:textColor="#ff000000"
+                    android:textSize="17sp"
+                    android:textStyle="bold" />
+
+                <TextView
+                    android:id="@+id/screensaver_image_name"
+                    android:layout_width="match_parent"
+                    android:layout_height="wrap_content"
+                    android:ellipsize="middle"
+                    android:singleLine="true"
+                    android:textColor="#ff666666"
+                    android:textSize="12sp" />
+            </LinearLayout>
+
+            <ImageView
+                android:layout_width="30dp"
+                android:layout_height="match_parent"
+                android:contentDescription="열기"
+                android:scaleType="centerInside"
+                android:src="@drawable/ridi_sleep_more" />
+        </LinearLayout>
+
+        <View
+            android:layout_width="match_parent"
+            android:layout_height="1dp"
+            android:layout_marginStart="31dp"
+            android:layout_marginEnd="16dp"
+            android:background="#ffcccccc" />
+
+        <TextView
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginStart="31dp"
+            android:layout_marginTop="16dp"
+            android:layout_marginEnd="31dp"
+            android:lineSpacingExtra="2dp"
+            android:text="기본 이미지 또는 내부 저장소의 Sleepingscreen 폴더에 넣은 이미지를 선택할 수 있습니다. 화면 크기에 맞춰 자동으로 표시됩니다."
+            android:textColor="#ff666666"
+            android:textSize="13sp" />
+    </LinearLayout>
+</FrameLayout>
diff --git a/res/layout/ridi_section_header.xml b/res/layout/ridi_section_header.xml
