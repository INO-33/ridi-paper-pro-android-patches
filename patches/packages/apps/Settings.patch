@@ -0,0 +1,489 @@
+/*
+ * Copyright (C) 2026 E70Q10 Android port
+ *
+ * Reader-oriented replacements for fragile generic Settings dashboards.
+ */
+package com.android.settings.ridi;
+
+import android.app.Activity;
+import android.app.AlarmManager;
+import android.app.AlertDialog;
+import android.app.DatePickerDialog;
+import android.app.Dialog;
+import android.app.TimePickerDialog;
+import android.content.Intent;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageInfo;
+import android.content.pm.PackageManager;
+import android.graphics.Color;
+import android.graphics.drawable.ColorDrawable;
+import android.graphics.drawable.Drawable;
+import android.net.Uri;
+import android.os.Build;
+import android.os.Bundle;
+import android.os.Environment;
+import android.os.StatFs;
+import android.provider.Settings;
+import android.text.TextUtils;
+import android.text.format.DateFormat;
+import android.text.format.Formatter;
+import android.util.DisplayMetrics;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.Window;
+import android.view.WindowManager;
+import android.widget.ArrayAdapter;
+import android.widget.ImageView;
+import android.widget.ListView;
+import android.widget.CheckBox;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import com.android.settings.R;
+import com.android.settings.notification.NotificationBackend;
+import com.android.settingslib.datetime.ZoneGetter;
+
+import java.io.File;
+import java.util.ArrayList;
+import java.util.Calendar;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.Date;
+import java.util.List;
+import java.util.Map;
+import java.util.TimeZone;
+
+/** Stock-inspired, opaque list pages suitable for an EPDC display. */
+public class RidiDetailSettingsActivity extends Activity {
+    public static final String EXTRA_MODE = "mode";
+    public static final String MODE_APPS = "apps";
+    public static final String MODE_STORAGE = "storage";
+    public static final String MODE_NOTIFICATIONS = "notifications";
+    public static final String MODE_DEVICE_INFO = "device_info";
+    public static final String MODE_DEVELOPER = "developer";
+    public static final String MODE_DATE_TIME = "date_time";
+    private static final String MODE_APP_DETAIL = "app_detail";
+    private static final String EXTRA_PACKAGE = "package";
+
+    private final NotificationBackend mNotificationBackend = new NotificationBackend();
+    private PackageManager mPackageManager;
+    private ListView mList;
+    private String mMode;
+    private boolean mHasResumed;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        RidiEinkRefresh.configure(getWindow().getDecorView());
+        setContentView(R.layout.ridi_detail_settings);
+        mPackageManager = getPackageManager();
+        mList = findViewById(R.id.detail_list);
+        findViewById(R.id.detail_back).setOnClickListener(v -> finish());
+        mMode = getIntent().getStringExtra(EXTRA_MODE);
+        showPage();
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        overridePendingTransition(0, 0);
+        if (mHasResumed && mList != null && (MODE_APPS.equals(mMode)
+                || MODE_NOTIFICATIONS.equals(mMode)
+                || MODE_DEVELOPER.equals(mMode)
+                || MODE_APP_DETAIL.equals(mMode))) {
+            showPage();
+        }
+        mHasResumed = true;
+    }
+
+    @Override
+    public void finish() {
+        super.finish();
+        overridePendingTransition(0, 0);
+    }
+
+    private void showPage() {
+        final TextView title = findViewById(R.id.detail_back);
+        final List<Row> rows;
+        if (MODE_STORAGE.equals(mMode)) {
+            title.setText("저장소");
+            rows = storageRows();
+        } else if (MODE_NOTIFICATIONS.equals(mMode)) {
+            title.setText("알림");
+            rows = notificationRows();
+        } else if (MODE_DEVICE_INFO.equals(mMode)) {
+            title.setText("기기 정보");
+            rows = deviceInfoRows();
+        } else if (MODE_DEVELOPER.equals(mMode)) {
+            title.setText("개발자 옵션");
+            rows = developerRows();
+        } else if (MODE_DATE_TIME.equals(mMode)) {
+            title.setText("날짜 및 시간");
+            rows = dateTimeRows();
+        } else if (MODE_APP_DETAIL.equals(mMode)) {
+            title.setText("앱 정보");
+            rows = appDetailRows(getIntent().getStringExtra(EXTRA_PACKAGE));
+        } else {
+            mMode = MODE_APPS;
+            title.setText("설치된 앱");
+            rows = installedAppRows();
+        }
+        mList.setAdapter(new RowAdapter(rows));
+        RidiEinkRefresh.invalidate(getWindow().getDecorView());
+    }
+
+    private List<ApplicationInfo> visibleApplications() {
+        final List<ApplicationInfo> apps = new ArrayList<>(
+                mPackageManager.getInstalledApplications(
+                        PackageManager.MATCH_DISABLED_COMPONENTS));
+        // The stock reader list is an app-facing list, not a dump of every
+        // headless framework package. Keeping those packages out also avoids
+        // loading scores of icons and binder states on the single-core target.
+        for (int i = apps.size() - 1; i >= 0; i--) {
+            final ApplicationInfo app = apps.get(i);
+            final boolean userApp = (app.flags & ApplicationInfo.FLAG_SYSTEM) == 0
+                    || (app.flags & ApplicationInfo.FLAG_UPDATED_SYSTEM_APP) != 0;
+            if (!userApp && mPackageManager.getLaunchIntentForPackage(app.packageName) == null) {
+                apps.remove(i);
+            }
+        }
+        Collections.sort(apps, new Comparator<ApplicationInfo>() {
+            @Override
+            public int compare(ApplicationInfo left, ApplicationInfo right) {
+                return label(left).compareToIgnoreCase(label(right));
+            }
+        });
+        return apps;
+    }
+
+    private String label(ApplicationInfo app) {
+        try {
+            final CharSequence label = app.loadLabel(mPackageManager);
+            return TextUtils.isEmpty(label) ? app.packageName : label.toString();
+        } catch (RuntimeException e) {
+            return app.packageName;
+        }
+    }
+
+    private Drawable icon(ApplicationInfo app) {
+        try {
+            return app.loadIcon(mPackageManager);
+        } catch (RuntimeException e) {
+            return getDrawable(R.drawable.ridi_icon_applications);
+        }
+    }
+
+    private List<Row> installedAppRows() {
+        final List<Row> rows = new ArrayList<>();
+        for (ApplicationInfo app : visibleApplications()) {
+            final ApplicationInfo selected = app;
+            rows.add(new Row(icon(app), label(app), app.packageName, true, () -> {
+                final Intent intent = new Intent(this, RidiDetailSettingsActivity.class);
+                intent.putExtra(EXTRA_MODE, MODE_APP_DETAIL);
+                intent.putExtra(EXTRA_PACKAGE, selected.packageName);
+                startActivity(intent);
+            }));
+        }
+        return rows;
+    }
+
+    private List<Row> notificationRows() {
+        final List<Row> rows = new ArrayList<>();
+        for (ApplicationInfo app : visibleApplications()) {
+            final ApplicationInfo selected = app;
+            final boolean enabled = !mNotificationBackend.getNotificationsBanned(
+                    app.packageName, app.uid);
+            rows.add(Row.switchRow(icon(app), label(app),
+                    enabled ? "알림 허용" : "알림 차단", enabled, () -> {
+                        final boolean currentlyEnabled = !mNotificationBackend
+                                .getNotificationsBanned(selected.packageName, selected.uid);
+                        if (!mNotificationBackend.setNotificationsEnabledForPackage(
+                                selected.packageName, selected.uid, !currentlyEnabled)) {
+                            Toast.makeText(this, "알림 설정을 변경할 수 없습니다.",
+                                    Toast.LENGTH_SHORT).show();
+                        }
+                        showPage();
+                    }));
+        }
+        return rows;
+    }
+
+    private List<Row> storageRows() {
+        final List<Row> rows = new ArrayList<>();
+        addStorageRow(rows, "내부 저장소", Environment.getDataDirectory());
+        final File external = Environment.getExternalStorageDirectory();
+        if (Environment.isExternalStorageRemovable(external)) {
+            addStorageRow(rows, "SD 카드", external);
+        }
+        return rows;
+    }
+
+    private void addStorageRow(List<Row> rows, String title, File path) {
+        try {
+            final StatFs stats = new StatFs(path.getAbsolutePath());
+            final long total = stats.getTotalBytes();
+            final long available = stats.getAvailableBytes();
+            final String summary = Formatter.formatFileSize(this, total - available)
+                    + " 사용 · " + Formatter.formatFileSize(this, available) + " 사용 가능"
+                    + " · 전체 " + Formatter.formatFileSize(this, total);
+            rows.add(new Row(getDrawable(R.drawable.ridi_icon_storage), title, summary,
+                    false, null));
+        } catch (RuntimeException e) {
+            rows.add(new Row(getDrawable(R.drawable.ridi_icon_storage), title,
+                    "저장소 정보를 읽을 수 없음", false, null));
+        }
+    }
+
+    private List<Row> deviceInfoRows() {
+        final List<Row> rows = new ArrayList<>();
+        final Drawable icon = getDrawable(R.drawable.ridi_icon_device_info);
+        rows.add(new Row(icon, "모델", safe(Build.MODEL), false, null));
+        rows.add(new Row(icon, "Android 버전", safe(Build.VERSION.RELEASE), false, null));
+        rows.add(new Row(icon, "빌드 번호", safe(Build.DISPLAY), false, null));
+        rows.add(new Row(icon, "커널 버전", safe(System.getProperty("os.version")), false, null));
+        rows.add(new Row(icon, "기기", safe(Build.DEVICE), false, null));
+        rows.add(new Row(icon, "보드", safe(Build.BOARD), false, null));
+        return rows;
+    }
+
+    private List<Row> developerRows() {
+        final List<Row> rows = new ArrayList<>();
+        final Drawable icon = getDrawable(R.drawable.ridi_icon_developer);
+        final boolean adbEnabled = Settings.Global.getInt(getContentResolver(),
+                Settings.Global.ADB_ENABLED, 0) != 0;
+        rows.add(Row.switchRow(icon, "USB 디버깅",
+                adbEnabled ? "켜짐 · ADB 연결 가능" : "꺼짐 · 필요할 때 켤 수 있음",
+                adbEnabled, () -> {
+                    if (adbEnabled) {
+                        Settings.Global.putInt(getContentResolver(),
+                                Settings.Global.ADB_ENABLED, 0);
+                        showPage();
+                    } else {
+                        showUsbDebuggingConfirmation();
+                    }
+                }));
+        rows.add(new Row(icon, "USB 파일 전송",
+                "케이블 연결 시 내부 저장소 자동 공유", false, null));
+        return rows;
+    }
+
+    private void showUsbDebuggingConfirmation() {
+        final Dialog dialog = new Dialog(this);
+        dialog.setContentView(R.layout.ridi_usb_debugging_confirmation);
+        dialog.findViewById(R.id.ridi_usb_debugging_confirm_cancel)
+                .setOnClickListener(v -> dialog.dismiss());
+        dialog.findViewById(R.id.ridi_usb_debugging_confirm_accept)
+                .setOnClickListener(v -> {
+                    Settings.Global.putInt(getContentResolver(), Settings.Global.ADB_ENABLED, 1);
+                    dialog.dismiss();
+                    showPage();
+                });
+        dialog.setCanceledOnTouchOutside(false);
+        dialog.setOnDismissListener(ignored -> {
+            // Dialog.dismiss() removes its window before this callback is delivered.
+            // Recompose the uncovered settings page with one clean E Ink pass.
+            final View decor = getWindow().getDecorView();
+            decor.post(() -> RidiEinkRefresh.fullRefreshOnce(decor));
+        });
+
+        final Window window = dialog.getWindow();
+        window.setBackgroundDrawable(new ColorDrawable(Color.TRANSPARENT));
+        window.clearFlags(WindowManager.LayoutParams.FLAG_DIM_BEHIND);
+        window.setWindowAnimations(0);
+        dialog.show();
+        final DisplayMetrics metrics = getResources().getDisplayMetrics();
+        final int width = Math.min((int) (430 * metrics.density + 0.5f),
+                metrics.widthPixels - (int) (48 * metrics.density + 0.5f));
+        window.setLayout(width, WindowManager.LayoutParams.WRAP_CONTENT);
+    }
+
+    private List<Row> dateTimeRows() {
+        final List<Row> rows = new ArrayList<>();
+        final Drawable icon = getDrawable(R.drawable.ridi_icon_date);
+        final boolean autoTime = Settings.Global.getInt(getContentResolver(),
+                Settings.Global.AUTO_TIME, 0) != 0;
+        final boolean autoTimeZone = Settings.Global.getInt(getContentResolver(),
+                Settings.Global.AUTO_TIME_ZONE, 0) != 0;
+        final Date now = new Date();
+
+        rows.add(Row.switchRow(icon, "자동 날짜 및 시간",
+                autoTime ? "네트워크에서 제공한 시간 사용" : "수동으로 날짜와 시간 설정",
+                autoTime, () -> {
+                    Settings.Global.putInt(getContentResolver(), Settings.Global.AUTO_TIME,
+                            autoTime ? 0 : 1);
+                    showPage();
+                }));
+        rows.add(Row.switchRow(icon, "자동 시간대",
+                autoTimeZone ? "네트워크에서 제공한 시간대 사용" : "수동으로 시간대 선택",
+                autoTimeZone, () -> {
+                    Settings.Global.putInt(getContentResolver(), Settings.Global.AUTO_TIME_ZONE,
+                            autoTimeZone ? 0 : 1);
+                    showPage();
+                }));
+        rows.add(new Row(icon, "날짜 설정",
+                DateFormat.getDateFormat(this).format(now), !autoTime,
+                autoTime ? null : this::showDatePicker));
+        rows.add(new Row(icon, "시간 설정",
+                DateFormat.getTimeFormat(this).format(now), !autoTime,
+                autoTime ? null : this::showTimePicker));
+        rows.add(new Row(icon, "시간대 선택",
+                autoTimeZone ? "자동으로 설정됨"
+                        : ZoneGetter.getTimeZoneOffsetAndName(this, TimeZone.getDefault(), now).toString(),
+                !autoTimeZone, autoTimeZone ? null : this::showTimeZonePicker));
+        return rows;
+    }
+
+    private void showDatePicker() {
+        final Calendar current = Calendar.getInstance();
+        new DatePickerDialog(this, (view, year, month, dayOfMonth) -> {
+            final Calendar selected = Calendar.getInstance();
+            selected.set(Calendar.YEAR, year);
+            selected.set(Calendar.MONTH, month);
+            selected.set(Calendar.DAY_OF_MONTH, dayOfMonth);
+            ((AlarmManager) getSystemService(ALARM_SERVICE)).setTime(selected.getTimeInMillis());
+            showPage();
+        }, current.get(Calendar.YEAR), current.get(Calendar.MONTH),
+                current.get(Calendar.DAY_OF_MONTH)).show();
+    }
+
+    private void showTimePicker() {
+        final Calendar current = Calendar.getInstance();
+        new TimePickerDialog(this, (view, hourOfDay, minute) -> {
+            final Calendar selected = Calendar.getInstance();
+            selected.set(Calendar.HOUR_OF_DAY, hourOfDay);
+            selected.set(Calendar.MINUTE, minute);
+            selected.set(Calendar.SECOND, 0);
+            selected.set(Calendar.MILLISECOND, 0);
+            ((AlarmManager) getSystemService(ALARM_SERVICE)).setTime(selected.getTimeInMillis());
+            showPage();
+        }, current.get(Calendar.HOUR_OF_DAY), current.get(Calendar.MINUTE),
+                DateFormat.is24HourFormat(this)).show();
+    }
+
+    private void showTimeZonePicker() {
+        final List<Map<String, Object>> zones = ZoneGetter.getZonesList(this);
+        final CharSequence[] labels = new CharSequence[zones.size()];
+        int checked = -1;
+        final String currentId = TimeZone.getDefault().getID();
+        for (int i = 0; i < zones.size(); i++) {
+            final Map<String, Object> zone = zones.get(i);
+            labels[i] = TextUtils.concat((CharSequence) zone.get(ZoneGetter.KEY_OFFSET_LABEL),
+                    "  ", (CharSequence) zone.get(ZoneGetter.KEY_DISPLAY_LABEL));
+            if (currentId.equals(zone.get(ZoneGetter.KEY_ID))) {
+                checked = i;
+            }
+        }
+        new AlertDialog.Builder(this)
+                .setTitle("시간대 선택")
+                .setNegativeButton(android.R.string.cancel, null)
+                .setSingleChoiceItems(labels, checked, (dialog, position) -> {
+                    final String zoneId = (String) zones.get(position).get(ZoneGetter.KEY_ID);
+                    ((AlarmManager) getSystemService(ALARM_SERVICE)).setTimeZone(zoneId);
+                    dialog.dismiss();
+                    showPage();
+                })
+                .show();
+    }
+
+    private List<Row> appDetailRows(String packageName) {
+        final List<Row> rows = new ArrayList<>();
+        try {
+            final PackageInfo info = mPackageManager.getPackageInfo(packageName, 0);
+            final ApplicationInfo app = info.applicationInfo;
+            final Drawable appIcon = icon(app);
+            rows.add(new Row(appIcon, label(app), packageName, false, null));
+            rows.add(new Row(appIcon, "버전", safe(info.versionName)
+                    + " (" + info.versionCode + ")", false, null));
+            final Intent launch = mPackageManager.getLaunchIntentForPackage(packageName);
+            if (launch != null) {
+                rows.add(new Row(appIcon, "앱 열기", "앱을 실행합니다", true,
+                        () -> startActivity(launch)));
+            }
+            if ((app.flags & ApplicationInfo.FLAG_SYSTEM) == 0
+                    || (app.flags & ApplicationInfo.FLAG_UPDATED_SYSTEM_APP) != 0) {
+                rows.add(new Row(appIcon, "앱 삭제", "기기에서 앱을 제거합니다", true,
+                        () -> confirmUninstall(packageName, label(app))));
+            }
+        } catch (PackageManager.NameNotFoundException e) {
+            rows.add(new Row(getDrawable(R.drawable.ridi_icon_applications), "앱 없음",
+                    "이미 삭제된 앱입니다", false, null));
+        }
+        return rows;
+    }
+
+    private void confirmUninstall(String packageName, String appLabel) {
+        new AlertDialog.Builder(this)
+                .setTitle("앱 삭제")
+                .setMessage(appLabel + " 앱을 삭제할까요?")
+                .setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton("삭제", (dialog, which) -> startActivity(
+                        new Intent(Intent.ACTION_UNINSTALL_PACKAGE,
+                                Uri.parse("package:" + packageName))))
+                .show();
+    }
+
+    private static String safe(String value) {
+        return TextUtils.isEmpty(value) ? "알 수 없음" : value;
+    }
+
+    private static final class Row {
+        final Drawable icon;
+        final String title;
+        final String summary;
+        final boolean actionable;
+        final Boolean checked;
+        final Runnable action;
+
+        Row(Drawable icon, String title, String summary, boolean actionable, Runnable action) {
+            this(icon, title, summary, actionable, null, action);
+        }
+
+        private Row(Drawable icon, String title, String summary, boolean actionable,
+                Boolean checked, Runnable action) {
+            this.icon = icon;
+            this.title = title;
+            this.summary = summary;
+            this.actionable = actionable;
+            this.checked = checked;
+            this.action = action;
+        }
+
+        static Row switchRow(Drawable icon, String title, String summary,
+                boolean checked, Runnable action) {
+            return new Row(icon, title, summary, true, Boolean.valueOf(checked), action);
+        }
+    }
+
+    private final class RowAdapter extends ArrayAdapter<Row> {
+        RowAdapter(List<Row> rows) {
+            super(RidiDetailSettingsActivity.this, R.layout.ridi_setting_row, rows);
+        }
+
+        @Override
+        public View getView(int position, View convertView, ViewGroup parent) {
+            final View rowView = convertView != null ? convertView
+                    : LayoutInflater.from(getContext()).inflate(
+                            R.layout.ridi_setting_row, parent, false);
+            final Row row = getItem(position);
+            ((ImageView) rowView.findViewById(R.id.icon)).setImageDrawable(row.icon);
+            ((TextView) rowView.findViewById(R.id.title)).setText(row.title);
+            ((TextView) rowView.findViewById(R.id.summary)).setText(row.summary);
+            final CheckBox toggle = rowView.findViewById(R.id.toggle);
+            final View chevron = rowView.findViewById(R.id.chevron);
+            if (row.checked != null) {
+                toggle.setVisibility(View.VISIBLE);
+                toggle.setChecked(row.checked);
+                toggle.jumpDrawablesToCurrentState();
+                chevron.setVisibility(View.GONE);
+            } else {
+                toggle.setVisibility(View.GONE);
+                chevron.setVisibility(row.actionable ? View.VISIBLE : View.INVISIBLE);
+            }
+            rowView.setClickable(row.actionable);
+            rowView.setFocusable(row.actionable);
+            rowView.setOnClickListener(row.action == null ? null : v -> row.action.run());
+            return rowView;
+        }
+    }
+}
