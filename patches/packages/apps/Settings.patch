@@ -0,0 +1,255 @@
+/*
+ * Copyright (C) 2026 E70Q10 Android port
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ */
+package com.android.settings.ridi;
+
+import android.app.Activity;
+import android.content.ContentResolver;
+import android.content.Context;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.PowerManager;
+import android.util.DisplayMetrics;
+import android.view.View;
+import android.view.WindowManager;
+import android.widget.ImageView;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import com.android.settings.R;
+
+/** Fixed, animation-free frontlight and color-temperature controls. */
+public class RidiFrontlightActivity extends Activity {
+    private static final int BRIGHTNESS_STEP = 5;
+
+    private RidiLevelBar mBrightnessBar;
+    private RidiLevelBar mColorBar;
+    private View mBrightnessColumn;
+    private View mColorColumn;
+    private RidiFrontlightSession mSession;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        RidiEinkRefresh.configure(getWindow().getDecorView());
+        setContentView(R.layout.ridi_frontlight_settings);
+
+        mBrightnessColumn = findViewById(R.id.brightness_column);
+        mColorColumn = findViewById(R.id.temperature_column);
+        bindBrightnessColumn(mBrightnessColumn);
+        bindColorColumn(mColorColumn);
+
+        findViewById(R.id.frontlight_back).setOnClickListener(v -> finish());
+        setControlsEnabled(false);
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        setControlsEnabled(false);
+        final Handler callbacks = new Handler(Looper.getMainLooper());
+        mSession = new RidiFrontlightSession(
+                new FrontlightBackend(getApplicationContext()),
+                task -> callbacks.post(task), new RidiFrontlightSession.Listener() {
+                    @Override
+                    public void onLoaded(RidiFrontlightSession.State state) {
+                        mBrightnessBar.setMax(state.maxBrightness);
+                        mBrightnessBar.setLevel(state.brightness);
+                        mColorBar.setMax(state.maxColor);
+                        mColorBar.setLevel(state.color);
+                        setControlsEnabled(true);
+                    }
+
+                    @Override
+                    public void onWriteFailed() {
+                        showWriteError();
+                        setControlsEnabled(false);
+                        mSession.load();
+                    }
+                });
+        mSession.load();
+        overridePendingTransition(0, 0);
+    }
+
+    @Override
+    protected void onPause() {
+        if (mSession != null) {
+            mSession.close();
+            mSession = null;
+        }
+        super.onPause();
+    }
+
+    @Override
+    protected void onStart() {
+        super.onStart();
+        final DisplayMetrics metrics = new DisplayMetrics();
+        getWindowManager().getDefaultDisplay().getMetrics(metrics);
+        final int panelWidth = Math.min(
+                Math.round(510f * metrics.density),
+                Math.round(metrics.widthPixels * 0.94f));
+        final int panelHeight = Math.min(
+                Math.round(685f * metrics.density),
+                Math.round(metrics.heightPixels * 0.92f));
+        getWindow().setDimAmount(0f);
+        getWindow().clearFlags(WindowManager.LayoutParams.FLAG_DIM_BEHIND);
+        getWindow().getDecorView().setElevation(0f);
+        getWindow().setLayout(panelWidth, panelHeight);
+    }
+
+    @Override
+    public void finish() {
+        super.finish();
+        overridePendingTransition(0, 0);
+    }
+
+    private void bindBrightnessColumn(View column) {
+        ((TextView) column.findViewById(R.id.control_title))
+                .setText(R.string.ridi_brightness);
+        ((TextView) column.findViewById(R.id.high_label))
+                .setText(R.string.ridi_max_brightness);
+        ((TextView) column.findViewById(R.id.low_label))
+                .setText(R.string.ridi_min_brightness);
+        ((ImageView) column.findViewById(R.id.control_icon))
+                .setImageResource(R.drawable.ridi_frontlight_brightness);
+        mBrightnessBar = column.findViewById(R.id.level_stack);
+
+        column.findViewById(R.id.increase).setOnClickListener(v ->
+                changeBrightness(BRIGHTNESS_STEP));
+        column.findViewById(R.id.decrease).setOnClickListener(v ->
+                changeBrightness(-BRIGHTNESS_STEP));
+        mBrightnessBar.setOnLevelChangeListener(new FrontlightBarListener(true));
+    }
+
+    private void bindColorColumn(View column) {
+        ((TextView) column.findViewById(R.id.control_title))
+                .setText(R.string.ridi_color_temperature);
+        ((TextView) column.findViewById(R.id.high_label))
+                .setText(R.string.ridi_warm_color);
+        ((TextView) column.findViewById(R.id.low_label))
+                .setText(R.string.ridi_less_warm_color);
+        ((ImageView) column.findViewById(R.id.control_icon))
+                .setImageResource(R.drawable.ridi_frontlight_color);
+        mColorBar = column.findViewById(R.id.level_stack);
+
+        column.findViewById(R.id.increase).setOnClickListener(v ->
+                changeColor(1));
+        column.findViewById(R.id.decrease).setOnClickListener(v ->
+                changeColor(-1));
+        mColorBar.setOnLevelChangeListener(new FrontlightBarListener(false));
+    }
+
+    private void changeBrightness(int delta) {
+        if (mSession == null) return;
+        mBrightnessBar.setLevel(mBrightnessBar.getLevel() + delta);
+        mSession.commit(RidiFrontlightSession.BRIGHTNESS, mBrightnessBar.getLevel());
+    }
+
+    private void changeColor(int delta) {
+        if (mSession == null) return;
+        mColorBar.setLevel(mColorBar.getLevel() + delta);
+        mSession.commit(RidiFrontlightSession.COLOR, mColorBar.getLevel());
+    }
+
+    private void setControlsEnabled(boolean enabled) {
+        mBrightnessBar.setEnabled(enabled);
+        mColorBar.setEnabled(enabled);
+        for (View column : new View[] {mBrightnessColumn, mColorColumn}) {
+            column.findViewById(R.id.increase).setEnabled(enabled);
+            column.findViewById(R.id.decrease).setEnabled(enabled);
+        }
+    }
+
+    private void showWriteError() {
+        Toast.makeText(this, "프론트라이트 장치에 쓸 수 없습니다.",
+                Toast.LENGTH_SHORT).show();
+    }
+
+    private final class FrontlightBarListener
+            implements RidiLevelBar.OnLevelChangeListener {
+        private final boolean mBrightness;
+
+        FrontlightBarListener(boolean brightness) {
+            mBrightness = brightness;
+        }
+
+        @Override
+        public void onLevelChanging(RidiLevelBar bar, int level) {
+            // The stock popup communicates the value through the 20-cell bar;
+            // it does not add a numeric label below the gauge.
+            if (mSession != null) mSession.preview(mBrightness
+                    ? RidiFrontlightSession.BRIGHTNESS : RidiFrontlightSession.COLOR, level);
+        }
+
+        @Override
+        public void onLevelChanged(RidiLevelBar bar, int level) {
+            if (mSession != null) mSession.commit(mBrightness
+                    ? RidiFrontlightSession.BRIGHTNESS : RidiFrontlightSession.COLOR, level);
+        }
+    }
+
+    /** Only holds application services; queued saves never retain the popup. */
+    private static final class FrontlightBackend implements RidiFrontlightSession.Backend {
+        private final ContentResolver mResolver;
+        private final PowerManager mPower;
+
+        FrontlightBackend(Context context) {
+            mResolver = context.getContentResolver();
+            mPower = context.getSystemService(PowerManager.class);
+        }
+
+        @Override
+        public RidiFrontlightSession.State read() {
+            return new RidiFrontlightSession.State(
+                    RidiFrontlightController.getBrightness(),
+                    RidiFrontlightController.getMaxBrightness(),
+                    RidiFrontlightController.getColor(), RidiFrontlightController.getMaxColor());
+        }
+
+        @Override
+        public void preview(int control, int level, RidiFrontlightSession.State limits) {
+            apply(control, level, limits, false);
+        }
+
+        @Override
+        public boolean commit(int control, int level, RidiFrontlightSession.State limits) {
+            if (!apply(control, level, limits, true)) return false;
+            return control == RidiFrontlightSession.BRIGHTNESS
+                    ? RidiFrontlightController.persistBrightness(
+                            mResolver, level, limits.maxBrightness)
+                    : RidiFrontlightController.persistColor(mResolver, level);
+        }
+
+        private boolean apply(int control, int level, RidiFrontlightSession.State limits,
+                boolean finalValue) {
+            final boolean interactive = mPower.isInteractive();
+            if (!interactive && !finalValue) return true;
+            boolean success;
+            if (control == RidiFrontlightSession.BRIGHTNESS) {
+                // Persist the selected level while leaving the sleeping light at zero.
+                success = RidiFrontlightController.previewBrightness(
+                        interactive ? level : 0, limits.maxBrightness);
+            } else {
+                success = interactive || RidiFrontlightController.previewBrightness(
+                        0, limits.maxBrightness);
+                if (success) success = RidiFrontlightController.previewColor(level, limits.maxColor);
+            }
+            // Screen-off can occur while the sysfs write is in progress.
+            if (!mPower.isInteractive()) success &=
+                    RidiFrontlightController.previewBrightness(0, limits.maxBrightness);
+            return success;
+        }
+
+        @Override
+        public Runnable keepAwakeForCommit() {
+            final PowerManager.WakeLock lock = mPower.newWakeLock(
+                    PowerManager.PARTIAL_WAKE_LOCK, "RidiFrontlight:save");
+            lock.setReferenceCounted(false);
+            lock.acquire(5000);
+            return lock::release;
+        }
+    }
+}
