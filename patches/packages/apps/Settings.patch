+package com.android.settings.ridi;
+
+import android.content.Context;
+import android.util.AttributeSet;
+import android.widget.GridView;
+
+/** Image grid without inertial or overscroll frames. */
+public final class RidiEinkGridView extends GridView {
+    public RidiEinkGridView(Context context) {
+        super(context);
+        configure();
+    }
+
+    public RidiEinkGridView(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        configure();
+    }
+
+    public RidiEinkGridView(Context context, AttributeSet attrs, int defStyleAttr) {
+        super(context, attrs, defStyleAttr);
+        configure();
+    }
+
+    private void configure() {
+        setOverScrollMode(OVER_SCROLL_NEVER);
+        setSmoothScrollbarEnabled(false);
+        setScrollingCacheEnabled(false);
+        setAnimationCacheEnabled(false);
+        setVerticalScrollBarEnabled(false);
+    }
+
+    @Override
+    public boolean dispatchNestedPreFling(float velocityX, float velocityY) {
+        return true;
+    }
+
+    @Override
+    public void fling(int velocityY) {
+        // Deliberately no momentum frames.
+    }
+
+    @Override
+    public void smoothScrollToPosition(int position) {
+        setSelection(position);
+    }
+
+    @Override
+    public void smoothScrollBy(int distance, int duration) {
+        scrollListBy(distance);
+    }
+}
