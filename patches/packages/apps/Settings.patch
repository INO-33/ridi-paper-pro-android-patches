+/*
+ * Copyright (C) 2026 E70Q10 Android port
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ */
+package com.android.settings.ridi;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.ContentResolver;
+import android.content.Intent;
+import android.os.Bundle;
+import android.os.PowerManager;
+import android.provider.Settings;
+import android.text.format.DateFormat;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.ArrayAdapter;
+import android.widget.ImageView;
+import android.widget.ListView;
+import android.widget.CheckBox;
+import android.widget.TextView;
+
+import com.android.settings.R;
+
+/** E70Q10's static reader-oriented replacement for the generic Settings home. */
+public class RidiReaderSettingsActivity extends Activity {
+    private static final int[] SCREEN_TIMEOUT_MINUTES = {3, 5, 10, 15, 30, 45, 60};
+
+    private static final int TAB_DISPLAY = 0;
+    private static final int TAB_NETWORK = 1;
+    private static final int TAB_APPS = 2;
+    private static final int TAB_DEVICE = 3;
+
+    private ListView mList;
+    private TextView[] mTabs;
+    private ItemAdapter mAdapter;
+    private int mCurrentTab = TAB_DISPLAY;
+    private boolean mHasResumed;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        RidiEinkRefresh.configure(getWindow().getDecorView());
+        setContentView(R.layout.ridi_reader_settings);
+        initBatteryPercentDefault();
+        mList = findViewById(R.id.settings_list);
+        mTabs = new TextView[] {
+                findViewById(R.id.tab_display),
+                findViewById(R.id.tab_network),
+                findViewById(R.id.tab_apps),
+                findViewById(R.id.tab_device)
+        };
+        for (int i = 0; i < mTabs.length; i++) {
+            final int tab = i;
+            mTabs[i].setOnClickListener(v -> showTab(tab));
+        }
+        showTab(TAB_DISPLAY);
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        overridePendingTransition(0, 0);
+        if (mHasResumed && mAdapter != null) {
+            mAdapter.replace(itemsForTab(mCurrentTab));
+        }
+        mHasResumed = true;
+    }
+
+    @Override
+    public void finish() {
+        super.finish();
+        overridePendingTransition(0, 0);
+    }
+
+    private void showTab(int tab) {
+        mCurrentTab = tab;
+        for (int i = 0; i < mTabs.length; i++) {
+            mTabs[i].setBackgroundResource(i == tab
+                    ? R.drawable.ridi_tab_selected : android.R.color.white);
+        }
+        if (mAdapter == null) {
+            mAdapter = new ItemAdapter(itemsForTab(tab));
+            mList.setAdapter(mAdapter);
+        } else {
+            mAdapter.replace(itemsForTab(tab));
+        }
+        if (mList.getFirstVisiblePosition() != 0) {
+            mList.setSelection(0);
+        }
+        for (TextView tabView : mTabs) {
+            RidiEinkRefresh.invalidate(tabView);
+        }
+        RidiEinkRefresh.invalidate(mList);
+    }
+
+    private Item[] itemsForTab(int tab) {
+        switch (tab) {
+            case TAB_NETWORK:
+                return new Item[] {
+                        item(R.drawable.ridi_icon_wifi, "Wi-Fi",
+                                "무선 네트워크 연결",
+                                () -> startActivity(new Intent(this,
+                                        RidiWifiSettingsActivity.class))),
+                        switchItem(R.drawable.ridi_icon_date, "24시간 형식",
+                                timeFormatSummary(), is24HourFormat(),
+                                this::toggleTimeFormat),
+                        item(R.drawable.ridi_icon_date, "날짜 및 시간",
+                                "표준 시간대와 자동 시간 설정",
+                                () -> openDetail(RidiDetailSettingsActivity.MODE_DATE_TIME))
+                };
+            case TAB_APPS:
+                return new Item[] {
+                        item(R.drawable.ridi_icon_applications, "설치된 앱",
+                                "앱 목록, 실행 및 삭제",
+                                () -> openDetail(RidiDetailSettingsActivity.MODE_APPS)),
+                        item(R.drawable.ridi_icon_storage, "저장소",
+                                "내부 저장소와 SD 카드",
+                                () -> openDetail(RidiDetailSettingsActivity.MODE_STORAGE)),
+                        item(R.drawable.ridi_icon_notification, "알림",
+                                "앱별 알림 표시 설정",
+                                () -> openDetail(RidiDetailSettingsActivity.MODE_NOTIFICATIONS))
+                };
+            case TAB_DEVICE:
+                return new Item[] {
+                        switchItem(R.drawable.ridi_icon_battery, "배터리 잔량 숫자",
+                                batteryPercentSummary(), isBatteryPercentEnabled(),
+                                this::toggleBatteryPercent),
+                        item(R.drawable.ridi_icon_device_info, "기기 정보",
+                                "Android 버전과 기기 상태",
+                                () -> openDetail(RidiDetailSettingsActivity.MODE_DEVICE_INFO)),
+                        item(R.drawable.ridi_icon_developer, "개발자 옵션",
+                                "USB 디버깅 및 파일 전송",
+                                () -> openDetail(RidiDetailSettingsActivity.MODE_DEVELOPER)),
+                        item(R.drawable.ridi_icon_shutdown, "재부팅",
+                                "Android를 안전하게 다시 시작",
+                                this::confirmReboot)
+                };
+            case TAB_DISPLAY:
+            default:
+                return new Item[] {
+                        item(R.drawable.ridi_icon_frontlight, "프론트라이트",
+                                frontlightSummary(),
+                                () -> startActivity(new Intent(this,
+                                        RidiFrontlightActivity.class))),
+                        item(R.drawable.ridi_icon_sleep, "화면 꺼짐 시간",
+                                screenTimeoutSummary(),
+                                this::pickScreenTimeout),
+                        switchItem(R.drawable.ridi_icon_navigation, "내비게이션 바 숨기기",
+                                "끄면 일반 화면에서 표시 · 전체화면에서는 숨김",
+                                !RidiBarSettings.isAlwaysVisible(getContentResolver()), () -> {
+                                    RidiBarSettings.setAlwaysVisible(getContentResolver(),
+                                            !RidiBarSettings.isAlwaysVisible(getContentResolver()));
+                                    showTab(TAB_DISPLAY);
+                                }),
+                        item(R.drawable.ridi_icon_navigation, "내비게이션 바 표시 시간",
+                                navBarTimeoutSummary(), this::pickNavBarTimeout),
+                        item(R.drawable.ridi_icon_sleepscreen, "슬립 화면",
+                                screensaverSummary(),
+                                () -> startActivity(new Intent(this,
+                                        RidiScreensaverSettingsActivity.class))),
+                        switchItem(R.drawable.ridi_icon_page_buttons,
+                                "페이지 버튼 동시 누름으로 새로고침",
+                                "상·하 버튼을 함께 누르면 화면 전체 갱신",
+                                isPageKeyRefreshEnabled(), this::togglePageKeyRefresh)
+                };
+        }
+    }
+
+    private Item item(int icon, String title, String summary, Runnable action) {
+        return new Item(icon, title, summary, null, action);
+    }
+
+    private Item switchItem(int icon, String title, String summary, boolean checked,
+            Runnable action) {
+        return new Item(icon, title, summary, checked, action);
+    }
+
+    private void launchSettings(String className) {
+        final Intent intent = new Intent();
+        intent.setClassName(getPackageName(), className);
+        startActivity(intent);
+        overridePendingTransition(0, 0);
+    }
+
+    private void openDetail(String mode) {
+        final Intent intent = new Intent(this, RidiDetailSettingsActivity.class);
+        intent.putExtra(RidiDetailSettingsActivity.EXTRA_MODE, mode);
+        startActivity(intent);
+        overridePendingTransition(0, 0);
+    }
+
+    private String frontlightSummary() {
+        return "밝기 " + RidiFrontlightController.getBrightness()
+                + " · 색온도 " + RidiFrontlightController.getColor();
+    }
+
+    /**
+     * SystemUI's BatteryMeterView only observes
+     * {@link Settings.System#SHOW_BATTERY_PERCENT}, so this toggle has to read
+     * and write that key. The previous private property and "ridi_battery_percent"
+     * key were never read by the status bar, so the switch had no visible effect.
+     */
+    private boolean isBatteryPercentEnabled() {
+        return Settings.System.getInt(getContentResolver(),
+                Settings.System.SHOW_BATTERY_PERCENT, 0) != 0;
+    }
+
+    /**
+     * The platform default for SHOW_BATTERY_PERCENT is off, but this reader
+     * showed the battery text by default. Materialise that default once so the
+     * summary here and the status bar always agree.
+     */
+    private void initBatteryPercentDefault() {
+        if (Settings.System.getString(getContentResolver(),
+                Settings.System.SHOW_BATTERY_PERCENT) == null) {
+            Settings.System.putInt(getContentResolver(),
+                    Settings.System.SHOW_BATTERY_PERCENT, 1);
+        }
+    }
+
+    private String batteryPercentSummary() {
+        return isBatteryPercentEnabled() ? "표시" : "숨김";
+    }
+
+    private void toggleBatteryPercent() {
+        final boolean enabled = !isBatteryPercentEnabled();
+        Settings.System.putInt(getContentResolver(),
+                Settings.System.SHOW_BATTERY_PERCENT, enabled ? 1 : 0);
+        showTab(TAB_DEVICE);
+    }
+
+    /**
+     * The navigation bar is hidden until the user swipes up from the bottom
+     * edge. This picks how long it then stays on screen. SystemUI observes
+     * {@link RidiBarSettings#NAV_BAR_TIMEOUT}, so a change applies immediately.
+     */
+    private String navBarTimeoutSummary() {
+        return (RidiBarSettings.isAlwaysVisible(getContentResolver())
+                ? "전체화면에서 쓸어올린 뒤 " : "쓸어올린 뒤 ")
+                + RidiBarSettings.getTimeoutSeconds(getContentResolver()) + "초간 표시";
+    }
+
+    private int getScreenTimeoutMillis() {
+        return Settings.System.getInt(getContentResolver(),
+                Settings.System.SCREEN_OFF_TIMEOUT, 10 * 60 * 1000);
+    }
+
+    private String screenTimeoutSummary() {
+        return Math.max(1, getScreenTimeoutMillis() / 60000) + "분 후 슬립 모드";
+    }
+
+    /** Reproduces the stock 4.4.2 "슬립 모드 타이머" choices. */
+    private void pickScreenTimeout() {
+        final String[] labels = new String[SCREEN_TIMEOUT_MINUTES.length];
+        final int current = getScreenTimeoutMillis();
+        int checked = -1;
+        for (int i = 0; i < SCREEN_TIMEOUT_MINUTES.length; i++) {
+            labels[i] = SCREEN_TIMEOUT_MINUTES[i] + "분";
+            if (SCREEN_TIMEOUT_MINUTES[i] * 60 * 1000 == current) {
+                checked = i;
+            }
+        }
+        new AlertDialog.Builder(this)
+                .setTitle("슬립 모드 타이머")
+                .setSingleChoiceItems(labels, checked, (dialog, which) -> {
+                    Settings.System.putInt(getContentResolver(),
+                            Settings.System.SCREEN_OFF_TIMEOUT,
+                            SCREEN_TIMEOUT_MINUTES[which] * 60 * 1000);
+                    dialog.dismiss();
+                    showTab(TAB_DISPLAY);
+                })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private void pickNavBarTimeout() {
+        final int[] choices = RidiBarSettings.TIMEOUT_CHOICES_SECONDS;
+        final String[] labels = new String[choices.length];
+        for (int i = 0; i < choices.length; i++) {
+            labels[i] = choices[i] + "초";
+        }
+        final int current = RidiBarSettings.getTimeoutSeconds(getContentResolver());
+        int checked = 0;
+        for (int i = 0; i < choices.length; i++) {
+            if (choices[i] == current) {
+                checked = i;
+                break;
+            }
+        }
+        new AlertDialog.Builder(this)
+                .setTitle("내비게이션 바 표시 시간")
+                .setSingleChoiceItems(labels, checked, (dialog, which) -> {
+                    RidiBarSettings.setTimeoutSeconds(getContentResolver(), choices[which]);
+                    dialog.dismiss();
+                    showTab(TAB_DISPLAY);
+                })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    /**
+     * Status bar clock format.
+     *
+     * This is the platform's {@link Settings.System#TIME_12_24}, so it also
+     * applies to every app that asks {@code DateFormat.is24HourFormat()}.
+     */
+    private boolean is24HourFormat() {
+        return DateFormat.is24HourFormat(this);
+    }
+
+    private String timeFormatSummary() {
+        return is24HourFormat() ? "24시간으로 표시" : "오전 / 오후 12시간으로 표시";
+    }
+
+    private void toggleTimeFormat() {
+        setTimeFormat(!is24HourFormat());
+        showTab(TAB_NETWORK);
+    }
+
+    /**
+     * Writes the setting and broadcasts the change the same way the AOSP date
+     * and time screen does, so the status bar clock and running apps pick the
+     * new format up immediately.
+     */
+    private void setTimeFormat(boolean is24Hour) {
+        Settings.System.putString(getContentResolver(), Settings.System.TIME_12_24,
+                is24Hour ? "24" : "12");
+
+        final Intent timeChanged = new Intent(Intent.ACTION_TIME_CHANGED);
+        timeChanged.putExtra(Intent.EXTRA_TIME_PREF_24_HOUR_FORMAT,
+                is24Hour ? Intent.EXTRA_TIME_PREF_VALUE_USE_24_HOUR
+                        : Intent.EXTRA_TIME_PREF_VALUE_USE_12_HOUR);
+        sendBroadcast(timeChanged);
+    }
+
+    /**
+     * The panel keeps the suspend image without power, so the screensaver costs
+     * nothing to leave on. These options pick what that still frame shows.
+     */
+    private String screensaverSummary() {
+        final ContentResolver resolver = getContentResolver();
+        return RidiScreensaverSettings.styleLabel(resolver);
+    }
+
+    private boolean isPageKeyRefreshEnabled() {
+        return Settings.System.getInt(getContentResolver(), "ridi_page_key_refresh", 0) != 0;
+    }
+
+    private void togglePageKeyRefresh() {
+        Settings.System.putInt(getContentResolver(), "ridi_page_key_refresh",
+                isPageKeyRefreshEnabled() ? 0 : 1);
+        showTab(TAB_DISPLAY);
+    }
+
+    private void confirmReboot() {
+        new AlertDialog.Builder(this)
+                .setTitle("재부팅")
+                .setMessage("기기를 다시 시작할까요?")
+                .setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton("재부팅", (dialog, which) -> {
+                    final PowerManager power = getSystemService(PowerManager.class);
+                    if (power != null) {
+                        power.reboot(null);
+                    }
+                })
+                .show();
+    }
+
+    private static final class Item {
+        final int icon;
+        final String title;
+        final String summary;
+        final Boolean checked;
+        final Runnable action;
+
+        Item(int icon, String title, String summary, Boolean checked, Runnable action) {
+            this.icon = icon;
+            this.title = title;
+            this.summary = summary;
+            this.checked = checked;
+            this.action = action;
+        }
+    }
+
+    private final class ItemAdapter extends ArrayAdapter<Item> {
+        ItemAdapter(Item[] items) {
+            super(RidiReaderSettingsActivity.this, R.layout.ridi_setting_row);
+            setNotifyOnChange(false);
+            addAll(items);
+        }
+
+        void replace(Item[] items) {
+            setNotifyOnChange(false);
+            clear();
+            addAll(items);
+            notifyDataSetChanged();
+        }
+
+        @Override
+        public View getView(int position, View convertView, ViewGroup parent) {
+            final View row = convertView != null ? convertView
+                    : LayoutInflater.from(getContext()).inflate(
+                            R.layout.ridi_setting_row, parent, false);
+            final Item item = getItem(position);
+            ((ImageView) row.findViewById(R.id.icon)).setImageResource(item.icon);
+            ((TextView) row.findViewById(R.id.title)).setText(item.title);
+            ((TextView) row.findViewById(R.id.summary)).setText(item.summary);
+            final CheckBox toggle = row.findViewById(R.id.toggle);
+            final View chevron = row.findViewById(R.id.chevron);
+            if (item.checked != null) {
+                toggle.setVisibility(View.VISIBLE);
+                toggle.setChecked(item.checked);
+                toggle.jumpDrawablesToCurrentState();
+                chevron.setVisibility(View.GONE);
+            } else {
+                toggle.setVisibility(View.GONE);
+                chevron.setVisibility(View.VISIBLE);
+            }
+            row.setOnClickListener(v -> item.action.run());
+            return row;
+        }
+    }
+}
diff --git a/src/com/android/settings/ridi/RidiScreensaverImagePickerActivity.java b/src/com/android/settings/ridi/RidiScreensaverImagePickerActivity.java
new file mode 100644
index 0000000000000000000000000000000000000000..4725c255b4d9e7164c9a2079cd912e1cda68c636
--- /dev/null
+++ b/src/com/android/settings/ridi/RidiScreensaverImagePickerActivity.java
@@ -0,0 +1,227 @@
+/*
+ * Copyright (C) 2026 E70Q10 Android port
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ */
+package com.android.settings.ridi;
+
+import android.app.Activity;
+import android.graphics.Bitmap;
+import android.os.Bundle;
+import android.os.Environment;
+import android.util.DisplayMetrics;
+import android.util.LruCache;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.WindowManager;
+import android.widget.BaseAdapter;
+import android.widget.GridView;
+import android.widget.ImageView;
+import android.widget.TextView;
+
+import com.android.settings.R;
+
+import java.io.File;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Comparator;
+import java.util.List;
+
+/** Thumbnail picker for images in internal-storage/Sleepingscreen. */
+public class RidiScreensaverImagePickerActivity extends Activity {
+    private static final String DIRECTORY = "Sleepingscreen";
+    private static final String[] EXTENSIONS = {
+            ".png", ".jpg", ".jpeg", ".gif", ".bmp"
+    };
+    private static final int MAX_ENTRIES = 60;
+
+    private final LruCache<String, Bitmap> mThumbnails =
+            new LruCache<String, Bitmap>(8 * 1024 * 1024) {
+                @Override
+                protected int sizeOf(String key, Bitmap value) {
+                    return value.getByteCount();
+                }
+            };
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        RidiEinkRefresh.configure(getWindow().getDecorView());
+        setContentView(R.layout.ridi_screensaver_picker);
+        findViewById(R.id.screensaver_picker_back).setOnClickListener(v -> finish());
+
+        final List<File> images = findImages();
+        final GridView grid = findViewById(R.id.screensaver_image_grid);
+        final View empty = findViewById(R.id.screensaver_picker_empty);
+        grid.setVisibility(images.isEmpty() ? View.GONE : View.VISIBLE);
+        empty.setVisibility(images.isEmpty() ? View.VISIBLE : View.GONE);
+        if (!images.isEmpty()) {
+            final ImageAdapter adapter = new ImageAdapter(images);
+            grid.setAdapter(adapter);
+            // Apply before the first layout so opening the picker needs no animated scroll.
+            if (adapter.getSelectedPosition() >= 0) {
+                grid.setSelection(adapter.getSelectedPosition());
+            }
+            grid.setOnItemClickListener((parent, view, position, id) -> {
+                final String path = images.get(position).getAbsolutePath();
+                RidiScreensaverSettings.setImagePath(getContentResolver(), path);
+                RidiScreensaverSettings.setStyle(getContentResolver(),
+                        RidiScreensaverSettings.STYLE_USER);
+                finish();
+            });
+        }
+    }
+
+    @Override
+    protected void onStart() {
+        super.onStart();
+        final DisplayMetrics metrics = new DisplayMetrics();
+        getWindowManager().getDefaultDisplay().getMetrics(metrics);
+        final int panelWidth = Math.min(Math.round(510f * metrics.density),
+                Math.round(metrics.widthPixels * 0.94f));
+        final int panelHeight = Math.min(Math.round(685f * metrics.density),
+                Math.round(metrics.heightPixels * 0.92f));
+        getWindow().setDimAmount(0f);
+        getWindow().clearFlags(WindowManager.LayoutParams.FLAG_DIM_BEHIND);
+        getWindow().getDecorView().setElevation(0f);
+        getWindow().setLayout(panelWidth, panelHeight);
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        overridePendingTransition(0, 0);
+    }
+
+    @Override
+    protected void onDestroy() {
+        mThumbnails.evictAll();
+        super.onDestroy();
+    }
+
+    @Override
+    public void finish() {
+        super.finish();
+        overridePendingTransition(0, 0);
+    }
+
+    private List<File> findImages() {
+        final List<File> found = new ArrayList<>();
+        appendImages(found, new File("/system/usr/sleep"), true);
+        final File root = Environment.getExternalStorageDirectory();
+        if (root != null) {
+            final File directory = new File(root, DIRECTORY);
+            if (!directory.exists()) directory.mkdirs();
+            appendImages(found, directory, false);
+        }
+        return found;
+    }
+
+    private void appendImages(List<File> found, File directory, boolean builtIn) {
+        if (!directory.isDirectory() || !directory.canRead()) return;
+        final File[] entries = directory.listFiles();
+        if (entries == null) return;
+        Arrays.sort(entries, new Comparator<File>() {
+            @Override
+            public int compare(File left, File right) {
+                return builtIn ? left.getName().compareTo(right.getName())
+                        : Long.compare(right.lastModified(), left.lastModified());
+            }
+        });
+        for (File entry : entries) {
+            if (found.size() >= MAX_ENTRIES) break;
+            if (entry.isFile() && isImage(entry.getName())) found.add(entry);
+        }
+    }
+
+    private boolean isImage(String name) {
+        final String lower = name.toLowerCase();
+        for (String extension : EXTENSIONS) {
+            if (lower.endsWith(extension)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private final class ImageAdapter extends BaseAdapter {
+        private final List<File> mImages;
+        private final LayoutInflater mInflater;
+        private final int mSelectedPosition;
+
+        ImageAdapter(List<File> images) {
+            mImages = images;
+            mInflater = LayoutInflater.from(RidiScreensaverImagePickerActivity.this);
+            final String currentPath = RidiScreensaverSettings.getStyle(getContentResolver())
+                    == RidiScreensaverSettings.STYLE_USER
+                    ? RidiScreensaverSettings.getImagePath(getContentResolver())
+                    : "/system/usr/sleep/suspend.jpg";
+            int selectedPosition = -1;
+            for (int i = 0; i < images.size(); i++) {
+                if (images.get(i).getAbsolutePath().equals(currentPath)) {
+                    selectedPosition = i;
+                    break;
+                }
+            }
+            mSelectedPosition = selectedPosition;
+        }
+
+        int getSelectedPosition() {
+            return mSelectedPosition;
+        }
+
+        @Override
+        public int getCount() {
+            return mImages.size();
+        }
+
+        @Override
+        public File getItem(int position) {
+            return mImages.get(position);
+        }
+
+        @Override
+        public long getItemId(int position) {
+            return position;
+        }
+
+        @Override
+        public View getView(int position, View convertView, ViewGroup parent) {
+            final ViewHolder holder;
+            if (convertView == null) {
+                convertView = mInflater.inflate(R.layout.ridi_screensaver_image_item,
+                        parent, false);
+                holder = new ViewHolder();
+                holder.thumbnail = convertView.findViewById(R.id.image_thumbnail);
+                holder.name = convertView.findViewById(R.id.image_name);
+                holder.selected = convertView.findViewById(R.id.image_selected);
+                convertView.setTag(holder);
+            } else {
+                holder = (ViewHolder) convertView.getTag();
+            }
+
+            final File image = getItem(position);
+            final String path = image.getAbsolutePath();
+            Bitmap thumbnail = mThumbnails.get(path);
+            if (thumbnail == null) {
+                thumbnail = RidiScreensaverSettingsActivity.decodeSampledBitmap(
+                        path, 256, 342);
+                if (thumbnail != null) {
+                    mThumbnails.put(path, thumbnail);
+                }
+            }
+            holder.thumbnail.setImageBitmap(thumbnail);
+            holder.name.setText(image.getName());
+            holder.selected.setVisibility(position == mSelectedPosition
+                    ? View.VISIBLE : View.GONE);
+            return convertView;
+        }
+    }
+
+    private static final class ViewHolder {
+        ImageView thumbnail;
+        TextView name;
+        ImageView selected;
+    }
+}
