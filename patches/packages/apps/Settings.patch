+package com.android.settings.ridi;
+
+import android.os.Bundle;
+import android.app.ActionBar;
+import android.view.ViewGroup;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.Switch;
+
+import com.android.settings.R;
+import com.android.settings.SettingsActivity;
+import com.android.settings.widget.SwitchBar;
+
+/**
+ * Reader entry point for Android's complete Wi-Fi settings implementation.
+ *
+ * The activity intentionally does not reimplement network discovery or
+ * configuration. Its manifest metadata asks SettingsActivity to host the
+ * platform WifiSettings fragment, including WifiDialog/WifiConfigController.
+ * This preserves saved-network handling, forget/cancel, EAP, proxy,
+ * DHCP/static IP and validation behavior from Android O.
+ */
+public class RidiWifiSettingsActivity extends SettingsActivity {
+    @Override
+    protected void onCreate(Bundle savedState) {
+        super.onCreate(savedState);
+        applyStockChrome();
+        overridePendingTransition(0, 0);
+    }
+
+    private void applyStockChrome() {
+        final ActionBar actionBar = getActionBar();
+        if (actionBar != null) {
+            actionBar.setHomeAsUpIndicator(R.drawable.ridi_panel_back);
+        }
+
+        final SwitchBar switchBar = getSwitchBar();
+        if (switchBar == null) {
+            return;
+        }
+
+        final int rowHeight = dpToPx(64);
+        final ViewGroup.LayoutParams barParams = switchBar.getLayoutParams();
+        barParams.height = rowHeight;
+        switchBar.setLayoutParams(barParams);
+        switchBar.setBackgroundResource(R.drawable.ridi_wifi_row_background);
+
+        final ImageView wifiIcon = new ImageView(this);
+        wifiIcon.setImageResource(R.drawable.ridi_icon_wifi);
+        wifiIcon.setScaleType(ImageView.ScaleType.CENTER_INSIDE);
+        wifiIcon.setContentDescription(null);
+        final LinearLayout.LayoutParams iconParams = new LinearLayout.LayoutParams(
+                dpToPx(34), dpToPx(34));
+        iconParams.setMarginStart(dpToPx(18));
+        iconParams.setMarginEnd(dpToPx(14));
+        iconParams.gravity = android.view.Gravity.CENTER_VERTICAL;
+        switchBar.addView(wifiIcon, 0, iconParams);
+
+        final Switch wifiSwitch = switchBar.getSwitch();
+        wifiSwitch.setShowText(false);
+        wifiSwitch.setThumbDrawable(null);
+        wifiSwitch.setTrackDrawable(null);
+        wifiSwitch.setBackgroundResource(R.drawable.ridi_stock_onoff_button);
+        final ViewGroup.LayoutParams switchParams = wifiSwitch.getLayoutParams();
+        switchParams.width = dpToPx(71);
+        switchParams.height = dpToPx(30);
+        wifiSwitch.setLayoutParams(switchParams);
+        wifiSwitch.setPadding(0, 0, 0, 0);
+    }
+
+    private int dpToPx(int dp) {
+        return Math.round(dp * getResources().getDisplayMetrics().density);
+    }
+
+    @Override
+    public void finish() {
+        super.finish();
+        overridePendingTransition(0, 0);
+    }
+}
