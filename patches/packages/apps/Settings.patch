+            <View
+                android:layout_width="1dp"
+                android:layout_height="match_parent"
+                android:background="#ff000000" />
+
+            <include
+                android:id="@+id/temperature_column"
+                layout="@layout/ridi_frontlight_column"
+                android:layout_width="0dp"
+                android:layout_height="match_parent"
+                android:layout_weight="1" />
+        </LinearLayout>
+    </LinearLayout>
+</FrameLayout>
diff --git a/res/layout/ridi_preference_widget_switch.xml b/res/layout/ridi_preference_widget_switch.xml
new file mode 100644
index 0000000000000000000000000000000000000000..e1d36cb5568b01596329638f84c1bfed7e528de4
--- /dev/null
+++ b/res/layout/ridi_preference_widget_switch.xml
@@ -0,0 +1,14 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Stock PAPER uses one complete ON/OFF bitmap per state, not a sliding Switch. -->
+<CheckBox xmlns:android="http://schemas.android.com/apk/res/android"
+    android:id="@android:id/switch_widget"
+    android:layout_width="71dp"
+    android:layout_height="30dp"
+    android:layout_marginEnd="10dp"
+    android:background="@drawable/ridi_stock_onoff_button"
+    android:button="@null"
+    android:clickable="false"
+    android:focusable="false"
+    android:minHeight="0dp"
+    android:minWidth="0dp"
+    android:padding="0dp" />
diff --git a/res/layout/ridi_reader_settings.xml b/res/layout/ridi_reader_settings.xml
new file mode 100644
index 0000000000000000000000000000000000000000..9a4d22f512d47dc3a2bb3168447d2c57042504d8
--- /dev/null
+++ b/res/layout/ridi_reader_settings.xml
@@ -0,0 +1,100 @@
+<?xml version="1.0" encoding="utf-8"?>
+<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="#ffffffff"
+    android:foregroundGravity="center">
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="match_parent"
+        android:background="#ffffffff"
+        android:orientation="vertical">
+
+        <!-- Stock PanelTitleView: 48dp, white, 40dp icon and 18sp title. -->
+        <LinearLayout
+            android:layout_width="match_parent"
+            android:layout_height="@dimen/ridi_title_height"
+            android:gravity="center_vertical"
+            android:orientation="horizontal"
+            android:paddingStart="4dp"
+            android:paddingEnd="8dp">
+
+            <ImageView
+                android:layout_width="40dp"
+                android:layout_height="40dp"
+                android:contentDescription="@null"
+                android:src="@drawable/ridi_panel_icon_settings" />
+
+            <TextView
+                android:layout_width="0dp"
+                android:layout_height="match_parent"
+                android:layout_weight="1"
+                android:drawablePadding="7dp"
+                android:gravity="center_vertical"
+                android:text="@string/ridi_reader_settings_title"
+                android:textColor="#ff000000"
+                android:textSize="18sp"
+                android:textStyle="bold" />
+        </LinearLayout>
+
+        <FrameLayout
+            android:layout_width="match_parent"
+            android:layout_height="@dimen/ridi_tab_height"
+            android:layout_marginBottom="4dp">
+
+            <LinearLayout
+                android:layout_width="match_parent"
+                android:layout_height="match_parent"
+                android:baselineAligned="false"
+                android:orientation="horizontal"
+                android:paddingStart="12dp"
+                android:paddingEnd="12dp">
+
+                <TextView
+                    android:id="@+id/tab_display"
+                    style="@style/RidiReaderTab"
+                    android:background="@drawable/ridi_tab_selected"
+                    android:text="@string/ridi_tab_display" />
+
+                <TextView
+                    android:id="@+id/tab_network"
+                    style="@style/RidiReaderTab"
+                    android:text="@string/ridi_tab_network" />
+
+                <TextView
+                    android:id="@+id/tab_apps"
+                    style="@style/RidiReaderTab"
+                    android:text="@string/ridi_tab_apps" />
+
+                <TextView
+                    android:id="@+id/tab_device"
+                    style="@style/RidiReaderTab"
+                    android:text="@string/ridi_tab_device" />
+            </LinearLayout>
+
+            <View
+                android:layout_width="match_parent"
+                android:layout_height="1dp"
+                android:layout_gravity="bottom"
+                android:background="#ff000000" />
+        </FrameLayout>
+
+        <com.android.settings.ridi.RidiEinkListView
+            android:id="@+id/settings_list"
+            android:layout_width="match_parent"
+            android:layout_height="0dp"
+            android:layout_weight="1"
+            android:animationCache="false"
+            android:cacheColorHint="#ffffffff"
+            android:divider="@drawable/ridi_row_divider"
+            android:dividerHeight="1dp"
+            android:drawSelectorOnTop="false"
+            android:fastScrollEnabled="false"
+            android:listSelector="@android:color/transparent"
+            android:overScrollMode="never"
+            android:smoothScrollbar="false"
+            android:scrollbars="none"
+            android:scrollingCache="false" />
+    </LinearLayout>
+</FrameLayout>
diff --git a/res/layout/ridi_screensaver_image_item.xml b/res/layout/ridi_screensaver_image_item.xml
