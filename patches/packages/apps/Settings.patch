diff --git a/res/layout/ridi_frontlight_column.xml b/res/layout/ridi_frontlight_column.xml
new file mode 100644
index 0000000000000000000000000000000000000000..eadb465fec68d18e79ed376774c707b3fd5efc7a
--- /dev/null
+++ b/res/layout/ridi_frontlight_column.xml
@@ -0,0 +1,75 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Structure follows stock activity_brightness.xml and its 53dp controls. -->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:gravity="center_horizontal"
+    android:orientation="vertical"
+    android:paddingStart="16dp"
+    android:paddingEnd="16dp"
+    android:paddingBottom="14dp">
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="48dp"
+        android:gravity="center"
+        android:orientation="horizontal">
+
+        <ImageView
+            android:id="@+id/control_icon"
+            android:layout_width="40dp"
+            android:layout_height="40dp"
+            android:contentDescription="@null" />
+
+        <TextView
+            android:id="@+id/control_title"
+            android:layout_width="wrap_content"
+            android:layout_height="match_parent"
+            android:drawablePadding="7dp"
+            android:gravity="center_vertical"
+            android:textColor="#ff000000"
+            android:textSize="18sp"
+            android:textStyle="bold" />
+    </LinearLayout>
+
+    <TextView
+        android:id="@+id/high_label"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:gravity="center"
+        android:textColor="#ff666666"
+        android:textSize="14sp" />
+
+    <ImageButton
+        android:id="@+id/increase"
+        android:layout_width="53dp"
+        android:layout_height="53dp"
+        android:background="@drawable/ridi_brightness_button"
+        android:contentDescription="@null"
+        android:src="@drawable/ridi_brightness_plus" />
+
+    <!-- The level stack itself is the control: drag it to set the value. -->
+    <com.android.settings.ridi.RidiLevelBar
+        android:id="@+id/level_stack"
+        android:layout_width="66dp"
+        android:layout_height="0dp"
+        android:layout_weight="1"
+        android:contentDescription="@null" />
+
+    <ImageButton
+        android:id="@+id/decrease"
+        android:layout_width="53dp"
+        android:layout_height="53dp"
+        android:background="@drawable/ridi_brightness_button"
+        android:contentDescription="@null"
+        android:src="@drawable/ridi_brightness_minus" />
+
+    <TextView
+        android:id="@+id/low_label"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="10dp"
+        android:gravity="center"
+        android:textColor="#ff666666"
+        android:textSize="14sp" />
+</LinearLayout>
diff --git a/res/layout/ridi_frontlight_settings.xml b/res/layout/ridi_frontlight_settings.xml
new file mode 100644
index 0000000000000000000000000000000000000000..655ead29c09409af305ff2975f10dce96073151d
--- /dev/null
+++ b/res/layout/ridi_frontlight_settings.xml
@@ -0,0 +1,54 @@
+<?xml version="1.0" encoding="utf-8"?>
+<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="@drawable/ridi_panel_background">
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="match_parent"
+        android:layout_margin="3dp"
+        android:orientation="vertical">
+
+        <TextView
+            android:id="@+id/frontlight_back"
+            android:layout_width="match_parent"
+            android:layout_height="@dimen/ridi_title_height"
+            android:background="@drawable/ridi_row_background"
+            android:drawableStart="@drawable/ridi_panel_back"
+            android:drawablePadding="7dp"
+            android:gravity="center_vertical"
+            android:paddingStart="5dp"
