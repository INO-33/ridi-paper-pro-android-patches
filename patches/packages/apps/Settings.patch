diff --git a/res/layout/ridi_wifi_preference.xml b/res/layout/ridi_wifi_preference.xml
new file mode 100644
index 0000000000000000000000000000000000000000..a113bb580b437fb97364ab1b791fe39fab25fc50
--- /dev/null
+++ b/res/layout/ridi_wifi_preference.xml
@@ -0,0 +1,62 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Stock PAPER-style row used by Android O's real Preference objects. -->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="68dp"
+    android:background="@drawable/ridi_wifi_row_background"
+    android:clipToPadding="false"
+    android:gravity="center_vertical"
+    android:orientation="horizontal"
+    android:paddingStart="18dp"
+    android:paddingEnd="18dp">
+
+    <FrameLayout
+        android:id="@+id/icon_frame"
+        android:layout_width="42dp"
+        android:layout_height="match_parent"
+        android:gravity="center">
+
+        <ImageView
+            android:id="@android:id/icon"
+            android:layout_width="36dp"
+            android:layout_height="30dp"
+            android:layout_gravity="center"
+            android:adjustViewBounds="true"
+            android:scaleType="centerInside" />
+    </FrameLayout>
+
+    <LinearLayout
+        android:layout_width="0dp"
+        android:layout_height="wrap_content"
+        android:layout_marginStart="14dp"
+        android:layout_weight="1"
+        android:orientation="vertical">
+
+        <TextView
+            android:id="@android:id/title"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:ellipsize="end"
+            android:includeFontPadding="false"
+            android:maxLines="1"
+            android:textColor="#ff000000"
+            android:textSize="17sp" />
+
+        <TextView
+            android:id="@android:id/summary"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:ellipsize="end"
+            android:includeFontPadding="false"
+            android:maxLines="2"
+            android:textColor="#ff666666"
+            android:textSize="13sp" />
+    </LinearLayout>
+
+    <LinearLayout
+        android:id="@android:id/widget_frame"
+        android:layout_width="wrap_content"
+        android:layout_height="match_parent"
+        android:gravity="center"
+        android:orientation="vertical" />
+</LinearLayout>
diff --git a/res/layout/ridi_wifi_preference_list_fragment.xml b/res/layout/ridi_wifi_preference_list_fragment.xml
new file mode 100644
index 0000000000000000000000000000000000000000..102734cf1b988a08279d89885a360018f347f716
--- /dev/null
+++ b/res/layout/ridi_wifi_preference_list_fragment.xml
@@ -0,0 +1,42 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- PreferenceFragment contract with the stock edge-to-edge white list geometry. -->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:id="@+id/container_material"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="#ffffffff"
+    android:orientation="vertical">
+
+    <FrameLayout
+        android:id="@+id/pinned_header"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:visibility="gone" />
+
+    <FrameLayout
+        android:id="@android:id/list_container"
+        android:layout_width="match_parent"
+        android:layout_height="0dp"
+        android:layout_weight="1">
+
+        <include layout="@layout/loading_container" />
+    </FrameLayout>
+
+    <TextView
+        android:id="@android:id/empty"
+        android:layout_width="match_parent"
+        android:layout_height="match_parent"
+        android:gravity="center"
+        android:padding="18dp"
+        android:textColor="#ff555555"
+        android:textSize="15sp"
+        android:visibility="gone" />
+
+    <include layout="@layout/admin_support_details_empty_view" />
+
+    <RelativeLayout
+        android:id="@+id/button_bar"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:visibility="gone" />
+</LinearLayout>
diff --git a/res/layout/ridi_wifi_settings.xml b/res/layout/ridi_wifi_settings.xml
new file mode 100644
index 0000000000000000000000000000000000000000..271bd625baffe8df67a621ffa319745d2df2fb4e
--- /dev/null
+++ b/res/layout/ridi_wifi_settings.xml
@@ -0,0 +1,110 @@
+<?xml version="1.0" encoding="utf-8"?>
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="#ffffffff"
+    android:orientation="vertical">
+
+    <TextView
+        android:id="@+id/wifi_back"
+        android:layout_width="match_parent"
+        android:layout_height="@dimen/ridi_title_height"
+        android:background="@drawable/ridi_row_background"
+        android:drawableStart="@drawable/ridi_panel_back"
+        android:drawablePadding="7dp"
+        android:gravity="center_vertical"
+        android:paddingStart="5dp"
+        android:text="Wi-Fi"
+        android:textColor="#ff000000"
+        android:textSize="18sp"
+        android:textStyle="bold" />
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="64dp"
+        android:background="@drawable/ridi_row_background"
+        android:gravity="center_vertical"
+        android:orientation="horizontal"
+        android:paddingStart="18dp"
+        android:paddingEnd="18dp">
+
+        <ImageView
+            android:layout_width="34dp"
+            android:layout_height="34dp"
+            android:contentDescription="@null"
+            android:src="@drawable/ridi_icon_wifi" />
+
+        <TextView
+            android:id="@+id/wifi_state"
+            android:layout_width="0dp"
+            android:layout_height="match_parent"
+            android:layout_marginStart="14dp"
+            android:layout_weight="1"
+            android:gravity="center_vertical"
+            android:text="Wi-Fi 상태 확인 중"
+            android:textColor="#ff000000"
+            android:textSize="17sp"
+            android:textStyle="bold" />
+
+        <CheckBox
+            android:id="@+id/wifi_toggle"
+            android:layout_width="71dp"
+            android:layout_height="30dp"
+            android:layout_marginStart="10dp"
+            android:background="@drawable/ridi_stock_onoff_button"
+            android:button="@null"
+            android:minHeight="0dp"
+            android:minWidth="0dp"
+            android:padding="0dp" />
+    </LinearLayout>
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="52dp"
+        android:background="@drawable/ridi_row_background"
+        android:gravity="center_vertical"
+        android:orientation="horizontal"
+        android:paddingStart="18dp"
+        android:paddingEnd="18dp">
+
+        <TextView
+            android:id="@+id/wifi_list_title"
+            android:layout_width="0dp"
+            android:layout_height="match_parent"
+            android:layout_weight="1"
+            android:gravity="center_vertical"
+            android:text="사용 가능한 네트워크"
+            android:textColor="#ff000000"
+            android:textSize="16sp" />
+
+        <TextView
+            android:id="@+id/wifi_refresh"
+            android:layout_width="92dp"
+            android:layout_height="40dp"
+            android:background="@drawable/ridi_brightness_button"
+            android:gravity="center"
+            android:text="새로고침"
+            android:textColor="#ff000000"
+            android:textSize="14sp" />
+    </LinearLayout>
+
+    <View
+        android:layout_width="match_parent"
+        android:layout_height="1dp"
+        android:background="#ff000000" />
+
+    <com.android.settings.ridi.RidiEinkListView
+        android:id="@+id/wifi_network_list"
+        android:layout_width="match_parent"
+        android:layout_height="0dp"
+        android:layout_weight="1"
+        android:animationCache="false"
+        android:cacheColorHint="#ffffffff"
+        android:divider="@drawable/ridi_row_divider"
+        android:dividerHeight="1dp"
+        android:listSelector="@android:color/transparent"
+        android:overScrollMode="never"
+        android:smoothScrollbar="false"
+        android:scrollbars="none"
+        android:scrollingCache="false" />
+</LinearLayout>
