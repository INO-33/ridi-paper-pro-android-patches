diff --git a/res/values/ridi_reader_styles.xml b/res/values/ridi_reader_styles.xml
new file mode 100644
index 0000000000000000000000000000000000000000..860611eec1db5257603780c343deced3da0c4a4e
--- /dev/null
+++ b/res/values/ridi_reader_styles.xml
@@ -0,0 +1,96 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <color name="ridi_reader_panel_window_background">#ffffffff</color>
+
+    <style name="Theme.Settings.RidiFrontlightPanel"
+        parent="@android:style/Theme.DeviceDefault.Light.Dialog.NoActionBar">
+        <item name="android:windowActionModeOverlay">true</item>
+        <item name="android:windowAnimationStyle">@null</item>
+        <item name="android:windowDisablePreview">true</item>
+        <item name="android:windowBackground">@color/ridi_reader_panel_window_background</item>
+        <item name="android:windowNoTitle">true</item>
+        <item name="android:windowIsFloating">true</item>
+        <item name="android:windowIsTranslucent">false</item>
+        <item name="android:backgroundDimEnabled">false</item>
+        <item name="android:windowElevation">0dp</item>
+        <item name="android:windowContentTransitions">false</item>
+        <item name="android:windowActivityTransitions">false</item>
+        <item name="android:colorAccent">#ff111111</item>
+    </style>
+
+    <!-- Android O Wi-Fi behaviour with the monochrome PAPER settings geometry. -->
+    <style name="Theme.Settings.RidiWifi" parent="Theme.Settings">
+        <item name="android:windowBackground">@color/ridi_reader_panel_window_background</item>
+        <item name="android:colorAccent">#ff111111</item>
+        <item name="android:colorControlActivated">#ff111111</item>
+        <item name="android:colorControlNormal">#ff111111</item>
+        <item name="android:navigationBarColor">#ffffffff</item>
+        <item name="android:statusBarColor">#ffffffff</item>
+        <item name="android:windowLightStatusBar">true</item>
+        <item name="android:actionBarStyle">@style/Theme.ActionBar.RidiWifi</item>
+        <item name="android:alertDialogTheme">@style/Theme.AlertDialog.RidiWifi</item>
+        <item name="preferenceTheme">@style/PreferenceTheme.RidiWifi</item>
+        <item name="switchBarTheme">@style/ThemeOverlay.SwitchBar.RidiWifi</item>
+    </style>
+
+    <style name="Theme.ActionBar.RidiWifi" parent="Theme.ActionBar.SubSettings">
+        <item name="android:background">#ffffffff</item>
+        <item name="android:elevation">0dp</item>
+        <item name="android:height">48dp</item>
+        <item name="android:titleTextStyle">@style/TextAppearance.RidiWifi.ActionBar</item>
+    </style>
+
+    <style name="TextAppearance.RidiWifi.ActionBar"
+        parent="@android:style/TextAppearance.Material.Widget.ActionBar.Title">
+        <item name="android:textColor">#ff000000</item>
+        <item name="android:textSize">18sp</item>
+        <item name="android:textStyle">bold</item>
+    </style>
+
+    <style name="ThemeOverlay.SwitchBar.RidiWifi"
+        parent="ThemeOverlay.SwitchBar.SubSettings">
+        <item name="switchBarBackgroundColor">#ffffffff</item>
+        <item name="switchBarMarginStart">0dp</item>
+        <item name="switchBarMarginEnd">18dp</item>
+        <item name="android:textColorPrimary">#ff000000</item>
+        <item name="android:colorControlActivated">#ff111111</item>
+    </style>
+
+    <style name="Theme.AlertDialog.RidiWifi" parent="Theme.AlertDialog">
+        <item name="android:windowBackground">@color/ridi_reader_panel_window_background</item>
+        <item name="android:colorAccent">#ff111111</item>
+        <item name="android:colorControlActivated">#ff111111</item>
+        <item name="android:textColorPrimary">#ff000000</item>
+        <item name="android:textColorSecondary">#ff333333</item>
+    </style>
+
+    <style name="PreferenceTheme.RidiWifi" parent="PreferenceTheme">
+        <item name="preferenceFragmentStyle">@style/PreferenceFragmentStyle.RidiWifi</item>
+        <item name="preferenceStyle">@style/Preference.RidiWifi</item>
+    </style>
+
+    <style name="PreferenceFragmentStyle.RidiWifi" parent="PreferenceFragmentStyle">
+        <item name="android:layout">@layout/ridi_wifi_preference_list_fragment</item>
+        <item name="android:divider">@null</item>
+        <item name="android:dividerHeight">0dp</item>
+        <item name="allowDividerAfterLastItem">false</item>
+    </style>
+
+    <style name="Preference.RidiWifi" parent="SettingsPreference">
+        <item name="android:layout">@layout/ridi_wifi_preference</item>
+        <item name="allowDividerAbove">false</item>
+        <item name="allowDividerBelow">false</item>
+        <item name="iconSpaceReserved">true</item>
+    </style>
+
+    <style name="RidiReaderTab">
+        <item name="android:layout_width">0dp</item>
+        <item name="android:layout_height">match_parent</item>
+        <item name="android:layout_weight">1</item>
+        <item name="android:background">#ffffffff</item>
+        <item name="android:gravity">center</item>
+        <item name="android:includeFontPadding">false</item>
+        <item name="android:textColor">#ff000000</item>
+        <item name="android:textSize">14sp</item>
+    </style>
+</resources>
