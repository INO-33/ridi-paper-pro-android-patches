+/*
+ * Copyright (C) 2026 E70Q10 Android port
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ */
+package com.android.settings.ridi;
+
+import android.content.ContentProvider;
+import android.content.ContentValues;
+import android.database.Cursor;
+import android.net.Uri;
+import android.os.Bundle;
+
+/**
+ * Narrow privileged bridge used by platform SystemUI.
+ *
+ * Settings runs as android.uid.system and is the only UI process allowed to
+ * write the LM3630A sysfs attributes. The provider is protected by the
+ * signature STATUS_BAR_SERVICE permission; arbitrary applications cannot use
+ * it as a frontlight control endpoint.
+ */
+public final class RidiFrontlightProvider extends ContentProvider {
+    public static final String METHOD_GET_STATE = "get_state";
+    public static final String METHOD_SET_BRIGHTNESS = "set_brightness";
+    public static final String METHOD_SET_COLOR = "set_color";
+
+    public static final String KEY_VALUE = "value";
+    public static final String KEY_SUCCESS = "success";
+    public static final String KEY_BRIGHTNESS = "brightness";
+    public static final String KEY_MAX_BRIGHTNESS = "max_brightness";
+    public static final String KEY_COLOR = "color";
+    public static final String KEY_MAX_COLOR = "max_color";
+
+    @Override
+    public boolean onCreate() {
+        return true;
+    }
+
+    @Override
+    public Bundle call(String method, String arg, Bundle extras) {
+        boolean success = true;
+        final int value = extras != null ? extras.getInt(KEY_VALUE) : 0;
+        if (METHOD_SET_BRIGHTNESS.equals(method)) {
+            success = RidiFrontlightController.setBrightness(
+                    getContext().getContentResolver(), value);
+        } else if (METHOD_SET_COLOR.equals(method)) {
+            success = RidiFrontlightController.setColor(
+                    getContext().getContentResolver(), value);
+        } else if (!METHOD_GET_STATE.equals(method)) {
+            throw new IllegalArgumentException("Unknown method: " + method);
+        }
+
+        final Bundle result = new Bundle();
+        result.putBoolean(KEY_SUCCESS, success);
+        result.putInt(KEY_BRIGHTNESS, RidiFrontlightController.getBrightness());
+        result.putInt(KEY_MAX_BRIGHTNESS, RidiFrontlightController.getMaxBrightness());
+        result.putInt(KEY_COLOR, RidiFrontlightController.getColor());
+        result.putInt(KEY_MAX_COLOR, RidiFrontlightController.getMaxColor());
+        return result;
+    }
+
+    @Override
+    public Cursor query(Uri uri, String[] projection, String selection,
+            String[] selectionArgs, String sortOrder) {
+        return null;
+    }
+
+    @Override
+    public String getType(Uri uri) {
+        return null;
+    }
+
+    @Override
+    public Uri insert(Uri uri, ContentValues values) {
+        throw new UnsupportedOperationException();
+    }
+
+    @Override
+    public int delete(Uri uri, String selection, String[] selectionArgs) {
+        throw new UnsupportedOperationException();
+    }
+
+    @Override
+    public int update(Uri uri, ContentValues values, String selection,
+            String[] selectionArgs) {
+        throw new UnsupportedOperationException();
+    }
+}
diff --git a/src/com/android/settings/ridi/RidiFrontlightSession.java b/src/com/android/settings/ridi/RidiFrontlightSession.java
new file mode 100644
index 0000000000000000000000000000000000000000..7f2bf3e19ea83706f7832e675fb33ed0f0d6d9fe
--- /dev/null
+++ b/src/com/android/settings/ridi/RidiFrontlightSession.java
@@ -0,0 +1,178 @@
+/* Copyright (C) 2026 E70Q10 Android port. Licensed under Apache License 2.0. */
+package com.android.settings.ridi;
+
+import java.util.concurrent.Executor;
+import java.util.concurrent.LinkedBlockingQueue;
+import java.util.concurrent.ThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+
+/** Serial device work for one popup; touch and drawing never wait for device I/O. */
+final class RidiFrontlightSession {
+    static final int BRIGHTNESS = 0;
+    static final int COLOR = 1;
+
+    static final class State {
+        final int brightness, maxBrightness, color, maxColor;
+
+        State(int brightness, int maxBrightness, int color, int maxColor) {
+            this.maxBrightness = Math.max(1, maxBrightness);
+            this.maxColor = Math.max(1, maxColor);
+            this.brightness = clamp(brightness, this.maxBrightness);
+            this.color = clamp(color, this.maxColor);
+        }
+    }
+
+    interface Backend {
+        State read();
+        void preview(int control, int level, State limits);
+        boolean commit(int control, int level, State limits);
+        /** Acquired before enqueueing a final save; release runs in finally. */
+        Runnable keepAwakeForCommit();
+    }
+
+    interface Listener {
+        void onLoaded(State state);
+        void onWriteFailed();
+    }
+
+    // Shared by popup instances so a closing popup cannot write after a new one.
+    // No polling: the sole worker exits after five idle seconds.
+    private static final Executor WORKER = new ThreadPoolExecutor(0, 1, 5,
+            TimeUnit.SECONDS, new LinkedBlockingQueue<>(),
+            task -> new Thread(task, "RidiFrontlight"));
+
+    private final Backend mBackend;
+    private final Executor mWorker;
+    private final Executor mCallbacks;
+    private Listener mListener;
+    private State mLimits;
+    private boolean mActive = true;
+    private int mBrightness, mColor, mRevision;
+    private boolean mBrightnessDirty, mColorDirty;
+    private Preview mPending;
+
+    RidiFrontlightSession(Backend backend, Executor callbacks, Listener listener) {
+        this(backend, WORKER, callbacks, listener);
+    }
+
+    RidiFrontlightSession(Backend backend, Executor worker, Executor callbacks,
+            Listener listener) {
+        mBackend = backend;
+        mWorker = worker;
+        mCallbacks = callbacks;
+        mListener = listener;
+    }
+
+    synchronized void load() {
+        final int revision = mRevision;
+        mWorker.execute(() -> {
+            final State state = mBackend.read();
+            mCallbacks.execute(() -> {
+                synchronized (RidiFrontlightSession.this) {
+                    if (!mActive || mRevision != revision) return;
+                    mLimits = state;
+                    mBrightness = state.brightness;
+                    mColor = state.color;
+                    mListener.onLoaded(state);
+                }
+            });
+        });
+    }
+
+    synchronized void preview(int control, int requested) {
+        if (!mActive || mLimits == null) return;
+        final int level = setTarget(control, requested);
+        if (control == BRIGHTNESS) mBrightnessDirty = true;
+        else mColorDirty = true;
+        ++mRevision;
+        if (mPending == null) {
+            mPending = new Preview();
+            mPending.set(control, level);
+            mWorker.execute(mPending);
+        } else {
+            mPending.set(control, level);
+        }
+    }
+
+    synchronized void commit(int control, int requested) {
+        if (!mActive || mLimits == null) return;
+        final int level = setTarget(control, requested);
+        ++mRevision;
+        // Seal the previous preview task. Later gestures get a new task AFTER
+        // this immutable commit, rather than modifying a task queued before it.
+        if (mPending != null) {
+            mPending.set(control, -1);
+            mPending = null;
+        }
+        if (control == BRIGHTNESS) mBrightnessDirty = false;
+        else mColorDirty = false;
+        enqueueCommit(control, level);
+    }
+
+    synchronized void close() {
+        if (!mActive) return;
+        mActive = false;
+        mListener = null;
+        mPending = null;
+        // Also save a gesture interrupted by screen-off/back without UP.
+        if (mBrightnessDirty) enqueueCommit(BRIGHTNESS, mBrightness);
+        if (mColorDirty) enqueueCommit(COLOR, mColor);
+    }
+
+    private void enqueueCommit(int control, int level) {
+        final State limits = mLimits;
+        final int revision = mRevision;
+        final Runnable release = mBackend.keepAwakeForCommit();
+        mWorker.execute(() -> {
+            boolean success;
+            try {
+                success = mBackend.commit(control, level, limits);
+            } finally {
+                release.run();
+            }
+            if (!success) mCallbacks.execute(() -> {
+                synchronized (RidiFrontlightSession.this) {
+                    if (mActive && mRevision == revision) mListener.onWriteFailed();
+                }
+            });
+        });
+    }
+
+    private int setTarget(int control, int requested) {
+        if (control == BRIGHTNESS) {
+            mBrightness = clamp(requested, mLimits.maxBrightness);
+            return mBrightness;
+        }
+        mColor = clamp(requested, mLimits.maxColor);
+        return mColor;
+    }
+
+    private static int clamp(int value, int max) {
+        return Math.max(0, Math.min(max, value));
+    }
+
+    private final class Preview implements Runnable {
+        private int brightness = -1, color = -1;
+
+        void set(int control, int level) {
+            if (control == BRIGHTNESS) brightness = level;
+            else color = level;
+        }
+
+        @Override
+        public void run() {
+            final int b, c;
+            final State limits;
+            synchronized (RidiFrontlightSession.this) {
+                if (!mActive) return;
+                if (mPending == this) mPending = null;
+                b = brightness;
+                c = color;
+                limits = mLimits;
+            }
+            // Never hold the session lock while doing sysfs/I2C work.
+            if (b >= 0) mBackend.preview(BRIGHTNESS, b, limits);
+            if (c >= 0) mBackend.preview(COLOR, c, limits);
+        }
+    }
+}
diff --git a/src/com/android/settings/ridi/RidiLevelBar.java b/src/com/android/settings/ridi/RidiLevelBar.java
new file mode 100644
index 0000000000000000000000000000000000000000..6251133ea0be555f98ab4c88f76304c25018f5b1
--- /dev/null
+++ b/src/com/android/settings/ridi/RidiLevelBar.java
@@ -0,0 +1,198 @@
+/*
+ * Copyright (C) 2026 E70Q10 Android port
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ */
+package com.android.settings.ridi;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.util.AttributeSet;
+import android.view.MotionEvent;
+import android.view.View;
+
+/**
+ * Vertical segmented level indicator that is also the control surface.
+ *
+ * The stock reader shows the frontlight level as a stack of segments and lets
+ * the user drag that stack directly, so no separate slider is needed. Segment
+ * changes are reported while dragging and the final value is reported once on
+ * release, which keeps the number of E Ink updates low.
+ */
+public final class RidiLevelBar extends View {
+    /** Reports level changes coming from touch. */
+    public interface OnLevelChangeListener {
+        /** Called for every segment change while the user drags. */
+        void onLevelChanging(RidiLevelBar bar, int level);
+
+        /** Called once when the user lifts the finger. */
+        void onLevelChanged(RidiLevelBar bar, int level);
+    }
+
+    /* Stock StackProgressBar attributes: cellsCount=20, cellHeight=8dp. */
+    private static final int SEGMENTS = 20;
+    private static final int COLOR_ON = 0xff000000;
+    private static final int COLOR_OFF = 0xffdddddd;
+
+    private final Paint mPaint = new Paint();
+    private final float mCellHeight;
+    private final float mOffInset;
+
+    private int mMax = 100;
+    private int mLevel;
+    private boolean mDragging;
+    private OnLevelChangeListener mListener;
+
+    public RidiLevelBar(Context context) {
+        this(context, null);
+    }
+
+    public RidiLevelBar(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        mPaint.setStyle(Paint.Style.FILL);
+        final float density = getResources().getDisplayMetrics().density;
+        mCellHeight = 8f * density;
+        mOffInset = 2f * density;
+        setClickable(true);
+        setFocusable(true);
+    }
+
+    public void setOnLevelChangeListener(OnLevelChangeListener listener) {
+        mListener = listener;
+    }
+
+    public void setMax(int max) {
+        final int safeMax = Math.max(1, max);
+        if (safeMax == mMax) {
+            return;
+        }
+        mMax = safeMax;
+        setLevelInternal(mLevel, false);
+    }
+
+    public int getMax() {
+        return mMax;
+    }
+
+    public int getLevel() {
+        return mLevel;
+    }
+
+    /** Applies a level that did not come from touch. */
+    public void setLevel(int level) {
+        setLevelInternal(level, false);
+    }
+
+    private void setLevelInternal(int level, boolean fromUser) {
+        final int clamped = Math.max(0, Math.min(mMax, level));
+        if (clamped == mLevel) {
+            return;
+        }
+        mLevel = clamped;
+        RidiEinkRefresh.invalidate(this);
+        if (fromUser && mListener != null) {
+            mListener.onLevelChanging(this, mLevel);
+        }
+    }
+
+    @Override
+    public boolean onTouchEvent(MotionEvent event) {
+        if (!isEnabled()) {
+            return false;
+        }
+        switch (event.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                mDragging = true;
+                getParent().requestDisallowInterceptTouchEvent(true);
+                setLevelInternal(levelForY(event.getY()), true);
+                return true;
+            case MotionEvent.ACTION_MOVE:
+                if (mDragging) {
+                    setLevelInternal(levelForY(event.getY()), true);
+                }
+                return true;
+            case MotionEvent.ACTION_UP:
+                if (mDragging) {
+                    mDragging = false;
+                    setLevelInternal(levelForY(event.getY()), true);
+                    if (mListener != null) {
+                        mListener.onLevelChanged(this, mLevel);
+                    }
+                }
+                return true;
+            case MotionEvent.ACTION_CANCEL:
+                if (mDragging) {
+                    mDragging = false;
+                    /*
+                     * A live hardware preview may already be active. Commit
+                     * the current level so hardware and persisted state cannot
+                     * diverge when the gesture is cancelled by the window.
+                     */
+                    if (mListener != null) {
+                        mListener.onLevelChanged(this, mLevel);
+                    }
+                }
+                return true;
+            default:
+                return super.onTouchEvent(event);
+        }
+    }
+
+    /** Top of the view is the maximum level, matching the stock stack. */
+    private int levelForY(float y) {
+        final int usable = getHeight() - getPaddingTop() - getPaddingBottom();
+        if (usable <= 0) {
+            return mLevel;
+        }
+        final float offset = y - getPaddingTop();
+        final float fraction = 1f - (offset / usable);
+        final float clamped = Math.max(0f, Math.min(1f, fraction));
+        return Math.round(clamped * mMax);
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        final int width = getWidth() - getPaddingLeft() - getPaddingRight();
+        final int height = getHeight() - getPaddingTop() - getPaddingBottom();
+        if (width <= 0 || height <= 0) {
+            return;
+        }
+        /*
+         * The stock widget keeps every active cell 8dp high and distributes
+         * the remaining height between its 20 cells. Inactive cells are only
+         * 4dp high (2dp inset at the top and bottom), which is what gives the
+         * gauge its alternating fine/coarse rhythm.
+         */
+        final float cellHeight = Math.min(mCellHeight, height / (float) SEGMENTS);
+        final float gap = SEGMENTS > 1
+                ? Math.max(0f, (height - cellHeight * SEGMENTS) / (SEGMENTS - 1))
+                : 0f;
+        final float filled = SEGMENTS * mLevel / (float) mMax;
+        final float fillBoundary = SEGMENTS - filled;
+        final float left = getPaddingLeft();
+        final float right = left + width;
+        for (int i = 0; i < SEGMENTS; i++) {
+            final float top = getPaddingTop() + i * (cellHeight + gap);
+            final float bottom = top + cellHeight;
+            if (i + 1 <= fillBoundary) {
+                drawOffCell(canvas, left, right, top, bottom);
+            } else if (i < fillBoundary) {
+                final float activeTop = top + (fillBoundary - i) * cellHeight;
+                drawOffCell(canvas, left, right, top, activeTop);
+                mPaint.setColor(COLOR_ON);
+                canvas.drawRect(left, activeTop, right, bottom, mPaint);
+            } else {
+                mPaint.setColor(COLOR_ON);
+                canvas.drawRect(left, top, right, bottom, mPaint);
+            }
+        }
+    }
+
+    private void drawOffCell(Canvas canvas, float left, float right,
+            float top, float bottom) {
+        mPaint.setColor(COLOR_OFF);
+        final float inset = Math.min(mOffInset, Math.max(0f, (bottom - top) / 2f));
+        canvas.drawRect(left, top + inset, right, bottom - inset, mPaint);
+    }
+}
