@@ -0,0 +1,123 @@
+/*
+ * Copyright (C) 2026 E70Q10 Android port
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ */
+package com.android.settings.ridi;
+
+import android.content.ContentResolver;
+import android.os.SystemProperties;
+import android.provider.Settings;
+
+import java.io.File;
+
+/**
+ * Settings-side mirror of SystemUI's reader screensaver keys.
+ *
+ * Keep these in sync with
+ * {@code com.android.systemui.ridi.ReaderScreensaverSettings}.
+ */
+final class RidiScreensaverSettings {
+    static final String ENABLED = "ridi_screensaver_enabled";
+    static final String STYLE = "ridi_screensaver_style";
+    static final String SHOW_BATTERY = "ridi_screensaver_show_battery";
+    static final String IMAGE_PATH = "ridi_screensaver_image";
+    static final String STOCK_IMAGE_PATH = "sleepscreen_file_path";
+
+    static final int STYLE_BASIC = 0;
+    static final int STYLE_USER = 2;
+
+    static final int DEFAULT_STYLE = STYLE_BASIC;
+
+    private RidiScreensaverSettings() {}
+
+    static int getRawStyle(ContentResolver resolver) {
+        return Settings.System.getInt(resolver, STYLE, DEFAULT_STYLE);
+    }
+
+    static boolean isEnabled(ContentResolver resolver) {
+        return Settings.System.getInt(resolver, ENABLED, 1) != 0;
+    }
+
+    static void setEnabled(ContentResolver resolver, boolean enabled) {
+        Settings.System.putInt(resolver, ENABLED, enabled ? 1 : 0);
+    }
+
+    static int getStyle(ContentResolver resolver) {
+        final int style = getRawStyle(resolver);
+        if (style != STYLE_BASIC && style != STYLE_USER) {
+            Settings.System.putInt(resolver, STYLE, DEFAULT_STYLE);
+            return DEFAULT_STYLE;
+        }
+        return style;
+    }
+
+    static String getImagePath(ContentResolver resolver) {
+        String path = Settings.System.getString(resolver, IMAGE_PATH);
+        if (path == null || path.isEmpty()) {
+            path = Settings.System.getString(resolver, STOCK_IMAGE_PATH);
+        }
+        return (path == null || path.isEmpty()) ? null : path;
+    }
+
+    /**
+     * Returns only an image explicitly stored in the user Sleepingscreen
+     * folder. The stock compatibility key can also contain a bundled system
+     * image; that must not leak back into the user-only picker or preview.
+     */
+    static String getUserImagePath(ContentResolver resolver) {
+        String path = Settings.System.getString(resolver, IMAGE_PATH);
+        if (path == null || path.isEmpty()) {
+            path = Settings.System.getString(resolver, STOCK_IMAGE_PATH);
+        }
+        if (path == null || path.isEmpty()) {
+            return null;
+        }
+        final File image = new File(path);
+        final File parent = image.getParentFile();
+        return image.isFile() && parent != null
+                && "Sleepingscreen".equalsIgnoreCase(parent.getName())
+                ? image.getAbsolutePath() : null;
+    }
+
+    static void setImagePath(ContentResolver resolver, String path) {
+        Settings.System.putString(resolver, IMAGE_PATH, path);
+        Settings.System.putString(resolver, STOCK_IMAGE_PATH, path);
+    }
+
+    /** Short label for the chosen file, for the settings row. */
+    static String imageLabel(ContentResolver resolver) {
+        final String path = getImagePath(resolver);
+        if (path == null) {
+            return "선택된 이미지 없음";
+        }
+        final int slash = path.lastIndexOf('/');
+        return slash >= 0 ? path.substring(slash + 1) : path;
+    }
+
+    static void setStyle(ContentResolver resolver, int style) {
+        final int safeStyle = (style != STYLE_BASIC && style != STYLE_USER)
+                ? DEFAULT_STYLE : style;
+        Settings.System.putInt(resolver, STYLE, safeStyle);
+        /* Keep compatibility with the stock 4.4.2 RIDI app and suspend code. */
+        try {
+            SystemProperties.set("persist.sys.standbytype",
+                    Integer.toString(safeStyle));
+        } catch (RuntimeException ignored) {
+            // The Settings.System value remains authoritative on emulator builds.
+        }
+    }
+
+    static boolean showBattery(ContentResolver resolver) {
+        return Settings.System.getInt(resolver, SHOW_BATTERY, 1) != 0;
+    }
+
+    static void setShowBattery(ContentResolver resolver, boolean show) {
+        Settings.System.putInt(resolver, SHOW_BATTERY, show ? 1 : 0);
+    }
+
+    static String styleLabel(ContentResolver resolver) {
+        final int style = getStyle(resolver);
+        return style == STYLE_USER ? "사용자 슬립 화면" : "기본 슬립 화면";
+    }
+}
