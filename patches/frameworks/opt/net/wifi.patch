diff --git a/libwifi_hal/wifi_hal_rtl8189fs.cpp b/libwifi_hal/wifi_hal_rtl8189fs.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..26eefbf0e8f4c8148d3ab2717f2501fe59d69c29
--- /dev/null
+++ b/libwifi_hal/wifi_hal_rtl8189fs.cpp
@@ -0,0 +1,118 @@
+/*
+ * Minimal Android O legacy vendor HAL for cfg80211-only RTL8189FS devices.
+ *
+ * The Realtek driver and wpa_supplicant implement scanning and association
+ * through nl80211.  Android's HIDL Wi-Fi service still requires a legacy
+ * vendor HAL to provide a valid global handle and enumerate wlan0, even when
+ * none of the optional vendor commands (GScan, RTT, logger, etc.) exist.
+ */
+
+#include <pthread.h>
+#include <net/if.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "hardware_legacy/wifi_hal.h"
+
+struct wifi_interface_info {
+  char name[IFNAMSIZ];
+};
+
+struct wifi_info {
+  pthread_mutex_t lock;
+  pthread_cond_t stopped_cond;
+  bool stopped;
+  wifi_cleaned_up_handler cleaned_up_handler;
+  wifi_interface_info interface;
+  wifi_interface_handle interface_handle;
+};
+
+static wifi_error rtl_wifi_initialize(wifi_handle* handle) {
+  if (handle == nullptr) {
+    return WIFI_ERROR_INVALID_ARGS;
+  }
+
+  wifi_info* info = static_cast<wifi_info*>(calloc(1, sizeof(*info)));
+  if (info == nullptr) {
+    return WIFI_ERROR_OUT_OF_MEMORY;
+  }
+
+  pthread_mutex_init(&info->lock, nullptr);
+  pthread_cond_init(&info->stopped_cond, nullptr);
+  strlcpy(info->interface.name, "wlan0", sizeof(info->interface.name));
+  info->interface_handle = &info->interface;
+  *handle = info;
+  return WIFI_SUCCESS;
+}
+
+static void rtl_wifi_cleanup(wifi_handle handle,
+                             wifi_cleaned_up_handler handler) {
+  if (handle == nullptr) {
+    return;
+  }
+
+  pthread_mutex_lock(&handle->lock);
+  handle->cleaned_up_handler = handler;
+  handle->stopped = true;
+  pthread_cond_signal(&handle->stopped_cond);
+  pthread_mutex_unlock(&handle->lock);
+}
+
+static void rtl_wifi_event_loop(wifi_handle handle) {
+  if (handle == nullptr) {
+    return;
+  }
+
+  pthread_mutex_lock(&handle->lock);
+  while (!handle->stopped) {
+    pthread_cond_wait(&handle->stopped_cond, &handle->lock);
+  }
+  wifi_cleaned_up_handler handler = handle->cleaned_up_handler;
+  pthread_mutex_unlock(&handle->lock);
+
+  if (handler != nullptr) {
+    handler(handle);
+  }
+}
+
+static wifi_error rtl_wifi_get_ifaces(wifi_handle handle, int* num_ifaces,
+                                      wifi_interface_handle** ifaces) {
+  if (handle == nullptr || num_ifaces == nullptr || ifaces == nullptr) {
+    return WIFI_ERROR_INVALID_ARGS;
+  }
+  *num_ifaces = 1;
+  *ifaces = &handle->interface_handle;
+  return WIFI_SUCCESS;
+}
+
+static wifi_error rtl_wifi_get_iface_name(wifi_interface_handle iface,
+                                          char* name, size_t size) {
+  if (iface == nullptr || name == nullptr || size == 0) {
+    return WIFI_ERROR_INVALID_ARGS;
+  }
+  strlcpy(name, iface->name, size);
+  return WIFI_SUCCESS;
+}
+
+static wifi_error rtl_wifi_get_supported_feature_set(
+    wifi_interface_handle iface, feature_set* set) {
+  if (iface == nullptr || set == nullptr) {
+    return WIFI_ERROR_INVALID_ARGS;
+  }
+  *set = WIFI_FEATURE_INFRA;
+  return WIFI_SUCCESS;
+}
+
+wifi_error init_wifi_vendor_hal_func_table(wifi_hal_fn* fn) {
+  if (fn == nullptr) {
+    return WIFI_ERROR_INVALID_ARGS;
+  }
+
+  fn->wifi_initialize = rtl_wifi_initialize;
+  fn->wifi_cleanup = rtl_wifi_cleanup;
+  fn->wifi_event_loop = rtl_wifi_event_loop;
+  fn->wifi_get_ifaces = rtl_wifi_get_ifaces;
+  fn->wifi_get_iface_name = rtl_wifi_get_iface_name;
+  fn->wifi_get_supported_feature_set = rtl_wifi_get_supported_feature_set;
+  return WIFI_SUCCESS;
+}
