@@ -113,6 +113,10 @@ public class HalDeviceManager {
      * Returns whether the vendor HAL is supported on this device or not.
      */
     public boolean isSupported() {
+        // WifiService can be constructed while hwservicemanager is still
+        // starting. Retry the service-manager acquisition instead of treating
+        // that one boot-time race as permanent lack of a vendor Wi-Fi HAL.
+        initIServiceManagerIfNecessary();
         return isSupportedInternal();
     }
 
diff --git a/service/java/com/android/server/wifi/WifiNative.java b/service/java/com/android/server/wifi/WifiNative.java
