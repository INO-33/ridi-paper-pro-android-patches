--- a/service/java/com/android/server/wifi/WifiNative.java
+++ b/service/java/com/android/server/wifi/WifiNative.java
@@ -280,6 +280,13 @@ public class WifiNative {
      * @param turnOnVerbose Whether to turn on verbose logging or not.
      */
     public void setSupplicantLogLevel(boolean turnOnVerbose) {
+        // The init service may be running before its HIDL registration
+        // callback has supplied ISupplicant. Applying debug parameters in
+        // that window only produces a false failure; SupplicantStartingState
+        // applies the requested level again after SUP_CONNECTION_EVENT.
+        if (!mSupplicantStaIfaceHal.isInitializationComplete()) {
+            return;
+        }
         mSupplicantStaIfaceHal.setLogLevel(turnOnVerbose);
     }
 
