new file mode 100644
index 0000000000000000000000000000000000000000..4ac9558c0cecf11a0de87e9a3a4395ba50ff6114
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/ridi/ReaderNotificationPanelActivity.java
@@ -0,0 +1,234 @@
+/*
+ * Copyright (C) 2026 E70Q10 Android port
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ */
+package com.android.systemui.ridi;
+
+import android.app.Activity;
+import android.app.Notification;
+import android.app.PendingIntent;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.graphics.drawable.Drawable;
+import android.os.Bundle;
+import android.service.notification.StatusBarNotification;
+import android.text.TextUtils;
+import android.util.DisplayMetrics;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.Window;
+import android.view.WindowManager;
+import android.widget.BaseAdapter;
+import android.widget.Button;
+import android.widget.ImageView;
+import android.widget.ListView;
+import android.widget.TextView;
+
+import com.android.systemui.R;
+import com.android.systemui.SystemUIApplication;
+import com.android.systemui.statusbar.phone.StatusBar;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Static E Ink notification popup.
+ *
+ * Notification RemoteViews are intentionally not inflated here. They may
+ * contain animated drawables, progress indicators and translucent content.
+ * The reader panel displays only a stable icon/title/text snapshot.
+ */
+public class ReaderNotificationPanelActivity extends Activity {
+    private final ArrayList<StatusBarNotification> mNotifications = new ArrayList<>();
+
+    private StatusBar mStatusBar;
+    private NotificationAdapter mAdapter;
+    private ListView mList;
+    private TextView mEmpty;
+    private Button mClear;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        requestWindowFeature(Window.FEATURE_NO_TITLE);
+        getWindow().setWindowAnimations(0);
+        getWindow().setDimAmount(0f);
+        getWindow().clearFlags(WindowManager.LayoutParams.FLAG_DIM_BEHIND);
+        setContentView(R.layout.ridi_reader_notification_panel);
+        getWindow().getDecorView().setElevation(0f);
+
+        final SystemUIApplication application = (SystemUIApplication) getApplication();
+        mStatusBar = application.getComponent(StatusBar.class);
+        mList = findViewById(R.id.ridi_notification_list);
+        mEmpty = findViewById(R.id.ridi_notification_empty);
+        mClear = findViewById(R.id.ridi_notification_clear);
+        mAdapter = new NotificationAdapter();
+        mList.setAdapter(mAdapter);
+
+        findViewById(R.id.ridi_notification_close).setOnClickListener(v -> finish());
+        mList.setOnItemClickListener((parent, view, position, id) ->
+                openNotification(mNotifications.get(position)));
+        mClear.setOnClickListener(v -> clearNotifications());
+    }
+
+    @Override
+    protected void onStart() {
+        super.onStart();
+        final DisplayMetrics metrics = new DisplayMetrics();
+        getWindowManager().getDefaultDisplay().getMetrics(metrics);
+        final int stockPanelWidth = (int) (510f * metrics.density + 0.5f);
+        getWindow().setLayout(Math.min((int) (metrics.widthPixels * 0.94f), stockPanelWidth),
+                WindowManager.LayoutParams.WRAP_CONTENT);
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        overridePendingTransition(0, 0);
+        reloadNotifications();
+    }
+
+    @Override
+    public void finish() {
+        super.finish();
+        overridePendingTransition(0, 0);
+    }
+
+    private void reloadNotifications() {
+        mNotifications.clear();
+        if (mStatusBar != null) {
+            final List<StatusBarNotification> active =
+                    mStatusBar.getReaderActiveNotifications();
+            if (active != null) {
+                mNotifications.addAll(active);
+            }
+        }
+        mAdapter.notifyDataSetChanged();
+        final boolean empty = mNotifications.isEmpty();
+        mList.setVisibility(empty ? View.GONE : View.VISIBLE);
+        mEmpty.setVisibility(empty ? View.VISIBLE : View.GONE);
+        mClear.setEnabled(hasClearableNotification());
+    }
+
+    private void clearNotifications() {
+        if (mStatusBar != null) {
+            mStatusBar.clearAllReaderNotifications();
+        }
+        for (int i = mNotifications.size() - 1; i >= 0; i--) {
+            if (mNotifications.get(i).isClearable()) {
+                mNotifications.remove(i);
+            }
+        }
+        mAdapter.notifyDataSetChanged();
+        final boolean empty = mNotifications.isEmpty();
+        mList.setVisibility(empty ? View.GONE : View.VISIBLE);
+        mEmpty.setVisibility(empty ? View.VISIBLE : View.GONE);
+        mClear.setEnabled(false);
+    }
+
+    private boolean hasClearableNotification() {
+        for (int i = 0; i < mNotifications.size(); i++) {
+            if (mNotifications.get(i).isClearable()) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private void openNotification(StatusBarNotification sbn) {
+        final PendingIntent intent = sbn.getNotification().contentIntent;
+        if (intent == null) {
+            return;
+        }
+        try {
+            intent.send();
+            finish();
+        } catch (PendingIntent.CanceledException ignored) {
+        }
+    }
+
+    private CharSequence packageLabel(String packageName) {
+        final PackageManager pm = getPackageManager();
+        try {
+            final ApplicationInfo info = pm.getApplicationInfo(packageName, 0);
+            return pm.getApplicationLabel(info);
+        } catch (PackageManager.NameNotFoundException ignored) {
+            return packageName;
+        }
+    }
+
+    private final class NotificationAdapter extends BaseAdapter {
+        private final LayoutInflater mInflater = LayoutInflater.from(
+                ReaderNotificationPanelActivity.this);
+
+        @Override
+        public int getCount() {
+            return mNotifications.size();
+        }
+
+        @Override
+        public StatusBarNotification getItem(int position) {
+            return mNotifications.get(position);
+        }
+
+        @Override
+        public long getItemId(int position) {
+            return position;
+        }
+
+        @Override
+        public View getView(int position, View convertView, ViewGroup parent) {
+            final RowHolder holder;
+            if (convertView == null) {
+                convertView = mInflater.inflate(
+                        R.layout.ridi_reader_notification_row, parent, false);
+                holder = new RowHolder(convertView);
+                convertView.setTag(holder);
+            } else {
+                holder = (RowHolder) convertView.getTag();
+            }
+
+            final StatusBarNotification sbn = getItem(position);
+            final Notification notification = sbn.getNotification();
+            final Bundle extras = notification.extras != null
+                    ? notification.extras : Bundle.EMPTY;
+            CharSequence title = extras.getCharSequence(Notification.EXTRA_TITLE);
+            CharSequence text = extras.getCharSequence(Notification.EXTRA_TEXT);
+            if (TextUtils.isEmpty(title)) {
+                title = packageLabel(sbn.getPackageName());
+            }
+            if (TextUtils.isEmpty(text)) {
+                text = extras.getCharSequence(Notification.EXTRA_SUB_TEXT);
+            }
+            holder.title.setText(title);
+            holder.text.setText(text);
+            holder.text.setVisibility(TextUtils.isEmpty(text) ? View.GONE : View.VISIBLE);
+
+            Drawable icon = null;
+            if (notification.getSmallIcon() != null) {
+                try {
+                    icon = notification.getSmallIcon().loadDrawable(
+                            ReaderNotificationPanelActivity.this);
+                } catch (RuntimeException ignored) {
+                }
+            }
+            holder.icon.setImageDrawable(icon);
+            holder.icon.setVisibility(icon == null ? View.INVISIBLE : View.VISIBLE);
+            return convertView;
+        }
+    }
+
+    private static final class RowHolder {
+        final ImageView icon;
+        final TextView title;
+        final TextView text;
+
+        RowHolder(View view) {
+            icon = view.findViewById(R.id.ridi_notification_icon);
+            title = view.findViewById(R.id.ridi_notification_title);
+            text = view.findViewById(R.id.ridi_notification_text);
+        }
+    }
+}
diff --git a/packages/SystemUI/src/com/android/systemui/ridi/ReaderQuickPanelActivity.java b/packages/SystemUI/src/com/android/systemui/ridi/ReaderQuickPanelActivity.java
