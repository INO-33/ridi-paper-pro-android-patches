@@ -0,0 +1,296 @@
+/*
+ * Copyright (C) 2026 E70Q10 Android port
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ */
+package com.android.systemui.ridi;
+
+import android.app.Activity;
+import android.content.BroadcastReceiver;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.net.ConnectivityManager;
+import android.net.NetworkInfo;
+import android.net.wifi.WifiManager;
+import android.os.Bundle;
+import android.provider.Settings;
+import android.util.DisplayMetrics;
+import android.view.View;
+import android.view.Window;
+import android.view.WindowManager;
+import android.widget.ImageView;
+import android.widget.SeekBar;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import com.android.systemui.R;
+
+/**
+ * Opaque, fixed quick panel for E Ink.
+ *
+ * This intentionally does not reuse the draggable QS shade: there are no
+ * flings, expansion animations, translucent scrims, paged tiles or ripples.
+ */
+public class ReaderQuickPanelActivity extends Activity {
+    private static final int BRIGHTNESS_STEP = 5;
+
+    private WifiManager mWifi;
+    private final BroadcastReceiver mWifiStateReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            updateWifiState();
+        }
+    };
+    private View mWifiButton;
+    private TextView mWifiLabel;
+    private ImageView mWifiIcon;
+    private SeekBar mBrightnessBar;
+    private TextView mBrightnessValue;
+    private SeekBar mColorBar;
+    private TextView mColorValue;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        requestWindowFeature(Window.FEATURE_NO_TITLE);
+        getWindow().setWindowAnimations(0);
+        getWindow().setDimAmount(0f);
+        getWindow().clearFlags(WindowManager.LayoutParams.FLAG_DIM_BEHIND);
+        setContentView(R.layout.ridi_reader_quick_panel);
+        getWindow().getDecorView().setElevation(0f);
+
+        mWifi = (WifiManager) getApplicationContext().getSystemService(Context.WIFI_SERVICE);
+        mWifiButton = findViewById(R.id.ridi_quick_wifi);
+        mWifiLabel = findViewById(R.id.ridi_quick_wifi_label);
+        mWifiIcon = findViewById(R.id.ridi_quick_wifi_icon);
+        mBrightnessBar = findViewById(R.id.ridi_brightness_level);
+        mBrightnessValue = findViewById(R.id.ridi_brightness_value);
+        mColorBar = findViewById(R.id.ridi_color_level);
+        mColorValue = findViewById(R.id.ridi_color_value);
+
+        findViewById(R.id.ridi_quick_close).setOnClickListener(v -> finish());
+        findViewById(R.id.ridi_quick_running_apps).setOnClickListener(v -> {
+            startActivity(new Intent(this, ReaderRunningAppsActivity.class)
+                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TOP
+                            | Intent.FLAG_ACTIVITY_NO_ANIMATION));
+            finish();
+        });
+        mWifiButton.setOnClickListener(v -> toggleWifi());
+        mWifiButton.setOnLongClickListener(v -> {
+            // Settings owns its task; it must never remain underneath this panel.
+            startActivity(new Intent(Settings.ACTION_WIFI_SETTINGS)
+                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TOP
+                            | Intent.FLAG_ACTIVITY_NO_ANIMATION));
+            finish();
+            return true;
+        });
+        findViewById(R.id.ridi_quick_notifications).setOnClickListener(v ->
+                openNotifications());
+        findViewById(R.id.ridi_brightness_down).setOnClickListener(v ->
+                changeBrightness(-BRIGHTNESS_STEP));
+        findViewById(R.id.ridi_brightness_up).setOnClickListener(v ->
+                changeBrightness(BRIGHTNESS_STEP));
+        findViewById(R.id.ridi_color_down).setOnClickListener(v -> changeColor(-1));
+        findViewById(R.id.ridi_color_up).setOnClickListener(v -> changeColor(1));
+        findViewById(R.id.ridi_open_settings).setOnClickListener(v -> openSettings());
+        findViewById(R.id.ridi_power).setOnClickListener(v -> confirmShutdown());
+        bindSliders();
+        updateState();
+    }
+
+    @Override
+    protected void onStart() {
+        super.onStart();
+        final IntentFilter wifiFilter = new IntentFilter(WifiManager.WIFI_STATE_CHANGED_ACTION);
+        wifiFilter.addAction(WifiManager.NETWORK_STATE_CHANGED_ACTION);
+        registerReceiver(mWifiStateReceiver, wifiFilter);
+        updateWifiState();
+        final DisplayMetrics metrics = new DisplayMetrics();
+        getWindowManager().getDefaultDisplay().getMetrics(metrics);
+        final int stockPanelWidth = (int) (510f * metrics.density + 0.5f);
+        getWindow().setLayout(Math.min((int) (metrics.widthPixels * 0.94f), stockPanelWidth),
+                WindowManager.LayoutParams.WRAP_CONTENT);
+    }
+
+    @Override
+    protected void onStop() {
+        unregisterReceiver(mWifiStateReceiver);
+        super.onStop();
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        overridePendingTransition(0, 0);
+        updateState();
+    }
+
+    @Override
+    public void finish() {
+        super.finish();
+        overridePendingTransition(0, 0);
+    }
+
+    private void toggleWifi() {
+        if (mWifi == null) {
+            return;
+        }
+        final boolean enable = !mWifi.isWifiEnabled();
+        final boolean accepted = mWifi.setWifiEnabled(enable);
+        mWifiLabel.setText(accepted
+                ? (enable ? "Wi-Fi 켜는 중" : "Wi-Fi 끄는 중")
+                : "Wi-Fi 전환 실패");
+    }
+
+    private void changeBrightness(int delta) {
+        final ReaderFrontlightController.State current =
+                ReaderFrontlightController.state(this);
+        final ReaderFrontlightController.State result =
+                ReaderFrontlightController.setBrightness(
+                        this, current.brightness + delta);
+        if (!result.success) {
+            showFrontlightError();
+        }
+        applyFrontlightState(result);
+    }
+
+    private void changeColor(int delta) {
+        final ReaderFrontlightController.State current =
+                ReaderFrontlightController.state(this);
+        final ReaderFrontlightController.State result =
+                ReaderFrontlightController.setColor(this, current.color + delta);
+        if (!result.success) {
+            showFrontlightError();
+        }
+        applyFrontlightState(result);
+    }
+
+    private void bindSliders() {
+        mBrightnessBar.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener() {
+            @Override
+            public void onProgressChanged(SeekBar seekBar, int progress, boolean fromUser) {
+                mBrightnessValue.setText(progress + " / " + seekBar.getMax());
+            }
+
+            @Override
+            public void onStartTrackingTouch(SeekBar seekBar) {}
+
+            @Override
+            public void onStopTrackingTouch(SeekBar seekBar) {
+                final ReaderFrontlightController.State result =
+                        ReaderFrontlightController.setBrightness(
+                                ReaderQuickPanelActivity.this, seekBar.getProgress());
+                if (!result.success) {
+                    showFrontlightError();
+                }
+                applyFrontlightState(result);
+            }
+        });
+        mColorBar.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener() {
+            @Override
+            public void onProgressChanged(SeekBar seekBar, int progress, boolean fromUser) {
+                mColorValue.setText(progress + " / " + seekBar.getMax());
+            }
+
+            @Override
+            public void onStartTrackingTouch(SeekBar seekBar) {}
+
+            @Override
+            public void onStopTrackingTouch(SeekBar seekBar) {
+                final ReaderFrontlightController.State result =
+                        ReaderFrontlightController.setColor(
+                                ReaderQuickPanelActivity.this, seekBar.getProgress());
+                if (!result.success) {
+                    showFrontlightError();
+                }
+                applyFrontlightState(result);
+            }
+        });
+    }
+
+    private void updateState() {
+        if (mBrightnessBar == null) {
+            return;
+        }
+        applyFrontlightState(ReaderFrontlightController.state(this));
+
+        updateWifiState();
+    }
+
+    private void updateWifiState() {
+        if (mWifi == null || mWifiLabel == null) {
+            return;
+        }
+        final int wifiState = mWifi.getWifiState();
+        final boolean enabled = wifiState == WifiManager.WIFI_STATE_ENABLED
+                || wifiState == WifiManager.WIFI_STATE_DISABLING;
+        final ConnectivityManager connectivity =
+                (ConnectivityManager) getSystemService(Context.CONNECTIVITY_SERVICE);
+        final NetworkInfo wifiNetwork = connectivity != null
+                ? connectivity.getNetworkInfo(ConnectivityManager.TYPE_WIFI) : null;
+        final boolean connected = enabled && wifiNetwork != null && wifiNetwork.isConnected();
+        mWifiIcon.clearColorFilter();
+        mWifiIcon.setImageResource(!enabled
+                ? R.drawable.main_actionbar_btn_wifi_off
+                : (connected ? R.drawable.main_actionbar_btn_wifi_4
+                        : R.drawable.main_actionbar_btn_wifi_no_network));
+        switch (wifiState) {
+            case WifiManager.WIFI_STATE_ENABLED:
+                mWifiLabel.setText("Wi-Fi 켜짐");
+                break;
+            case WifiManager.WIFI_STATE_ENABLING:
+                mWifiLabel.setText("Wi-Fi 켜는 중");
+                break;
+            case WifiManager.WIFI_STATE_DISABLING:
+                mWifiLabel.setText("Wi-Fi 끄는 중");
+                break;
+            case WifiManager.WIFI_STATE_DISABLED:
+                mWifiLabel.setText("Wi-Fi 꺼짐");
+                break;
+            default:
+                mWifiLabel.setText("Wi-Fi 상태 확인 중");
+                break;
+        }
+    }
+
+    private void applyFrontlightState(ReaderFrontlightController.State state) {
+        mBrightnessBar.setMax(state.maxBrightness);
+        mBrightnessBar.setProgress(state.brightness);
+        mBrightnessValue.setText(state.brightness + " / " + state.maxBrightness);
+
+        mColorBar.setMax(state.maxColor);
+        mColorBar.setProgress(state.color);
+        mColorValue.setText(state.color + " / " + state.maxColor);
+    }
+
+    private void openSettings() {
+        final Intent intent = new Intent();
+        intent.setComponent(new ComponentName("com.android.settings",
+                "com.android.settings.ridi.RidiReaderSettingsActivity"));
+        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TOP);
+        startActivity(intent);
+        finish();
+    }
+
+    private void openNotifications() {
+        startActivity(new Intent(this, ReaderNotificationPanelActivity.class)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TOP
+                        | Intent.FLAG_ACTIVITY_NO_ANIMATION));
+        finish();
+    }
+
+    private void confirmShutdown() {
+        // Use the same system confirmation as the long-press power action.
+        final Intent intent = new Intent(Intent.ACTION_REQUEST_SHUTDOWN);
+        intent.putExtra(Intent.EXTRA_KEY_CONFIRM, true);
+        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+        startActivity(intent);
+    }
+
+    private void showFrontlightError() {
+        Toast.makeText(this, "프론트라이트 장치에 쓸 수 없습니다.",
+                Toast.LENGTH_SHORT).show();
+    }
+}
diff --git a/packages/SystemUI/src/com/android/systemui/ridi/ReaderRunningAppsActivity.java b/packages/SystemUI/src/com/android/systemui/ridi/ReaderRunningAppsActivity.java
new file mode 100644
index 0000000000000000000000000000000000000000..aa8a80565f13ab839a5ab84b8f10344e67825045
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/ridi/ReaderRunningAppsActivity.java
@@ -0,0 +1,280 @@
+package com.android.systemui.ridi;
+
+import android.app.Activity;
+import android.app.ActivityManager;
+import android.app.ActivityManager.RunningAppProcessInfo;
+import android.content.Intent;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.content.pm.ResolveInfo;
+import android.graphics.drawable.Drawable;
+import android.os.Bundle;
+import android.os.Process;
+import android.os.UserHandle;
+import android.util.DisplayMetrics;
+import android.util.Log;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.Window;
+import android.view.WindowManager;
+import android.widget.BaseAdapter;
+import android.widget.ImageView;
+import android.widget.ListView;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import com.android.systemui.R;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/** Static app-process list, with one explicit package stop action per row. */
+public class ReaderRunningAppsActivity extends Activity {
+    private static final String TAG = "ReaderRunningApps";
+    private final ArrayList<AppEntry> mApps = new ArrayList<>();
+    private final ExecutorService mWorker = Executors.newSingleThreadExecutor();
+    private ActivityManager mActivityManager;
+    private AppAdapter mAdapter;
+    private ListView mList;
+    private TextView mEmpty;
+    private View mClear;
+    private int mGeneration;
+    private boolean mResumed;
+    private boolean mStopping;
+
+    @Override
+    protected void onCreate(Bundle state) {
+        super.onCreate(state);
+        requestWindowFeature(Window.FEATURE_NO_TITLE);
+        getWindow().setWindowAnimations(0);
+        getWindow().setDimAmount(0f);
+        getWindow().clearFlags(WindowManager.LayoutParams.FLAG_DIM_BEHIND);
+        setContentView(R.layout.ridi_reader_running_apps);
+        getWindow().getDecorView().setElevation(0f);
+        mActivityManager = getSystemService(ActivityManager.class);
+        mList = findViewById(R.id.ridi_running_apps_list);
+        mEmpty = findViewById(R.id.ridi_running_apps_empty);
+        mClear = findViewById(R.id.ridi_running_apps_clear);
+        mClear.setEnabled(false);
+        mClear.setOnClickListener(v -> stopApps(new ArrayList<>(mApps)));
+        mAdapter = new AppAdapter();
+        mList.setAdapter(mAdapter);
+        findViewById(R.id.ridi_running_apps_close).setOnClickListener(v -> finish());
+    }
+
+    @Override
+    protected void onStart() {
+        super.onStart();
+        final DisplayMetrics metrics = new DisplayMetrics();
+        getWindowManager().getDefaultDisplay().getMetrics(metrics);
+        getWindow().setLayout(Math.min((int) (metrics.widthPixels * 0.94f),
+                (int) (510f * metrics.density + 0.5f)),
+                WindowManager.LayoutParams.WRAP_CONTENT);
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        overridePendingTransition(0, 0);
+        mResumed = true;
+        reloadApps();
+    }
+
+    @Override
+    protected void onPause() {
+        mResumed = false;
+        ++mGeneration;
+        super.onPause();
+    }
+
+    @Override
+    protected void onDestroy() {
+        ++mGeneration;
+        mWorker.shutdown();
+        super.onDestroy();
+    }
+
+    @Override
+    public void finish() {
+        super.finish();
+        overridePendingTransition(0, 0);
+    }
+
+    private void reloadApps() {
+        final int generation = ++mGeneration;
+        mClear.setEnabled(false);
+        final int user = ActivityManager.getCurrentUser();
+        if (mApps.isEmpty()) {
+            mList.setVisibility(View.GONE);
+            mEmpty.setText(R.string.ridi_running_apps_loading);
+            mEmpty.setVisibility(View.VISIBLE);
+        }
+        mWorker.execute(() -> {
+            List<AppEntry> entries = new ArrayList<>();
+            boolean failed = false;
+            try {
+                entries = collectApps(user);
+            } catch (RuntimeException e) {
+                Log.w(TAG, "Unable to load app processes", e);
+                failed = true;
+            }
+            final List<AppEntry> result = entries;
+            final boolean error = failed;
+            runOnUiThread(() -> {
+                if (!mResumed || generation != mGeneration || isDestroyed()) return;
+                mApps.clear();
+                mApps.addAll(result);
+                mAdapter.notifyDataSetChanged();
+                mClear.setEnabled(!mStopping && !result.isEmpty());
+                mList.setVisibility(result.isEmpty() ? View.GONE : View.VISIBLE);
+                mEmpty.setText(error ? R.string.ridi_running_apps_error
+                        : R.string.ridi_running_apps_empty);
+                mEmpty.setVisibility(result.isEmpty() ? View.VISIBLE : View.GONE);
+            });
+        });
+    }
+
+    private List<AppEntry> collectApps(int user) {
+        final PackageManager pm = getPackageManager();
+        final Intent launcher = new Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER);
+        final Set<String> launchable = new HashSet<>();
+        for (ResolveInfo item : pm.queryIntentActivitiesAsUser(launcher, 0, user)) {
+            launchable.add(item.activityInfo.packageName);
+        }
+        final Set<Integer> protectedUids = new HashSet<>();
+        protectedUids.add(Process.myUid());
+        final ResolveInfo home = pm.resolveActivityAsUser(
+                new Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_HOME),
+                PackageManager.MATCH_DEFAULT_ONLY, user);
+        if (home != null && home.activityInfo != null) {
+            protectedUids.add(home.activityInfo.applicationInfo.uid);
+        }
+        final List<RunningAppProcessInfo> processes = mActivityManager.getRunningAppProcesses();
+        final Map<String, Integer> importance = new HashMap<>();
+        if (processes == null) return new ArrayList<>();
+        // Protect every package sharing a persistent process or the home/SystemUI UID.
+        for (RunningAppProcessInfo process : processes) {
+            if ((process.flags & RunningAppProcessInfo.FLAG_PERSISTENT) != 0) {
+                protectedUids.add(process.uid);
+            }
+        }
+        for (RunningAppProcessInfo process : processes) {
+            if (UserHandle.getUserId(process.uid) != user
+                    || UserHandle.getAppId(process.uid) < Process.FIRST_APPLICATION_UID
+                    || protectedUids.contains(process.uid) || process.pkgList == null) continue;
+            for (String pkg : process.pkgList) {
+                Integer previous = importance.get(pkg);
+                if (previous == null || process.importance < previous) {
+                    importance.put(pkg, process.importance);
+                }
+            }
+        }
+        final List<AppEntry> entries = new ArrayList<>();
+        for (Map.Entry<String, Integer> process : importance.entrySet()) {
+            try {
+                ApplicationInfo info = pm.getApplicationInfoAsUser(process.getKey(), 0, user);
+                // User-installed background apps are included even without a launcher icon.
+                // System daemons without an app entry are not user stop targets.
+                if ((info.flags & ApplicationInfo.FLAG_SYSTEM) != 0
+                        && !launchable.contains(info.packageName)) continue;
+                if ((info.flags & ApplicationInfo.FLAG_PERSISTENT) != 0
+                        || protectedUids.contains(info.uid)
+                        || UserHandle.getAppId(info.uid) < Process.FIRST_APPLICATION_UID) continue;
+                entries.add(new AppEntry(info.packageName, info.loadLabel(pm).toString(),
+                        info.loadIcon(pm), process.getValue(), user));
+            } catch (PackageManager.NameNotFoundException ignored) {
+                // The app may have been removed while the snapshot was collected.
+            }
+        }
+        Collections.sort(entries, (a, b) -> {
+            int byState = Integer.compare(a.importance, b.importance);
+            return byState != 0 ? byState : a.label.compareToIgnoreCase(b.label);
+        });
+        return entries;
+    }
+
+    private void stopApp(AppEntry app) {
+        stopApps(Collections.singletonList(app));
+    }
+
+    private void stopApps(List<AppEntry> targets) {
+        if (mStopping || targets.isEmpty()) return;
+        mStopping = true;
+        mClear.setEnabled(false);
+        ++mGeneration; // Discard any in-flight snapshot from before the stop.
+        mAdapter.notifyDataSetChanged();
+        mWorker.execute(() -> {
+            boolean failed = false;
+            for (AppEntry app : targets) {
+                try {
+                    mActivityManager.forceStopPackageAsUser(app.packageName, app.user);
+                } catch (RuntimeException e) {
+                    // Continue stopping the remaining apps if one stop fails.
+                    Log.w(TAG, "Unable to stop " + app.packageName, e);
+                    failed = true;
+                }
+            }
+            final boolean error = failed;
+            runOnUiThread(() -> {
+                mStopping = false;
+                if (!mResumed || isDestroyed()) return;
+                if (error) Toast.makeText(this, R.string.ridi_running_apps_stop_error,
+                        Toast.LENGTH_SHORT).show();
+                reloadApps();
+            });
+        });
+    }
+
+    private static final class AppEntry {
+        final String packageName;
+        final String label;
+        final Drawable icon;
+        final int importance;
+        final int user;
+
+        AppEntry(String packageName, String label, Drawable icon, int importance, int user) {
+            this.packageName = packageName;
+            this.label = label;
+            this.icon = icon;
+            this.importance = importance;
+            this.user = user;
+        }
+
+        String state() {
+            if (importance <= RunningAppProcessInfo.IMPORTANCE_FOREGROUND) return "사용 중";
+            if (importance <= RunningAppProcessInfo.IMPORTANCE_VISIBLE) return "화면에 표시 중";
+            if (importance >= RunningAppProcessInfo.IMPORTANCE_CACHED) return "캐시됨";
+            return "백그라운드 실행 중";
+        }
+    }
+
+    private final class AppAdapter extends BaseAdapter {
+        @Override public int getCount() { return mApps.size(); }
+        @Override public AppEntry getItem(int position) { return mApps.get(position); }
+        @Override public long getItemId(int position) { return position; }
+        @Override
+        public View getView(int position, View view, ViewGroup parent) {
+            if (view == null) {
+                view = LayoutInflater.from(ReaderRunningAppsActivity.this).inflate(
+                        R.layout.ridi_reader_running_app_row, parent, false);
+            }
+            final AppEntry app = getItem(position);
+            ((ImageView) view.findViewById(R.id.ridi_running_app_icon)).setImageDrawable(app.icon);
+            ((TextView) view.findViewById(R.id.ridi_running_app_title)).setText(app.label);
+            ((TextView) view.findViewById(R.id.ridi_running_app_state)).setText(app.state());
+            View stop = view.findViewById(R.id.ridi_running_app_stop);
+            stop.setContentDescription(getString(R.string.ridi_running_app_stop, app.label));
+            stop.setEnabled(!mStopping);
+            stop.setOnClickListener(v -> stopApp(app));
+            return view;
+        }
+    }
+}
diff --git a/packages/SystemUI/src/com/android/systemui/ridi/ReaderScreensaverController.java b/packages/SystemUI/src/com/android/systemui/ridi/ReaderScreensaverController.java
