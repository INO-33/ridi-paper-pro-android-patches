diff --git a/packages/SystemUI/res/layout/ridi_nav_frontlight.xml b/packages/SystemUI/res/layout/ridi_nav_frontlight.xml
new file mode 100644
index 0000000000000000000000000000000000000000..9b25d7996712dbfce4fa4719de401079f67a8e99
--- /dev/null
+++ b/packages/SystemUI/res/layout/ridi_nav_frontlight.xml
@@ -0,0 +1,24 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     Navigation bar key that opens the frontlight popup.
+
+     Uses the stock RIDI 4.4.2 frontlight artwork so it matches the rest of the
+     reader UI. keyCode stays 0 because this key runs an action instead of
+     injecting a key event; NavigationBarFragment attaches the click listener.
+-->
+<com.android.systemui.statusbar.policy.KeyButtonView
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:systemui="http://schemas.android.com/apk/res-auto"
+    android:id="@+id/ridi_frontlight"
+    android:layout_width="@dimen/navigation_key_width"
+    android:layout_height="match_parent"
+    android:layout_weight="0"
+    android:scaleType="center"
+    android:contentDescription="@string/ridi_quick_frontlight"
+    android:src="@drawable/ridi_icon_frontlight"
+    android:paddingTop="13dp"
+    android:paddingBottom="13dp"
+    android:paddingStart="@dimen/navigation_key_padding"
+    android:paddingEnd="@dimen/navigation_key_padding"
+    systemui:playSound="false"
+    />
diff --git a/packages/SystemUI/res/layout/ridi_nav_refresh.xml b/packages/SystemUI/res/layout/ridi_nav_refresh.xml
