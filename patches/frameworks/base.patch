+package com.android.systemui.ridi;
+
+import android.content.ContentResolver;
+import android.content.Context;
+import android.database.ContentObserver;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.graphics.PixelFormat;
+import android.graphics.Rect;
+import android.os.Handler;
+import android.os.HandlerThread;
+import android.os.Looper;
+import android.os.MemoryFile;
+import android.os.Process;
+import android.os.SystemClock;
+import android.os.SystemProperties;
+import android.os.Trace;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.util.DisplayMetrics;
+import android.util.Log;
+import android.view.LayoutInflater;
+import android.view.SurfaceControl;
+import android.view.View;
+import android.view.ViewTreeObserver;
+import android.view.WindowManager;
+import android.widget.ImageView;
+import android.widget.TextView;
+
+import com.android.systemui.R;
+
+import java.io.File;
+import java.io.IOException;
+
+/**
+ * Draws the suspend image once, just before the display is powered down.
+ *
+ * An E Ink panel is bistable: the last frame stays on the glass with no power
+ * and no further drawing. The kernel flushes pending EPDC updates before
+ * FB_BLANK_POWERDOWN, so a frame submitted here is guaranteed to reach the
+ * panel. The update uses GC16 NOWAIT; the screen-off barrier waits only until
+ * MXCFB_SEND_UPDATE succeeds, then kernel blank flushes the pending waveform.
+ *
+ * Decoded images use a one-shot panel overlay with no Android window. A plain
+ * opaque window remains only as the unreadable-image/failure fallback.
+ */
+public class ReaderScreensaverController {
+    private static final String TAG = "ReaderScreensaver";
+    public static final String WINDOW_TITLE_PREFIX = "ReaderScreensaver#";
+    private static final String FULL_REFRESH_SEQUENCE = "sys.ridi.epd.full_refresh_seq";
+
+    private final Context mContext;
+    private final WindowManager mWindowManager;
+    private final Handler mMainHandler = new Handler(Looper.getMainLooper());
+    private final HandlerThread mImagePreloadThread =
+            new HandlerThread("ReaderSleepImagePreload", Process.THREAD_PRIORITY_BACKGROUND);
+    private final Object mImageCacheLock = new Object();
+
+    private View mView;
+    private int mSequence = initialSequence();
+    private Handler mImagePreloadHandler;
+    private int mImageCacheGeneration;
+    private CachedImage mCachedImage;
+    private boolean mSleepScreenPresented;
+
+    /** One decoded image and the metadata required by the later overlay CP. */
+    private static final class CachedImage {
+        final String path;
+        final long lastModified;
+        final long fileLength;
+        final MemoryFile overlayMemory;
+        final int overlayWidth;
+        final int overlayHeight;
+        final int overlayStride;
+        final int overlayLeft;
+        final int overlayTop;
+        final Rect alphaBounds;
+        final boolean hasTransparency;
+
+        CachedImage(String path, long lastModified, long fileLength,
+                MemoryFile overlayMemory, int overlayWidth, int overlayHeight,
+                int overlayStride, int overlayLeft, int overlayTop, Rect alphaBounds,
+                boolean hasTransparency) {
+            this.path = path;
+            this.lastModified = lastModified;
+            this.fileLength = fileLength;
+            this.overlayMemory = overlayMemory;
+            this.overlayWidth = overlayWidth;
+            this.overlayHeight = overlayHeight;
+            this.overlayStride = overlayStride;
+            this.overlayLeft = overlayLeft;
+            this.overlayTop = overlayTop;
+            this.alphaBounds = alphaBounds;
+            this.hasTransparency = hasTransparency;
+        }
+    }
+
+    private static int initialSequence() {
+        int value = (int) ((SystemClock.uptimeMillis() ^ Process.myPid())
+                & View.EINK_SLEEP_SEQUENCE_MAX);
+        return value == 0 ? 1 : value;
+    }
+
+    private int nextSequence() {
+        mSequence = (mSequence % View.EINK_SLEEP_SEQUENCE_MAX) + 1;
+        return mSequence;
+    }
+
+    public ReaderScreensaverController(Context context) {
+        mContext = context;
+        mWindowManager = context.getSystemService(WindowManager.class);
+        mImagePreloadThread.start();
+        mImagePreloadHandler = new Handler(mImagePreloadThread.getLooper());
+        registerImageCacheObservers();
+        scheduleImagePreload("SystemUI init");
+    }
+
+    /** Called while the screen is still powered, as sleep begins. */
+    public void onStartedGoingToSleep() {
+        final long start = SystemClock.elapsedRealtime();
+        Trace.beginSection("RIDI_SLEEP_show_request");
+        Log.i(TAG, "SLEEP show request t=" + start);
+        mSleepScreenPresented = false;
+        final ContentResolver resolver = mContext.getContentResolver();
+        if (!ReaderScreensaverSettings.isEnabled(resolver)) {
+            Log.i(TAG, "Suspend image disabled");
+            Trace.endSection();
+            return;
+        }
+        final int style = ReaderScreensaverSettings.getStyle(resolver);
+        final CachedImage cached = obtainImageForSuspend(
+                imagePathForStyle(style, resolver));
+        if (cached != null && submitImageOverlay(cached)) {
+            Trace.endSection();
+            return;
+        }
+        show(style);
+        Trace.endSection();
+    }
+
+    /** Arm one panel refresh before the fallback is removed or live UI redraws. */
+    public void onStartedWakingUp() {
+        requestWakePanelRefresh("wake start");
+        removeFallbackWindow("wake start");
+    }
+
+    /** Backstop for unusual wake paths that skip the wakefulness callback. */
+    public void onScreenTurnedOn(View refreshTarget) {
+        requestWakePanelRefresh("screen turned on backstop");
+        removeFallbackWindow("screen turned on backstop");
+    }
+
+    private void requestWakePanelRefresh(String phase) {
+        if (!mSleepScreenPresented) {
+            return;
+        }
+        mSleepScreenPresented = false;
+        // The next live SurfaceFlinger frame consumes this sequence as one
+        // panel-wide GC16. A separate View.invalidate(GC16) would submit a
+        // second cleanup and can expose an intermediate wake frame.
+        final int next = SystemProperties.getInt(FULL_REFRESH_SEQUENCE, 0) + 1;
+        SystemProperties.set(FULL_REFRESH_SEQUENCE,
+                Integer.toString(next <= 0 ? 1 : next));
+        Log.i(TAG, "WAKE panel full refresh armed at " + phase + " t="
+                + SystemClock.elapsedRealtime());
+    }
+
+    private void removeFallbackWindow(String phase) {
+        if (mView == null) {
+            return;
+        }
+        final long now = SystemClock.elapsedRealtime();
+        Trace.beginSection("RIDI_SLEEP_remove_fallback_window");
+        Log.i(TAG, "WAKE remove fallback at " + phase + " t=" + now);
+        try {
+            final ImageView image = mView.findViewById(R.id.screensaver_image);
+            if (image != null) {
+                image.setImageDrawable(null);
+            }
+            mWindowManager.removeViewImmediate(mView);
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Could not remove the suspend image", e);
+        }
+        mView = null;
+        Trace.endSection();
+    }
+
+    private boolean submitImageOverlay(CachedImage image) {
+        synchronized (mImageCacheLock) {
+            if (image.overlayMemory == null) {
+                return false;
+            }
+            final int sequence = nextSequence();
+            try {
+                final long start = SystemClock.elapsedRealtime();
+                final int result = SurfaceControl.submitEinkSleepOverlay(
+                        image.overlayMemory.getFileDescriptor(), image.overlayWidth,
+                        image.overlayHeight, image.overlayStride,
+                        image.alphaBounds.left, image.alphaBounds.top,
+                        image.alphaBounds.right, image.alphaBounds.bottom,
+                        image.overlayLeft, image.overlayTop, sequence);
+                if (result == 0) {
+                    mSleepScreenPresented = true;
+                    Log.i(TAG, "SLEEP image overlay submitted seq=" + sequence
+                            + " alphaBounds=" + image.alphaBounds + " dst="
+                            + image.overlayLeft + "," + image.overlayTop + " size="
+                            + image.overlayWidth + "x" + image.overlayHeight
+                            + " after=" + (SystemClock.elapsedRealtime() - start) + "ms");
+                    return true;
+                }
+                Log.w(TAG, "Sleep image overlay failed result=" + result
+                        + "; use fallback window");
+            } catch (IOException | RuntimeException e) {
+                Log.w(TAG, "Could not submit sleep image overlay; use fallback", e);
+            }
+            return false;
+        }
+    }
+
+    private void show(int style) {
+        if (mView != null) {
+            return;
+        }
+        final int sequence = nextSequence();
+        final View view = LayoutInflater.from(mContext)
+                .inflate(R.layout.ridi_screensaver, null);
+        bind(view);
+        // Apply GC16 and the generation before attach. ViewRootImpl merges an
+        // explicit root policy into the first draw, avoiding a second frame.
+        view.setDefaultUpdateMode(ReaderEinkRefresh.sleepScreenMode(sequence));
+        traceFirstTraversal(view, sequence);
+
+        final WindowManager.LayoutParams lp = new WindowManager.LayoutParams(
+                WindowManager.LayoutParams.MATCH_PARENT,
+                WindowManager.LayoutParams.MATCH_PARENT,
+                // SYSTEM_OVERLAY (layer 22) is below navigation (layer 23).
+                // The sleep fallback must cover all system bars; FULLSCREEN
+                // also gives secure overlays the entire physical display frame.
+                WindowManager.LayoutParams.TYPE_SECURE_SYSTEM_OVERLAY,
+                WindowManager.LayoutParams.FLAG_FULLSCREEN
+                        | WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE
+                        | WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
+                        | WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN
+                        | WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
+                PixelFormat.OPAQUE);
+        lp.setTitle(WINDOW_TITLE_PREFIX + sequence);
+        // A dim or animation layer would be baked into the retained image.
+        lp.dimAmount = 0f;
+        lp.windowAnimations = 0;
+
+        try {
+            mWindowManager.addView(view, lp);
+            Log.i(TAG, "SLEEP addView complete seq=" + sequence
+                    + " t=" + SystemClock.elapsedRealtime());
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Could not show the suspend image", e);
+            final ImageView image = view.findViewById(R.id.screensaver_image);
+            if (image != null) {
+                image.setImageDrawable(null);
+            }
+            return;
+        }
+        mView = view;
+        mSleepScreenPresented = true;
+        Log.i(TAG, "Suspend window queued seq=" + sequence + " style=" + style);
+    }
+
+    private void traceFirstTraversal(View view, int sequence) {
+        final ViewTreeObserver observer = view.getViewTreeObserver();
+        observer.addOnGlobalLayoutListener(new ViewTreeObserver.OnGlobalLayoutListener() {
+            @Override
+            public void onGlobalLayout() {
+                if (view.getViewTreeObserver().isAlive()) {
+                    view.getViewTreeObserver().removeOnGlobalLayoutListener(this);
+                }
+                Log.i(TAG, "SLEEP first layout seq=" + sequence + " bounds="
+                        + view.getWidth() + "x" + view.getHeight() + " t="
+                        + SystemClock.elapsedRealtime());
+            }
+        });
+        observer.addOnPreDrawListener(new ViewTreeObserver.OnPreDrawListener() {
+            @Override
+            public boolean onPreDraw() {
+                if (view.getViewTreeObserver().isAlive()) {
+                    view.getViewTreeObserver().removeOnPreDrawListener(this);
+                }
+                Trace.traceBegin(Trace.TRACE_TAG_VIEW,
+                        "RIDI_SLEEP_first_pre_draw_" + sequence);
+                Trace.traceEnd(Trace.TRACE_TAG_VIEW);
+                Log.i(TAG, "SLEEP first pre-draw seq=" + sequence + " t="
+                        + SystemClock.elapsedRealtime());
+                return true;
+            }
+        });
+        observer.addOnDrawListener(new ViewTreeObserver.OnDrawListener() {
+            private boolean mLogged;
+
+            @Override
+            public void onDraw() {
+                if (mLogged) return;
+                mLogged = true;
+                Trace.traceBegin(Trace.TRACE_TAG_VIEW,
+                        "RIDI_SLEEP_first_draw_" + sequence);
+                Trace.traceEnd(Trace.TRACE_TAG_VIEW);
+                Log.i(TAG, "SLEEP first draw seq=" + sequence + " t="
+                        + SystemClock.elapsedRealtime());
+                // Removing an OnDrawListener during dispatch is illegal.
+                view.post(() -> {
+                    if (view.getViewTreeObserver().isAlive()) {
+                        view.getViewTreeObserver().removeOnDrawListener(this);
+                    }
+                });
+            }
+        });
+    }
+
+    private void bind(View view) {
+        final TextView clock = view.findViewById(R.id.screensaver_clock);
+        final TextView date = view.findViewById(R.id.screensaver_date);
+        final TextView battery = view.findViewById(R.id.screensaver_battery);
+        final TextView notice = view.findViewById(R.id.screensaver_notice);
+        final ImageView image = view.findViewById(R.id.screensaver_image);
+
+        /*
+         * A user image that cannot be read must not leave the panel blank for
+         * the whole sleep period, so an unreadable or missing file falls back to
+         * the clock.
+         */
+        // Only the missing-image/direct-submit-failure fallback reaches this
+        // window. All decoded images use the same one-shot native path.
+        final boolean showingImage = false;
+        image.setVisibility(View.GONE);
+
+        final boolean wantClock = false;
+        final boolean wantBattery = false;
+
+        clock.setVisibility(wantClock ? View.VISIBLE : View.GONE);
+        date.setVisibility(wantClock ? View.VISIBLE : View.GONE);
+        notice.setVisibility(wantClock || showingImage ? View.GONE : View.VISIBLE);
+        battery.setVisibility(wantBattery ? View.VISIBLE : View.GONE);
+
+    }
+
+    /** Resolves the same image sources used by the stock 4.4.2 standby service. */
+    private String imagePathForStyle(int style, ContentResolver resolver) {
+        switch (style) {
+            case ReaderScreensaverSettings.STYLE_USER:
+                return ReaderScreensaverSettings.getImagePath(resolver);
+            case ReaderScreensaverSettings.STYLE_BASIC:
+            default:
+                return "/system/usr/sleep/suspend.jpg";
+        }
+    }
+
+    /**
+     * Decodes the user's image at no more than panel resolution.
+     *
+     * The board has 1 GB of RAM and is configured as a low-RAM device, and a
+     * photograph straight off a camera would otherwise be decoded at full size
+     * for a 1404x1872 panel. ARGB_8888 is intentional: PNG alpha and
+     * premultiplication metadata must survive for the later panel-overlay CP.
+     *
+     * @return the bitmap, or null when the path is unset, gone or not an image
+     */
+    private CachedImage decodeImage(String path) {
+        if (path == null) {
+            return null;
+        }
+        final File file = new File(path);
+        if (!file.isFile() || !file.canRead()) {
+            Log.w(TAG, "Suspend image is not readable: " + path);
+            return null;
+        }
+
+        final DisplayMetrics metrics = getPhysicalPanelMetrics();
+        final BitmapFactory.Options bounds = new BitmapFactory.Options();
+        bounds.inJustDecodeBounds = true;
+        BitmapFactory.decodeFile(path, bounds);
+        if (bounds.outWidth <= 0 || bounds.outHeight <= 0) {
+            Log.w(TAG, "Suspend image could not be decoded: " + path);
+            return null;
+        }
+
+        int sample = 1;
+        while (bounds.outWidth / (sample * 2) >= metrics.widthPixels
+                && bounds.outHeight / (sample * 2) >= metrics.heightPixels) {
+            sample *= 2;
+        }
+
+        final BitmapFactory.Options options = new BitmapFactory.Options();
+        options.inSampleSize = sample;
+        // Preserve PNG alpha for the transparent one-shot overlay checkpoint.
+        options.inPreferredConfig = Bitmap.Config.ARGB_8888;
+        try {
+            final long start = SystemClock.elapsedRealtime();
+            final Bitmap bitmap = BitmapFactory.decodeFile(path, options);
+            if (bitmap == null) {
+                Log.w(TAG, "Suspend image decode returned null: " + path);
+                return null;
+            }
+            final int decodedWidth = bitmap.getWidth();
+            final int decodedHeight = bitmap.getHeight();
+            final boolean sourcePremultiplied = bitmap.isPremultiplied();
+            final CachedImage image = buildCachedImage(file, bitmap);
+            if (image == null) {
+                recycleBitmapLocked(bitmap);
+                return null;
+            }
+            Log.i(TAG, "Sleep image decoded path=" + path
+                    + " size=" + decodedWidth + "x" + decodedHeight
+                    + " alphaBounds=" + image.alphaBounds
+                    + " transparent=" + image.hasTransparency
+                    + " sourcePremultiplied=" + sourcePremultiplied
+                    + " after=" + (SystemClock.elapsedRealtime() - start) + "ms");
+            return image;
+        } catch (OutOfMemoryError e) {
+            Log.w(TAG, "Not enough memory for the suspend image", e);
+            return null;
+        }
+    }
+
+    private CachedImage buildCachedImage(File file, Bitmap bitmap) {
+        final int width = bitmap.getWidth();
+        final int height = bitmap.getHeight();
+        final int[] row = new int[width];
+        int minX = width;
+        int minY = height;
+        int maxX = -1;
+        int maxY = -1;
+        boolean hasTransparency = false;
+
+        for (int y = 0; y < height; y++) {
+            bitmap.getPixels(row, 0, width, 0, y, width, 1);
+            for (int x = 0; x < width; x++) {
+                final int alpha = row[x] >>> 24;
+                if (alpha != 255) {
+                    hasTransparency = true;
+                }
+                if (alpha != 0) {
+                    minX = Math.min(minX, x);
+                    minY = Math.min(minY, y);
+                    maxX = Math.max(maxX, x);
+                    maxY = Math.max(maxY, y);
+                }
+            }
+        }
+
+        final Rect alphaBounds = maxX < minX || maxY < minY
+                ? new Rect() : new Rect(minX, minY, maxX + 1, maxY + 1);
+        return buildOverlayCache(file, bitmap, hasTransparency);
+    }
+
+    /** Normalizes one image once; suspend only passes this cache to native code. */
+    private CachedImage buildOverlayCache(File file, Bitmap decoded,
+            boolean hasTransparency) {
+        final DisplayMetrics metrics = getPhysicalPanelMetrics();
+        final float scale = Math.min((float) metrics.widthPixels / decoded.getWidth(),
+                (float) metrics.heightPixels / decoded.getHeight());
+        final int width = Math.max(1, Math.round(decoded.getWidth() * scale));
+        final int height = Math.max(1, Math.round(decoded.getHeight() * scale));
+        Bitmap scaled = decoded;
+        MemoryFile memory = null;
+        try {
+            if (width != decoded.getWidth() || height != decoded.getHeight()) {
+                scaled = Bitmap.createScaledBitmap(decoded, width, height, true);
+            }
+            final int stride = Math.multiplyExact(width, 4);
+            final int byteCount = Math.multiplyExact(stride, height);
+            memory = new MemoryFile("ridi-sleep-overlay", byteCount);
+            memory.allowPurging(false);
+
+            final int[] pixels = new int[width];
+            final byte[] bytes = new byte[stride];
+            int minX = width;
+            int minY = height;
+            int maxX = -1;
+            int maxY = -1;
+            for (int y = 0; y < height; y++) {
+                scaled.getPixels(pixels, 0, width, 0, y, width, 1);
+                for (int x = 0; x < width; x++) {
+                    final int color = pixels[x];
+                    final int alpha = color >>> 24;
+                    final int offset = x * 4;
+                    // Explicit straight ARGB byte layout; native never depends on Skia layout.
+                    bytes[offset] = (byte) alpha;
+                    bytes[offset + 1] = (byte) (color >>> 16);
+                    bytes[offset + 2] = (byte) (color >>> 8);
+                    bytes[offset + 3] = (byte) color;
+                    if (alpha != 0) {
+                        minX = Math.min(minX, x);
+                        minY = Math.min(minY, y);
+                        maxX = Math.max(maxX, x);
+                        maxY = Math.max(maxY, y);
+                    }
+                }
+                memory.writeBytes(bytes, 0, y * stride, stride);
+            }
+            final Rect alphaBounds = maxX < minX || maxY < minY
+                    ? new Rect() : new Rect(minX, minY, maxX + 1, maxY + 1);
+            final int left = (metrics.widthPixels - width) / 2;
+            final int top = (metrics.heightPixels - height) / 2;
+            final CachedImage image = new CachedImage(file.getAbsolutePath(),
+                    file.lastModified(), file.length(), memory, width, height,
+                    stride, left, top, alphaBounds, hasTransparency);
+            memory = null;
+            return image;
+        } catch (IOException | ArithmeticException | OutOfMemoryError e) {
+            Log.w(TAG, "Could not prepare sleep image overlay cache", e);
+            return null;
+        } finally {
+            if (memory != null) {
+                memory.close();
+            }
+            if (scaled != decoded) {
+                recycleBitmapLocked(scaled);
+            }
+            recycleBitmapLocked(decoded);
+        }
+    }
+
+    /** Uses only a fresh cache on the normal path; decode here is fail-safe only. */
+    private CachedImage obtainImageForSuspend(String path) {
+        if (path == null) {
+            return null;
+        }
+        final File file = new File(path);
+        synchronized (mImageCacheLock) {
+            if (isFreshLocked(mCachedImage, file)) {
+                Log.i(TAG, "Sleep image cache hit path=" + path);
+                return mCachedImage;
+            }
+        }
+
+        Log.w(TAG, "Sleep image cache miss; fail-safe suspend decode path=" + path);
+        final CachedImage decoded = decodeImage(path);
+        if (decoded != null) {
+            replaceCachedImage(decoded);
+        }
+        return decoded;
+    }
+
+    private boolean isFreshLocked(CachedImage image, File file) {
+        return image != null && image.overlayMemory != null
+                && image.path.equals(file.getAbsolutePath())
+                && image.lastModified == file.lastModified()
+                && image.fileLength == file.length();
+    }
+
+    private void registerImageCacheObservers() {
+        final ContentResolver resolver = mContext.getContentResolver();
+        final ContentObserver observer = new ContentObserver(mMainHandler) {
+            @Override
+            public void onChange(boolean selfChange) {
+                scheduleImagePreload("screensaver setting changed");
+            }
+        };
+        resolver.registerContentObserver(Settings.System.getUriFor(
+                ReaderScreensaverSettings.ENABLED), false, observer, UserHandle.USER_ALL);
+        resolver.registerContentObserver(Settings.System.getUriFor(
+                ReaderScreensaverSettings.STYLE), false, observer, UserHandle.USER_ALL);
+        resolver.registerContentObserver(Settings.System.getUriFor(
+                ReaderScreensaverSettings.IMAGE_PATH), false, observer, UserHandle.USER_ALL);
+        resolver.registerContentObserver(Settings.System.getUriFor(
+                ReaderScreensaverSettings.STOCK_IMAGE_PATH), false, observer,
+                UserHandle.USER_ALL);
+    }
+
+    private void scheduleImagePreload(String reason) {
+        final int generation;
+        synchronized (mImageCacheLock) {
+            generation = ++mImageCacheGeneration;
+        }
+        mImagePreloadHandler.removeCallbacksAndMessages(null);
+        mImagePreloadHandler.post(() -> preloadSelectedImage(generation, reason));
+    }
+
+    private void preloadSelectedImage(int generation, String reason) {
+        final ContentResolver resolver = mContext.getContentResolver();
+        final int style = ReaderScreensaverSettings.getStyle(resolver);
+        final String path;
+        if (!ReaderScreensaverSettings.isEnabled(resolver)) {
+            path = null;
+        } else if (style == ReaderScreensaverSettings.STYLE_BASIC) {
+            path = "/system/usr/sleep/suspend.jpg";
+        } else if (style == ReaderScreensaverSettings.STYLE_USER) {
+            path = ReaderScreensaverSettings.getImagePath(resolver);
+        } else {
+            path = "/system/usr/sleep/suspend.jpg";
+        }
+
+        if (path != null) {
+            final File file = new File(path);
+            synchronized (mImageCacheLock) {
+                if (generation != mImageCacheGeneration) {
+                    return;
+                }
+                if (isFreshLocked(mCachedImage, file)) {
+                    Log.i(TAG, "Sleep image preload reused fresh cache reason=" + reason);
+                    return;
+                }
+            }
+        }
+
+        final CachedImage decoded = path == null ? null : decodeImage(path);
+        synchronized (mImageCacheLock) {
+            if (generation != mImageCacheGeneration) {
+                if (decoded != null) {
+                    releaseCachedImageLocked(decoded);
+                }
+                return;
+            }
+            replaceCachedImageLocked(decoded);
+        }
+        Log.i(TAG, "Sleep image preload complete reason=" + reason
+                + " cached=" + (decoded != null));
+    }
+
+    private void replaceCachedImage(CachedImage replacement) {
+        synchronized (mImageCacheLock) {
+            replaceCachedImageLocked(replacement);
+        }
+    }
+
+    private void replaceCachedImageLocked(CachedImage replacement) {
+        final CachedImage old = mCachedImage;
+        mCachedImage = replacement;
+        if (old != null && old != replacement) {
+            releaseCachedImageLocked(old);
+        }
+    }
+
+    private static void recycleBitmapLocked(Bitmap bitmap) {
+        if (bitmap != null && !bitmap.isRecycled()) {
+            bitmap.recycle();
+        }
+    }
+
+    /** Includes the navigation-bar area; resource metrics expose only app space. */
+    private DisplayMetrics getPhysicalPanelMetrics() {
+        final DisplayMetrics metrics = new DisplayMetrics();
+        mWindowManager.getDefaultDisplay().getRealMetrics(metrics);
+        return metrics;
+    }
+
+    private static void releaseCachedImageLocked(CachedImage image) {
+        if (image == null) {
+            return;
+        }
+        if (image.overlayMemory != null) {
+            image.overlayMemory.close();
+        }
+    }
+
+}
