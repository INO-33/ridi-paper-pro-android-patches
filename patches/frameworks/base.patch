diff --git a/core/java/android/view/RidiPageScroll.java b/core/java/android/view/RidiPageScroll.java
new file mode 100644
index 0000000000000000000000000000000000000000..f912ddbe40e65c8b8f58f9943929f87c44246a5c
--- /dev/null
+++ b/core/java/android/view/RidiPageScroll.java
@@ -0,0 +1,220 @@
+/*
+ * Copyright (C) 2026 E70Q10 Android port
+ * Licensed under the Apache License, Version 2.0.
+ */
+package android.view;
+
+import android.os.SystemProperties;
+import android.webkit.WebView;
+import android.widget.AbsListView;
+import android.widget.AbsSeekBar;
+import android.widget.EditText;
+import android.widget.HorizontalScrollView;
+import android.widget.ScrollView;
+
+/** One released swipe submits one immediate page on PAPER scroll containers. @hide */
+final class RidiPageScroll {
+    static final boolean ENABLED = SystemProperties.getBoolean("ro.ridi.eink_mode", false);
+    private final ViewGroup mView;
+    private final int mSlop;
+    private float mDownX, mDownY;
+    private boolean mTracking, mMoved, mCancelledChild, mMultiTouch;
+    private long mDownTime;
+    private int mFirstEdge, mLastEdge;
+
+    RidiPageScroll(ViewGroup view) {
+        mView = view;
+        mSlop = ViewConfiguration.get(view.getContext()).getScaledTouchSlop();
+        view.setOverScrollMode(View.OVER_SCROLL_NEVER);
+        view.setAnimationCacheEnabled(false);
+    }
+
+    static boolean supports(View view) {
+        if (view instanceof AbsListView || view instanceof ScrollView
+                || view instanceof HorizontalScrollView || view instanceof WebView) return true;
+        // Framework must not depend on an app's support-library version.
+        for (Class<?> type = view.getClass(); type != null; type = type.getSuperclass()) {
+            String name = type.getName();
+            if ("android.support.v7.widget.RecyclerView".equals(name)
+                    || "androidx.recyclerview.widget.RecyclerView".equals(name)
+                    || "android.support.v4.widget.NestedScrollView".equals(name)
+                    || "androidx.core.widget.NestedScrollView".equals(name)) return true;
+        }
+        return false;
+    }
+
+    boolean dispatch(MotionEvent event) {
+        int action = event.getActionMasked();
+        if (action == MotionEvent.ACTION_DOWN) {
+            mDownX = event.getX(); mDownY = event.getY();
+            mDownTime = event.getEventTime();
+            mMoved = mCancelledChild = mMultiTouch = false;
+            mTracking = !hasNestedTarget(mView, mDownX, mDownY);
+            return mView.dispatchTouchEventWithoutRidiPaging(event);
+        }
+        if (!mTracking) return mView.dispatchTouchEventWithoutRidiPaging(event);
+        if (action == MotionEvent.ACTION_POINTER_DOWN) {
+            mMultiTouch = true;
+        }
+        // Preserve zoom and other multi-pointer gestures if paging has not taken ownership.
+        if (mMultiTouch && !mCancelledChild) {
+            if (action == MotionEvent.ACTION_UP || action == MotionEvent.ACTION_CANCEL)
+                mTracking = false;
+            return mView.dispatchTouchEventWithoutRidiPaging(event);
+        }
+        float dx = event.getX() - mDownX, dy = event.getY() - mDownY;
+        if (action == MotionEvent.ACTION_MOVE) {
+            if (Math.max(Math.abs(dx), Math.abs(dy)) > mSlop) {
+                mMoved = true;
+                if (!mCancelledChild) {
+                    // End click/pressed/long-press state without ever delivering a drag MOVE.
+                    MotionEvent cancel = MotionEvent.obtain(event);
+                    cancel.setAction(MotionEvent.ACTION_CANCEL);
+                    mView.dispatchTouchEventWithoutRidiPaging(cancel);
+                    cancel.recycle();
+                    mCancelledChild = true;
+                    mView.requestDisallowInterceptTouchEvent(true);
+                }
+            }
+            return true;
+        }
+        if (action == MotionEvent.ACTION_UP) {
+            mTracking = false;
+            mView.requestDisallowInterceptTouchEvent(false);
+            if (mMoved || Math.max(Math.abs(dx), Math.abs(dy)) > mSlop) {
+                if (!mCancelledChild) {
+                    MotionEvent cancel = MotionEvent.obtain(event);
+                    cancel.setAction(MotionEvent.ACTION_CANCEL);
+                    mView.dispatchTouchEventWithoutRidiPaging(cancel);
+                    cancel.recycle();
+                }
+                // A stationary long press is never converted into a page turn.
+                if (!mMultiTouch && event.getEventTime() - mDownTime >= 0
+                        && Math.max(Math.abs(dx), Math.abs(dy)) > mSlop) {
+                    boolean horizontal = mView instanceof HorizontalScrollView
+                            || (mView instanceof WebView && Math.abs(dx) > Math.abs(dy))
+                            || (Math.abs(dx) > Math.abs(dy)
+                                && (mView.canScrollHorizontally(-1)
+                                    || mView.canScrollHorizontally(1)));
+                    float travel = horizontal ? dx : dy;
+                    if (Math.abs(travel) > mSlop) turnPage(horizontal, travel < 0 ? 1 : -1);
+                }
+                return true;
+            }
+            return mView.dispatchTouchEventWithoutRidiPaging(event);
+        }
+        if (action == MotionEvent.ACTION_CANCEL) {
+            mTracking = false;
+            mView.requestDisallowInterceptTouchEvent(false);
+            if (mCancelledChild) return true;
+        }
+        return mCancelledChild || mView.dispatchTouchEventWithoutRidiPaging(event);
+    }
+
+    private static boolean hasNestedTarget(ViewGroup parent, float x, float y) {
+        for (int i = parent.getChildCount() - 1; i >= 0; i--) {
+            View child = parent.getChildAt(i);
+            float cx = x + parent.getScrollX() - child.getLeft();
+            float cy = y + parent.getScrollY() - child.getTop();
+            if (child.getVisibility() != View.VISIBLE || cx < 0 || cy < 0
+                    || cx >= child.getWidth() || cy >= child.getHeight()) continue;
+            if (child instanceof EditText || child instanceof AbsSeekBar) return true;
+            if (supports(child) && (child.canScrollVertically(-1) || child.canScrollVertically(1)
+                    || child.canScrollHorizontally(-1) || child.canScrollHorizontally(1))) return true;
+            if (child instanceof ViewGroup && hasNestedTarget((ViewGroup) child, cx, cy)) return true;
+        }
+        return false;
+    }
+
+    private void turnPage(boolean horizontal, int direction) {
+        if (mView instanceof WebView) {
+            turnWebPage((WebView) mView, horizontal, direction);
+            return;
+        }
+        if (!(horizontal ? mView.canScrollHorizontally(direction)
+                : mView.canScrollVertically(direction))) return;
+        final int start = horizontal ? mView.getPaddingLeft() : mView.getPaddingTop();
+        final int end = horizontal ? mView.getWidth() - mView.getPaddingRight()
+                : mView.getHeight() - mView.getPaddingBottom();
+        int viewport = end - start;
+        if (viewport <= 0) return;
+        mFirstEdge = start; mLastEdge = end;
+        // Root WebView has no native child rows; it uses its exact visible pixel viewport.
+        if (!(mView instanceof WebView)) collectEdges(mView, 0, horizontal, start, end, viewport);
+        int step = direction > 0 ? Math.max(viewport, mLastEdge - start)
+                : Math.max(viewport, end - mFirstEdge);
+        int delta = direction * step;
+        if (mView instanceof AbsListView) {
+            // trackMotionScroll caps one call at height-1. Apply the remainder in the
+            // same input dispatch; invalidations coalesce into one visible frame.
+            int remaining = delta;
+            int limit = Math.max(1, viewport - 1);
+            while (remaining != 0 && mView.canScrollVertically(direction)) {
+                int chunk = Math.max(-limit, Math.min(remaining, limit));
+                ((AbsListView) mView).scrollListBy(chunk);
+                remaining -= chunk;
+            }
+        } else if (mView instanceof ScrollView || mView instanceof HorizontalScrollView
+                || mView instanceof WebView) {
+            int old = horizontal ? mView.getScrollX() : mView.getScrollY();
+            int range = horizontal ? mView.computeHorizontalScrollRange()
+                    : mView.computeVerticalScrollRange();
+            int extent = horizontal ? mView.computeHorizontalScrollExtent()
+                    : mView.computeVerticalScrollExtent();
+            int maximum = Math.max(0, range - extent);
+            if (mView instanceof ScrollView && mView.getChildCount() > 0)
+                maximum = Math.max(0, mView.getChildAt(0).getHeight() - viewport);
+            if (mView instanceof HorizontalScrollView && mView.getChildCount() > 0)
+                maximum = Math.max(0, mView.getChildAt(0).getWidth() - viewport);
+            int next = Math.max(0, Math.min(old + delta, maximum));
+            mView.scrollBy(horizontal ? next - old : 0, horizontal ? 0 : next - old);
+        } else {
+            // RecyclerView.scrollBy performs a synchronous, bounded layout-manager scroll.
+            mView.scrollBy(horizontal ? delta : 0, horizontal ? 0 : delta);
+        }
+    }
+
+    private void turnWebPage(WebView web, boolean horizontal, int direction) {
+        final float scale = web.getScale();
+        if (!(scale > 0)) return;
+        final String script = "(function(x,y,h,d,v){"
+                + "var e=document.elementFromPoint(x,y),root=document.scrollingElement||document.documentElement;"
+                + "while(e&&e!==root&&e!==document.body){var c=getComputedStyle(e),o=h?c.overflowX:c.overflowY;"
+                + "if((o==='auto'||o==='scroll')&&(h?e.scrollWidth>e.clientWidth:e.scrollHeight>e.clientHeight))break;e=e.parentElement;}"
+                + "if(!e||e===document.body)e=root;if(!e)return;"
+                + "var size=Math.min(v,h?e.clientWidth:e.clientHeight);if(size<=0)return;"
+                + "var pos=h?e.scrollLeft:e.scrollTop,max=Math.max(0,(h?e.scrollWidth:e.scrollHeight)-size);"
+                + "var rect=e.getBoundingClientRect(),a=e===root?0:(h?rect.left:rect.top),b=a+size,first=a,last=b,n=0;"
+                + "function edges(p){for(var i=0;i<p.children.length&&n<256;i++){var z=p.children[i];"
+                + "var st=getComputedStyle(z);if(st.position==='fixed'||st.position==='sticky'||st.display==='none')continue;"
+                + "var r=z.getBoundingClientRect(),t=h?r.left:r.top,u=h?r.right:r.bottom;if(t>=b||u<=a)continue;n++;"
+                + "if(u-t>size){edges(z);continue;}first=Math.min(first,t);last=Math.max(last,u);}}edges(e);"
+                + "var step=d>0?Math.max(size,last-a):Math.max(size,b-first),next=Math.max(0,Math.min(max,pos+d*step));"
+                + "var old=e.style.getPropertyValue('scroll-behavior'),priority=e.style.getPropertyPriority('scroll-behavior');"
+                + "e.style.setProperty('scroll-behavior','auto','important');if(h)e.scrollLeft=next;else e.scrollTop=next;"
+                + "if(old)e.style.setProperty('scroll-behavior',old,priority);else e.style.removeProperty('scroll-behavior');"
+                + "})(" + (mDownX / scale) + "," + (mDownY / scale) + "," + horizontal + ","
+                + direction + "," + ((horizontal ? web.getWidth() : web.getHeight()) / scale) + ");";
+        // Runs once on release; no MOVE stream, JavaScript timer, or persistent page injection.
+        web.evaluateJavascript(script, null);
+    }
+
+    private void collectEdges(ViewGroup parent, int origin, boolean horizontal,
+            int start, int end, int viewport) {
+        int scroll = horizontal ? parent.getScrollX() : parent.getScrollY();
+        for (int i = 0; i < parent.getChildCount(); i++) {
+            View child = parent.getChildAt(i);
+            if (child.getVisibility() != View.VISIBLE) continue;
+            int first = origin + (horizontal ? child.getLeft() : child.getTop()) - scroll;
+            int last = first + (horizontal ? child.getWidth() : child.getHeight());
+            if (first >= end || last <= start) continue;
+            if (last - first > viewport) {
+                if (child instanceof ViewGroup)
+                    collectEdges((ViewGroup) child, first, horizontal, start, end, viewport);
+                continue; // Oversized text/image content advances by pixels rather than being skipped.
+            }
+            mFirstEdge = Math.min(mFirstEdge, first);
+            mLastEdge = Math.max(mLastEdge, last);
+        }
+    }
+}
