new file mode 100644
index 0000000000000000000000000000000000000000..d38678b364851ef111f4c82ca54b42a4a0da7d70
--- /dev/null
+++ b/services/core/java/com/android/server/policy/RidiPageRefreshChord.java
@@ -0,0 +1,90 @@
+package com.android.server.policy;
+
+import java.util.ArrayList;
+
+/** Tracks the physical page-key chord separately from ordinary paging. */
+final class RidiPageRefreshChord {
+    static final String SETTING = "ridi_page_key_refresh";
+    static final long WINDOW_MS = 150;
+    private Press up;
+    private Press down;
+    private boolean latched;
+    private final ArrayList<Press> consumed = new ArrayList<>();
+
+    private static final class Press {
+        final boolean pageUp;
+        final int device;
+        final long start;
+        long end = Long.MAX_VALUE;
+        Press(boolean pageUp, int device, long start) {
+            this.pageUp = pageUp;
+            this.device = device;
+            this.start = start;
+        }
+    }
+
+    synchronized boolean onKey(boolean pageUp, boolean pressed, int repeat, boolean canceled,
+            int device, long when, boolean enabled, boolean interactive) {
+        if (!pressed || canceled) {
+            for (Press p : consumed) {
+                if (p.pageUp == pageUp && p.device == device && p.end == Long.MAX_VALUE) {
+                    p.end = when;
+                }
+            }
+            if (pageUp && up != null && up.device == device) up = null;
+            if (!pageUp && down != null && down.device == device) down = null;
+            if (up == null && down == null) latched = false;
+            return false;
+        }
+        if (repeat != 0) return false;
+        for (Press p : consumed) {
+            if (p.pageUp == pageUp && p.device == device && p.end == Long.MAX_VALUE) {
+                p.end = when - 1;
+            }
+        }
+        if (!enabled || !interactive) {
+            up = down = null;
+            latched = false;
+            return false;
+        }
+        Press p = new Press(pageUp, device, when);
+        if (pageUp) up = p;
+        else down = p;
+        // Keep the chord consumed until both keys have been released, even
+        // if one button bounces or is pressed again while the other is held.
+        if (latched) {
+            Press other = pageUp ? down : up;
+            if (other != null && other.device == device) {
+                consumed.add(p);
+                while (consumed.size() > 32) consumed.remove(0);
+            }
+            return false;
+        }
+        if (!latched && up != null && down != null && up.device == down.device
+                && Math.abs(up.start - down.start) <= WINDOW_MS) {
+            latched = true;
+            consumed.add(up);
+            consumed.add(down);
+            while (consumed.size() > 32) consumed.remove(0);
+            return true;
+        }
+        return false;
+    }
+
+    synchronized long dispatchDelay(boolean pageUp, boolean pressed, int repeat,
+            int device, long when, long now, boolean enabled) {
+        // InputReader uses a device-wide downTime for overlapping keys. Match
+        // each key's event-time interval so neither release leaks to the app.
+        for (int i = 0; i < consumed.size(); i++) {
+            Press p = consumed.get(i);
+            if (p.pageUp == pageUp && p.device == device && when >= p.start && when <= p.end) {
+                if (!pressed) consumed.remove(i);
+                return -1;
+            }
+        }
+        if (enabled && pressed && repeat == 0) {
+            return Math.max(0, when + WINDOW_MS - now);
+        }
+        return 0;
+    }
+}
