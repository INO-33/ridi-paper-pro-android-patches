+status_t SurfaceFlinger::cancelEinkSleepOverlay() {
+    const uid_t uid = IPCThreadState::self()->getCallingUid();
+    if (uid != 0 && uid != AID_SYSTEM)
+        return PERMISSION_DENIED;
+    // Invalidate already queued work before waiting on the SF thread.
+    mEinkSleepOverlayEpoch.fetch_add(1, std::memory_order_acq_rel);
+    mEinkSleepOverlaySequence.store(0, std::memory_order_release);
+    status_t result = NO_INIT;
+    sp<MessageBase> msg = new LambdaMessage([this, &result] {
+        result = getHwComposer().cancelEinkSleepOverlay();
+        if (result > 0)
+            repaintEverything();
+    });
+    const status_t posted = postMessageSync(msg);
+    return posted == NO_ERROR ? (result >= 0 ? NO_ERROR : result) : posted;
+}
+
+status_t SurfaceFlinger::requestEinkWakeRefresh() {
+    const uid_t uid = IPCThreadState::self()->getCallingUid();
+    // SystemUI uses android.uid.systemui, not AID_SYSTEM. Authorize its
+    // existing signature permission instead of assuming a fixed app UID.
+    if (uid != 0 && uid != AID_SYSTEM &&
+            !PermissionCache::checkCallingPermission(
+                    String16("android.permission.STATUS_BAR_SERVICE")))
+        return PERMISSION_DENIED;
+    mEinkSleepOverlayEpoch.fetch_add(1, std::memory_order_acq_rel);
+    mEinkSleepOverlaySequence.store(0, std::memory_order_release);
+
+    // Old vendor images reject CANCEL with EINVAL. Do not arm a physical
+    // refresh (and invalidate the next sleep base) when latch release fails.
+    status_t result = NO_INIT;
+    sp<MessageBase> cancel = new LambdaMessage([this, &result] {
+        result = getHwComposer().cancelEinkSleepOverlay();
+    });
+    const status_t cancelled = postMessageSync(cancel);
+    if (cancelled != NO_ERROR)
+        return cancelled;
+    if (result < 0) {
+        ALOGE("RIDI_WAKE vendor HWC cancel failed result=%d; "
+                "refresh not armed (update vendor with system)", result);
+        return result;
+    }
+
+    // Do not set properties on the compositor thread: init can be waiting on
+    // SurfaceFlinger. Arm the existing one-shot gralloc sequence on this
+    // Binder thread BEFORE explicitly scheduling the live frame.
+    const int32_t serial = property_get_int32("sys.ridi.epd.full_refresh_seq", 0);
+    const int32_t next = serial < 0 || serial == INT32_MAX ? 1 : serial + 1;
+    char value[PROPERTY_VALUE_MAX];
+    snprintf(value, sizeof(value), "%d", next);
+    if (property_set("sys.ridi.epd.full_refresh_seq", value) != 0)
+        return UNKNOWN_ERROR;
+
+    // A hidden status bar or a static fullscreen reader may not invalidate
+    // any View at wake. Force ONE compositor repaint, not a timed View loop.
+    sp<MessageBase> msg = new LambdaMessage([this] { repaintEverything(); });
+    return postMessageSync(msg);
+}
+
+int32_t SurfaceFlinger::getEinkSleepSubmitSequence() const {
+    return getHwComposer().getEinkSleepSubmitSequence();
+}
