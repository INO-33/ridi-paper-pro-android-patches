+    for (size_t i = 0; i < primary->numHwLayers; ++i) {
+        int32_t layerPolicy = EINK_POLICY_UNSPECIFIED;
+        static_assert(sizeof(primary->hwLayers[i].reserved) >= sizeof(layerPolicy),
