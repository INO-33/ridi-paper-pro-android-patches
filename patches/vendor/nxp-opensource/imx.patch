+        ctx->epdc_sleep_marker_count = 0;
+        ctx->epdc_sleep_barrier_checked_sequence = 0;
+        ctx->epdc_sleep_barrier_result = 0;
+        __atomic_store_n(&ctx->epdc_sleep_submit_sequence, 0,
+                __ATOMIC_RELEASE);
