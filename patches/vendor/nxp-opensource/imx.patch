+                ctx->epdc_sleep_marker_count * sizeof(ctx->epdc_sleep_markers[0]));
+    ctx->epdc_sleep_barrier_checked_sequence = 0;
+    ctx->epdc_sleep_barrier_result = 0;
+    __atomic_store_n(&ctx->epdc_sleep_submit_sequence, sequence,
+            __ATOMIC_RELEASE);
+    pthread_mutex_unlock(&ctx->epdc_sleep_lock);
+}
