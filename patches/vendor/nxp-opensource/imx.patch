+struct epdc_region_t {
+    int left;
+    int top;
+    int width;
+    int height;
+};
+
+static bool clip_epdc_region(epdc_region_t* region, int width, int height)
+{
+    if (region == NULL || width <= 0 || height <= 0)
+        return false;
+
+    const long long right = static_cast<long long>(region->left) +
+            std::max(0, region->width);
+    const long long bottom = static_cast<long long>(region->top) +
+            std::max(0, region->height);
+    const int left = std::max(0, std::min(width, region->left));
+    const int top = std::max(0, std::min(height, region->top));
+    const long long right_clipped = std::min(static_cast<long long>(width),
+            std::max(0LL, right));
+    const long long bottom_clipped = std::min(static_cast<long long>(height),
+            std::max(0LL, bottom));
+    const int clipped_right = static_cast<int>(std::max(
+            static_cast<long long>(left), right_clipped));
+    const int clipped_bottom = static_cast<int>(std::max(
+            static_cast<long long>(top), bottom_clipped));
+    region->left = left;
+    region->top = top;
+    region->width = clipped_right - left;
+    region->height = clipped_bottom - top;
+    return region->width > 0 && region->height > 0;
+}
+
+static void accumulate_epdc_damage(fb_context_t* ctx,
+        const epdc_region_t& damage)
+{
+    if (!ctx->epdc_pending_damage_valid) {
+        ctx->epdc_pending_damage_left = damage.left;
+        ctx->epdc_pending_damage_top = damage.top;
+        ctx->epdc_pending_damage_width = damage.width;
+        ctx->epdc_pending_damage_height = damage.height;
+        ctx->epdc_pending_damage_valid = true;
+        return;
+    }
+
+    const int right = std::max(
+            ctx->epdc_pending_damage_left + ctx->epdc_pending_damage_width,
+            damage.left + damage.width);
+    const int bottom = std::max(
+            ctx->epdc_pending_damage_top + ctx->epdc_pending_damage_height,
+            damage.top + damage.height);
+    ctx->epdc_pending_damage_left = std::min(
+            ctx->epdc_pending_damage_left, damage.left);
+    ctx->epdc_pending_damage_top = std::min(
+            ctx->epdc_pending_damage_top, damage.top);
+    ctx->epdc_pending_damage_width =
+            right - ctx->epdc_pending_damage_left;
+    ctx->epdc_pending_damage_height =
+            bottom - ctx->epdc_pending_damage_top;
+}
+
+static void clear_pending_epdc_damage(fb_context_t* ctx)
+{
+    ctx->epdc_pending_damage_valid = false;
+    ctx->epdc_pending_damage_left = 0;
+    ctx->epdc_pending_damage_top = 0;
+    ctx->epdc_pending_damage_width = 0;
+    ctx->epdc_pending_damage_height = 0;
+}
+
+/*
+ * Aligns the origin down and the end up where the visible axis permits it.
+ *
+ * The PxP processes 8x8 pixel blocks. When a region ends on a partial block the
+ * EPDC also consumes the pixels past the requested edge: with WAVEFORM_MODE_AUTO
+ * those stale pixels take part in waveform selection, which shows up as a dark
+ * block flashing in that spot. The E70Q10 framebuffer therefore keeps the
+ * stride tail white before the kernel lets PxP expand the rotated input.
+ *
+ * This panel is 1404 pixels on one axis, which is not a multiple of 8. Moving
+ * an aligned rectangle backwards from that edge makes its start 4 pixels out
+ * of alignment (for example 1388), so it does not actually satisfy the PxP
+ * constraint. Keep the start aligned and leave the final width non-aligned;
+ * PxP may consume the four stride pixels beyond the visible edge. The kernel
+ * pan path keeps those 1404..1407 pixels white, so leave the
+ * final width non-aligned and let the normal rotated path crop the padded
+ * output instead of moving the rectangle origin off alignment.
+ */
+static void align_epdc_axis(int* origin, int* size, int limit)
+{
+    const int end = *origin + *size;
+    int start = (*origin / EPDC_REGION_ALIGN) * EPDC_REGION_ALIGN;
+    int aligned_end = ((end + EPDC_REGION_ALIGN - 1) / EPDC_REGION_ALIGN) *
+            EPDC_REGION_ALIGN;
+
+    if (aligned_end > limit)
+        aligned_end = limit;
+
+    *origin = start;
+    *size = aligned_end - start;
+}
+
+static void align_epdc_region(epdc_region_t* region, int width, int height)
+{
+    align_epdc_axis(&region->left, &region->width, width);
+    align_epdc_axis(&region->top, &region->height, height);
+}
+
+/* Grow accumulator to also cover addition. An empty accumulator is replaced. */
+static void union_epdc_region(epdc_region_t* accumulator,
+        const epdc_region_t* addition)
+{
+    if (addition->width <= 0 || addition->height <= 0)
+        return;
+    if (accumulator->width <= 0 || accumulator->height <= 0) {
+        *accumulator = *addition;
+        return;
+    }
+
+    const int left = std::min(accumulator->left, addition->left);
+    const int top = std::min(accumulator->top, addition->top);
+    const int right = std::max(accumulator->left + accumulator->width,
+            addition->left + addition->width);
+    const int bottom = std::max(accumulator->top + accumulator->height,
+            addition->top + addition->height);
+    accumulator->left = left;
+    accumulator->top = top;
+    accumulator->width = right - left;
+    accumulator->height = bottom - top;
+}
+
+/* Refine one coarse component without changing the tile/component topology. */
+static bool refine_epdc_region(const unsigned char* frame,
+        const unsigned char* shadow, int stride, int bytes_per_pixel,
+        epdc_region_t* region)
+{
+    if (frame == NULL || shadow == NULL || region == NULL ||
+            stride <= 0 || bytes_per_pixel <= 0 || region->width <= 0 ||
+            region->height <= 0)
+        return false;
+
+    const int left = region->left;
+    const int top = region->top;
+    const int right = left + region->width;
+    const int bottom = top + region->height;
+    int min_x = right;
+    int min_y = bottom;
+    int max_x = left - 1;
+    int max_y = top - 1;
+
+    for (int y = top; y < bottom; y++) {
+        const unsigned char* frame_pixel = frame + (size_t)y * stride
+                + (size_t)left * bytes_per_pixel;
+        const unsigned char* shadow_pixel = shadow + (size_t)y * stride
+                + (size_t)left * bytes_per_pixel;
+        for (int x = left; x < right; x++) {
+            if (memcmp(frame_pixel, shadow_pixel, bytes_per_pixel) != 0) {
+                min_x = std::min(min_x, x);
+                min_y = std::min(min_y, y);
+                max_x = std::max(max_x, x);
+                max_y = std::max(max_y, y);
+            }
+            frame_pixel += bytes_per_pixel;
+            shadow_pixel += bytes_per_pixel;
+        }
+    }
+
+    if (max_x < min_x || max_y < min_y)
+        return false;
+
+    region->left = min_x;
+    region->top = min_y;
+    region->width = max_x - min_x + 1;
+    region->height = max_y - min_y + 1;
+    return true;
+}
+
+/*
+ * SurfaceFlinger does not pass useful E Ink dirty rectangles through this
+ * legacy framebuffer HAL.  A single pixel bounding box is a poor substitute:
+ * unrelated status-bar and content changes can turn two tiny updates into a
+ * nearly full-screen AUTO waveform.  Recover Tolino-style dirty rectangles by
+ * finding connected components on a coarse tile map.
+ */
+static void expand_epdc_region(epdc_region_t* region, int halo,
+        int width, int height)
+{
+    if (region == NULL || region->width <= 0 || region->height <= 0) {
+        if (region != NULL)
+            *region = {0, 0, 0, 0};
+        return;
+    }
+    const int right = std::min(width, region->left + region->width + halo);
+    const int bottom = std::min(height, region->top + region->height + halo);
+    region->left = std::max(0, region->left - halo);
+    region->top = std::max(0, region->top - halo);
+    region->width = std::max(0, right - region->left);
+    region->height = std::max(0, bottom - region->top);
+}
+
+static int find_changed_regions(const unsigned char* frame,
+        const unsigned char* shadow, int width, int height, int stride,
+        int bytes_per_pixel, int scan_left, int scan_top, int scan_width,
+        int scan_height, epdc_region_t* regions, int max_regions)
+{
+    const int cols = (width + EPDC_DIRTY_TILE - 1) / EPDC_DIRTY_TILE;
+    const int rows = (height + EPDC_DIRTY_TILE - 1) / EPDC_DIRTY_TILE;
+    const int tile_count = cols * rows;
+    bool dirty[EPDC_MAX_TILE_COLS * EPDC_MAX_TILE_ROWS];
+    bool visited[EPDC_MAX_TILE_COLS * EPDC_MAX_TILE_ROWS];
+    int queue[EPDC_MAX_TILE_COLS * EPDC_MAX_TILE_ROWS];
+    const int roi_left = std::max(0, std::min(width, scan_left));
+    const int roi_top = std::max(0, std::min(height, scan_top));
+    const int roi_right = std::max(roi_left, std::min(width,
+            scan_left + std::max(0, scan_width)));
+    const int roi_bottom = std::max(roi_top, std::min(height,
+            scan_top + std::max(0, scan_height)));
+    const int first_col = roi_left / EPDC_DIRTY_TILE;
+    const int last_col = roi_right > roi_left
+            ? (roi_right - 1) / EPDC_DIRTY_TILE : -1;
+    const int first_row = roi_top / EPDC_DIRTY_TILE;
+    const int last_row = roi_bottom > roi_top
+            ? (roi_bottom - 1) / EPDC_DIRTY_TILE : -1;
+    int region_count = 0;
+
+    if (cols > EPDC_MAX_TILE_COLS || rows > EPDC_MAX_TILE_ROWS ||
+            first_col > last_col || first_row > last_row)
+        return -1;
+
+    memset(dirty, 0, tile_count * sizeof(dirty[0]));
+    memset(visited, 0, tile_count * sizeof(visited[0]));
+
+    for (int tile_y = first_row; tile_y <= last_row; tile_y++) {
+        const int tile_top = tile_y * EPDC_DIRTY_TILE;
+        const int tile_bottom = std::min(height,
+                tile_top + EPDC_DIRTY_TILE);
+
+        for (int tile_x = first_col; tile_x <= last_col; tile_x++) {
+            const int tile_left = tile_x * EPDC_DIRTY_TILE;
+            const int tile_right = std::min(width,
+                    tile_left + EPDC_DIRTY_TILE);
+            const int compare_left = std::max(tile_left, roi_left);
+            const int compare_top = std::max(tile_top, roi_top);
+            const int compare_right = std::min(tile_right, roi_right);
+            const int compare_bottom = std::min(tile_bottom, roi_bottom);
+            bool tile_dirty = false;
+
+            for (int y = compare_top; y < compare_bottom; y++) {
+                const unsigned char* frame_row =
+                        frame + y * stride +
+                        compare_left * bytes_per_pixel;
+                const unsigned char* shadow_row =
+                        shadow + y * stride +
+                        compare_left * bytes_per_pixel;
+                if (memcmp(frame_row, shadow_row,
+                        (compare_right - compare_left) * bytes_per_pixel) != 0) {
+                    tile_dirty = true;
+                    break;
+                }
+            }
+
+            if (!tile_dirty)
+                continue;
+
+            dirty[tile_y * cols + tile_x] = true;
+        }
+    }
+    for (int start = 0; start < tile_count; start++) {
+        if (!dirty[start] || visited[start])
+            continue;
+
+        int head = 0;
+        int tail = 0;
+        int min_col = start % cols;
+        int max_col = min_col;
+        int min_row = start / cols;
+        int max_row = min_row;
+        queue[tail++] = start;
+        visited[start] = true;
+
+        while (head < tail) {
+            const int current = queue[head++];
+            const int col = current % cols;
+            const int row = current / cols;
+            const int neighbours[4] = {
+                col > 0 ? current - 1 : -1,
+                col + 1 < cols ? current + 1 : -1,
+                row > 0 ? current - cols : -1,
+                row + 1 < rows ? current + cols : -1
+            };
+
+            if (col < min_col)
+                min_col = col;
+            if (col > max_col)
+                max_col = col;
+            if (row < min_row)
+                min_row = row;
+            if (row > max_row)
+                max_row = row;
+
+            for (int i = 0; i < 4; i++) {
+                const int next = neighbours[i];
+                if (next >= 0 && dirty[next] && !visited[next]) {
+                    visited[next] = true;
+                    queue[tail++] = next;
+                }
+            }
+        }
+
+        if (region_count >= max_regions) {
+            /*
+             * Keep the fixed array bounded without collapsing every dirty
+             * component into one screen-spanning rectangle. Merge this extra
+             * component into the existing region with the smallest area cost;
+             * the normal six-region cap applies another cost pass below.
+             */
+            epdc_region_t component;
+            component.left = std::max(roi_left,
+                    min_col * EPDC_DIRTY_TILE);
+            component.top = std::max(roi_top,
+                    min_row * EPDC_DIRTY_TILE);
+            const int component_right = std::min(roi_right,
+                    (max_col + 1) * EPDC_DIRTY_TILE);
+            const int component_bottom = std::min(roi_bottom,
+                    (max_row + 1) * EPDC_DIRTY_TILE);
+            component.width =
+                    component_right - component.left;
+            component.height =
+                    component_bottom - component.top;
+            if (!refine_epdc_region(frame, shadow, stride, bytes_per_pixel,
+                    &component))
+                continue;
+            align_epdc_region(&component, width, height);
+
+            int best_region = 0;
+            unsigned long long best_extra = ~0ULL;
+            for (int i = 0; i < region_count; ++i) {
+                epdc_region_t merged = {0, 0, 0, 0};
+                union_epdc_region(&merged, &regions[i]);
+                union_epdc_region(&merged, &component);
+                const unsigned long long separate_area =
+                        static_cast<unsigned long long>(regions[i].width) *
+                        regions[i].height +
+                        static_cast<unsigned long long>(component.width) *
+                        component.height;
+                const unsigned long long union_area =
+                        static_cast<unsigned long long>(merged.width) *
+                        merged.height;
+                const unsigned long long extra = union_area > separate_area
+                        ? union_area - separate_area : 0;
+                if (extra < best_extra) {
+                    best_extra = extra;
+                    best_region = i;
+                }
+            }
+            epdc_region_t merged = {0, 0, 0, 0};
+            union_epdc_region(&merged, &regions[best_region]);
+            union_epdc_region(&merged, &component);
+            align_epdc_region(&merged, width, height);
+            regions[best_region] = merged;
+            continue;
+        }
+
+        epdc_region_t* region = &regions[region_count++];
+        region->left = std::max(roi_left, min_col * EPDC_DIRTY_TILE);
+        region->top = std::max(roi_top, min_row * EPDC_DIRTY_TILE);
+        region->width = std::min(roi_right,
+                (max_col + 1) * EPDC_DIRTY_TILE) - region->left;
+        region->height = std::min(roi_bottom,
+                (max_row + 1) * EPDC_DIRTY_TILE) - region->top;
+        if (!refine_epdc_region(frame, shadow, stride, bytes_per_pixel,
+                region)) {
+            --region_count;
+            continue;
+        }
+    }
+
+    return region_count;
+}
+
+static unsigned long long epdc_region_area(const epdc_region_t* region)
+{
+    if (region == NULL || region->width <= 0 || region->height <= 0)
+        return 0;
+    return static_cast<unsigned long long>(region->width) *
+            static_cast<unsigned long long>(region->height);
+}
+
+static bool epdc_region_contains(const epdc_region_t* outer,
+        const epdc_region_t* inner)
+{
+    return outer->left <= inner->left && outer->top <= inner->top &&
+            outer->left + outer->width >= inner->left + inner->width &&
+            outer->top + outer->height >= inner->top + inner->height;
+}
+
+static void remove_epdc_region(epdc_region_t* regions, int* count, int index)
+{
+    for (int i = index + 1; i < *count; ++i)
+        regions[i - 1] = regions[i];
+    --(*count);
+}
+
+/* Clip, align, and remove zero/duplicate/included regions before submission. */
+static int normalize_epdc_regions(epdc_region_t* regions, int count,
+        int width, int height)
+{
+    if (regions == NULL || count <= 0)
+        return 0;
+
+    int normalized_count = 0;
+    for (int i = 0; i < count; ++i) {
+        epdc_region_t region = regions[i];
+        const int right = std::min(width, std::max(0,
+                region.left + std::max(0, region.width)));
+        const int bottom = std::min(height, std::max(0,
+                region.top + std::max(0, region.height)));
+        region.left = std::max(0, std::min(width, region.left));
+        region.top = std::max(0, std::min(height, region.top));
+        region.width = right - region.left;
+        region.height = bottom - region.top;
+        if (region.width <= 0 || region.height <= 0)
+            continue;
+        align_epdc_region(&region, width, height);
+        if (region.width <= 0 || region.height <= 0)
+            continue;
+        regions[normalized_count++] = region;
+    }
+
+    for (int i = 0; i < normalized_count; ++i) {
+        for (int j = i + 1; j < normalized_count;) {
+            if (epdc_region_contains(&regions[i], &regions[j])) {
+                remove_epdc_region(regions, &normalized_count, j);
+            } else if (epdc_region_contains(&regions[j], &regions[i])) {
+                regions[i] = regions[j];
+                remove_epdc_region(regions, &normalized_count, j);
+            } else {
+                ++j;
+            }
+        }
+    }
+    return normalized_count;
+}
+
+/* Merge only nearby regions, or the cheapest pair when the submit cap applies. */
+static int merge_epdc_regions(epdc_region_t* regions, int count,
+        int width, int height, int target_max)
+{
+    if (regions == NULL || count <= 1)
+        return count;
+    target_max = std::max(1, target_max);
+
+    while (count > 1) {
+        const bool cap_forces_merge = count > target_max;
+        int best_i = -1;
+        int best_j = -1;
+        unsigned long long best_extra = ~0ULL;
+        unsigned long long best_union_area = ~0ULL;
+
+        for (int i = 0; i < count; ++i) {
+            const unsigned long long area_a = epdc_region_area(&regions[i]);
+            for (int j = i + 1; j < count; ++j) {
+                epdc_region_t merged = {0, 0, 0, 0};
+                union_epdc_region(&merged, &regions[i]);
+                union_epdc_region(&merged, &regions[j]);
+                const unsigned long long area_b =
+                        epdc_region_area(&regions[j]);
+                const unsigned long long union_area =
+                        epdc_region_area(&merged);
+                const unsigned long long separate_area = area_a + area_b;
+                const unsigned long long extra_area =
+                        union_area > separate_area ?
+                        union_area - separate_area : 0;
+                const bool cheap = extra_area <=
+                        EPDC_REGION_MERGE_EXTRA_AREA ||
+                        union_area * EPDC_REGION_MERGE_RATIO_DEN <=
+                        separate_area * EPDC_REGION_MERGE_RATIO_NUM;
+                if (!cap_forces_merge && !cheap)
+                    continue;
+                if (best_i < 0 || extra_area < best_extra ||
+                        (extra_area == best_extra &&
+                         union_area < best_union_area)) {
+                    best_i = i;
+                    best_j = j;
+                    best_extra = extra_area;
+                    best_union_area = union_area;
+                }
+            }
+        }
+
+        if (best_i < 0)
+            break;
+
+        epdc_region_t merged = {0, 0, 0, 0};
+        union_epdc_region(&merged, &regions[best_i]);
+        union_epdc_region(&merged, &regions[best_j]);
+        align_epdc_region(&merged, width, height);
+        regions[best_i] = merged;
+        remove_epdc_region(regions, &count, best_j);
+    }
+    return count;
+}
+
+static void epdc_refresh(fb_context_t* ctx, private_module_t* m,
+        const unsigned char* frame)
+{
+    const int width = m->info.xres;
+    const int height = m->info.yres;
+    const int stride = m->finfo.line_length;
+    const int bytes_per_pixel = m->info.bits_per_pixel >> 3;
+    const size_t frame_size = stride * height;
+    epdc_region_t regions[EPDC_MAX_DIRTY_REGIONS];
+    int region_count = 1;
+    char force_refresh[PROPERTY_VALUE_MAX];
+    property_get("sys.ridi.epd.full_refresh_seq", force_refresh, "0");
+    const unsigned int force_refresh_serial =
+            (unsigned int)strtoul(force_refresh, NULL, 10);
+    const bool requested_full_refresh =
+            force_refresh_serial != 0
+            && force_refresh_serial != ctx->epdc_force_refresh_serial;
+    if (requested_full_refresh) {
+        /*
+         * Invalidating the shadow forces the existing first-frame path to
+         * submit one full-screen GC16 update even when the pixels did not
+         * otherwise change. A successful post rebuilds the shadow below.
+         */
+        ctx->epdc_shadow_valid = false;
+    }
+
+    /*
+     * One full panel refresh for the first frame presented after boot.
+     *
+     * Everything drawn before this point (the framebuffer target cleared to
+     * black, boot progress, the first launcher frames) reaches the panel as
+     * partial updates, and the pixel comparison correctly reports that most of
+     * the panel did not change. The result was a home screen that was on the
+     * panel but not readable. This is also the moment a full refresh costs
+     * nothing: it replaces content the user never wanted to keep.
+     *
+     * The property is only read until it reads back set, so steady state does
+     * no work. A SurfaceFlinger restart repeats the refresh, which is harmless.
+     */
+    bool boot_refresh = false;
+    if (!ctx->epdc_boot_refresh_done) {
+        char boot_completed[PROPERTY_VALUE_MAX];
+        property_get("sys.boot_completed", boot_completed, "0");
+        if (boot_completed[0] == '1') {
+            ctx->epdc_boot_refresh_done = true;
+            boot_refresh = true;
+            ctx->epdc_shadow_valid = false;
+        }
+    }
+    const int update_policy = ctx->epdc_update_policy;
+    const bool explicit_policy = ctx->epdc_policy_valid &&
+            update_policy != -1 && (update_policy & EINK_POLICY_VALID) != 0;
+    // Policy and damage both describe exactly one subsequent post.
+    ctx->epdc_policy_valid = false;
+    ctx->epdc_update_policy = -1;
+
+    const bool policy_full = explicit_policy &&
+            (update_policy & EINK_UPDATE_MODE_FULL) != 0;
+    const bool policy_wait = explicit_policy &&
+            (update_policy & EINK_WAIT_MODE_WAIT) != 0;
+    const bool sleep_request = explicit_policy &&
+            sleep_sequence_from_policy(update_policy) != 0;
+    const uint32_t sleep_sequence = sleep_request ?
+            sleep_sequence_from_policy(update_policy) : 0;
+    if (sleep_request)
+        begin_sleep_request(ctx, sleep_sequence);
+    /*
+     * Only a genuine application request may override the driver's residue
+     * handling. The framework's own default accompanies every ordinary frame,
+     * so treating it as explicit would disable ghost cleanup everywhere.
+     */
+    const bool policy_app = explicit_policy &&
+            (update_policy & EINK_POLICY_SYSTEM_DEFAULT) == 0;
+    /*
+     * UPDATE_MODE_FULL is an EPDC waveform mode for the supplied rectangle;
+     * it does not expand that rectangle to the panel. Keep physical panel
+     * cleanup separate so a framework FULL on a small damage rect neither
+     * pretends to clean the screen nor resets the periodic cleanup budget.
+     */
+    /* A logical first/full redraw is not a physical panel cleanup. */
+    bool panel_cleanup = requested_full_refresh || boot_refresh ||
+            (policy_full && policy_app);
+    bool full_refresh = panel_cleanup;
+    /*
+     * Only an explicit physical cleanup or WAIT request waits. Ordinary
+     * window redraws do not serialize SurfaceFlinger behind every waveform.
+     */
+    bool wait_for_complete = (panel_cleanup || (policy_wait && policy_app)) &&
+            !sleep_request;
+    const bool explicit_damage = ctx->epdc_damage_valid;
+    const bool explicit_no_damage = ctx->epdc_damage_none;
+    const int target_left = explicit_damage ? ctx->epdc_damage_left : 0;
+    const int target_top = explicit_damage ? ctx->epdc_damage_top : 0;
+    const int target_width = explicit_damage ? ctx->epdc_damage_width : 0;
+    const int target_height = explicit_damage ? ctx->epdc_damage_height : 0;
+    const bool target_oversized = explicit_damage &&
+            (static_cast<unsigned long>(target_width) * target_height * 100 >=
+             static_cast<unsigned long>(width) * height * EPDC_FULL_AREA_PERCENT);
+    epdc_region_t supplied_damage = {0, 0, 0, 0};
+    epdc_region_t input_damage = {0, 0, 0, 0};
+    /*
+     * Region of the shadow this post has to advance: every pixel that differs
+     * from the previously submitted frame, plus every pixel handed to the
+     * panel. An empty rectangle means there is nothing to carry over.
+     */
+    epdc_region_t shadow_sync = {0, 0, 0, 0};
+    const unsigned char* scan_source = frame;
+    bool scan_source_valid = false;
+    bool direct_validation = false;
+
+    if (explicit_damage) {
+        input_damage.left = ctx->epdc_damage_left;
+        input_damage.top = ctx->epdc_damage_top;
+        input_damage.width = ctx->epdc_damage_width;
+        input_damage.height = ctx->epdc_damage_height;
+        clip_epdc_region(&input_damage, width, height);
+        supplied_damage = input_damage;
+        align_epdc_region(&supplied_damage, width, height);
+    }
+    /*
+     * setUpdateRect() describes exactly one subsequent post. Consume it even
+     * if this frame later fails so stale coordinates cannot leak into another
+     * SurfaceFlinger frame.
+     */
+    ctx->epdc_damage_valid = false;
+    ctx->epdc_damage_none = false;
+
+    if (explicit_policy && (update_policy & EINK_POLICY_DISABLE) != 0) {
+        // Do not advance the shadow: it represents the last frame submitted
+        // to the physical panel, not merely the newest framebuffer contents.
+        return;
+    }
+
+    if (bytes_per_pixel <= 0 || frame == NULL) {
+        ALOGE("E70Q10_EPDC invalid frame bpp=%d frame=%p",
+                bytes_per_pixel, frame);
+        return;
+    }
+
+    const bool pending_damage_before_post =
+            ctx->epdc_pending_damage_valid;
+    if (explicit_damage)
+        accumulate_epdc_damage(ctx, supplied_damage);
+
+    if (ctx->epdc_shadow_size != frame_size) {
+        free(ctx->epdc_shadow);
+        free(ctx->epdc_scan);
+        ctx->epdc_shadow = (unsigned char*)malloc(frame_size);
+        ctx->epdc_scan = (unsigned char*)malloc(frame_size);
+        ctx->epdc_shadow_size = ctx->epdc_shadow ? frame_size : 0;
+        ctx->epdc_scan_size = ctx->epdc_scan ? frame_size : 0;
+        ctx->epdc_shadow_valid = false;
+        clear_pending_epdc_damage(ctx);
+        if (ctx->epdc_shadow == NULL)
+            ALOGE("E70Q10_EPDC shadow allocation failed size=%zu", frame_size);
+        if (ctx->epdc_scan == NULL)
+            ALOGE("E70Q10_EPDC scan allocation failed size=%zu", frame_size);
+    }
+
+    if (ctx->epdc_shadow_valid) {
+        const bool accumulated_damage_valid =
+                ctx->epdc_pending_damage_valid;
+        epdc_region_t accumulated_damage = {0, 0, 0, 0};
+        if (accumulated_damage_valid) {
+            accumulated_damage.left = ctx->epdc_pending_damage_left;
+            accumulated_damage.top = ctx->epdc_pending_damage_top;
+            accumulated_damage.width = ctx->epdc_pending_damage_width;
+            accumulated_damage.height = ctx->epdc_pending_damage_height;
+            align_epdc_region(&accumulated_damage, width, height);
+        }
+        const unsigned long accumulated_area =
+                (unsigned long)accumulated_damage.width *
+                accumulated_damage.height;
+        const bool oversized_target_damage = accumulated_damage_valid &&
+                accumulated_area * 100 >=
+                (unsigned long)width * height * EPDC_FULL_AREA_PERCENT;
+
+        direct_validation = explicit_damage && !panel_cleanup &&
+                !oversized_target_damage;
+        epdc_region_t validation_roi = input_damage;
+        if (direct_validation) {
+            if (pending_damage_before_post && accumulated_damage_valid)
+                validation_roi = accumulated_damage;
+            expand_epdc_region(&validation_roi,
+                    EPDC_DAMAGE_VALIDATE_HALO, width, height);
+        }
+
+        if (explicit_no_damage && !accumulated_damage_valid &&
+                !panel_cleanup) {
+            return;
+        } else {
+            /*
+             * A large SurfaceFlinger rectangle is only a conservative upper
+             * bound. For direct damage, use it only as a clipped ROI hint
+             * with an 8-pixel halo; all other paths retain the full diff scan.
+             */
+            const int scan_left = direct_validation ? validation_roi.left : 0;
+            const int scan_top = direct_validation ? validation_roi.top : 0;
+            const int scan_width = direct_validation ? validation_roi.width :
+                    width;
+            const int scan_height = direct_validation ? validation_roi.height :
+                    height;
+            if (!direct_validation && use_cached_epdc_scan() &&
+                    ctx->epdc_scan != NULL &&
+                    ctx->epdc_scan_size == frame_size) {
+                memcpy(ctx->epdc_scan, frame, frame_size);
+                scan_source = ctx->epdc_scan;
+                scan_source_valid = true;
+            }
+            region_count = find_changed_regions(scan_source, ctx->epdc_shadow,
+                    width, height, stride, bytes_per_pixel, scan_left,
+                    scan_top, scan_width, scan_height, regions,
+                    EPDC_MAX_DIRTY_REGIONS);
+
+            bool outside_input = false;
+            if (direct_validation && region_count > 0) {
+                const int input_right = input_damage.left +
+                        input_damage.width;
+                const int input_bottom = input_damage.top +
+                        input_damage.height;
+                for (int i = 0; i < region_count; ++i) {
+                    const epdc_region_t& region = regions[i];
+                    if (region.left < input_damage.left ||
+                            region.top < input_damage.top ||
+                            region.left + region.width > input_right ||
+                            region.top + region.height > input_bottom) {
+                        outside_input = true;
+                        break;
+                    }
+                }
+            }
+
+
+            /*
+             * Remember what the comparison found before the code below
+             * rewrites the region list. The shadow only has to be advanced
+             * over these pixels, and copying the whole panel instead cost
+             * 8-29 ms per post.
+             */
+            for (int i = 0; i < region_count; i++)
+                union_epdc_region(&shadow_sync, &regions[i]);
+
+            if (accumulated_damage_valid) {
+                supplied_damage = accumulated_damage;
+                const bool diff_empty = region_count == 0;
+
+                if (region_count < 0) {
+                    /* Tile map unusable: trust the supplied rectangle alone. */
+                    regions[0] = supplied_damage;
+                    region_count = 1;
+                } else if (diff_empty) {
+                    /*
+                     * Direct damage is only a validation hint: unchanged
+                     * pixels must not trigger a second MXCFB request. The
+                     * explicit full/cleanup path is handled outside this
+                     * branch and remains entitled to submit unchanged pixels.
+                     */
+                    if (direct_validation) {
+                        region_count = 0;
+                    } else {
+                        /*
+                         * A waveform request can be meaningful even when
+                         * framebuffer bytes are unchanged (for example,
+                         * GC16 ghost cleanup). Keep its matching semantic
+                         * damage; redundant ordinary posts may still be
+                         * skipped.
+                         */
+                        const unsigned long supplied_area =
+                                (unsigned long)supplied_damage.width *
+                                supplied_damage.height;
+                        const unsigned long panel_area =
+                                (unsigned long)width * height;
+                        if ((policy_full && policy_app) ||
+                                (policy_app && supplied_area * 100 <
+                                        panel_area * EPDC_FULL_AREA_PERCENT)) {
+                            regions[0] = supplied_damage;
+                            region_count = 1;
+                        } else {
+                            region_count = 0;
+                        }
+                    }
+                }
+            }
+        }
+
+        if (region_count == 0) {
+            if (direct_validation) {
+                if (sleep_request)
+                    record_sleep_submit(ctx, update_policy, NULL, 0);
+                clear_pending_epdc_damage(ctx);
+                return;
+            }
+            if (panel_cleanup ||
+                    (policy_full && policy_app && !explicit_no_damage)) {
+                /* No damage metadata: execute the request on the full panel. */
+                regions[0].left = 0;
+                regions[0].top = 0;
+                regions[0].width = width;
+                regions[0].height = height;
+                region_count = 1;
+            } else {
+                /*
+                 * An ordinary unchanged frame has nothing to defer. Keeping
+                 * its conservative target damage would enlarge the next real
+                 * update even though no pixels from this post remain pending.
+                 * Explicit waveform cleanups take the branch above instead.
+                 */
+                if (sleep_request)
+                    record_sleep_submit(ctx, update_policy, NULL, 0);
+                clear_pending_epdc_damage(ctx);
+                return;
+            }
+        }
+        if (region_count < 0) {
+            regions[0].left = 0;
+            regions[0].top = 0;
+            regions[0].width = width;
+            regions[0].height = height;
+            region_count = 1;
+        }
+    } else {
+        regions[0].left = 0;
+        regions[0].top = 0;
+        regions[0].width = width;
+        regions[0].height = height;
+    }
+
+    /*
+     * An application asking for FULL means "clean the whole panel", so honor it
+     * literally. The framework's system-default FULL is only logical metadata;
+     * it remains an AUTO/PARTIAL region update and never becomes cleanup.
+     */
+    if (policy_full && policy_app) {
+        full_refresh = true;
+    }
+
+    /* A real cleanup is always one GC16 update over the entire glass. */
+    if (panel_cleanup) {
+        regions[0].left = 0;
+        regions[0].top = 0;
+        regions[0].width = width;
+        regions[0].height = height;
+        region_count = 1;
+        /* A failed ioctl must leave the next post on the same cleanup path. */
+        ctx->epdc_shadow_valid = false;
+        full_refresh = true;
+        wait_for_complete = true;
+    }
+
+    /*
+     * MXCFB_WAIT_FOR_UPDATE_COMPLETE takes roughly 0.8 seconds on this panel
+     * and can take up to the kernel's five-second timeout. Never wait once per
+     * dirty tile: ordinary regions remain NOWAIT and share the original policy.
+     * Keep distant components separate; only nearby regions are merged, with a
+     * small cap to bound the number of MXCFB requests.
+     */
+    if (!panel_cleanup && region_count > 0) {
+        region_count = normalize_epdc_regions(regions, region_count,
+                width, height);
+        region_count = merge_epdc_regions(regions, region_count, width, height,
+                EPDC_MAX_SUBMIT_REGIONS);
+        region_count = normalize_epdc_regions(regions, region_count,
+                width, height);
+    }
+
+    /*
+     * Everything above may have replaced the region with a raw rectangle, so
+     * make the final submission aligned no matter which path produced it.
+     */
+    for (int i = 0; i < region_count; i++)
+        align_epdc_region(&regions[i], width, height);
+
+
+    /*
+     * The Settings/SystemUI sequence property explicitly means a physical
+     * GC16 cleanup. It must outrank a persistent per-window REAGL/AUTO mode;
+     * ordinary explicit policies retain their requested waveform.
+     */
+    /*
+     * Waveform precedence:
+     *   1. an external forced refresh is always a GC16 cleanup,
+     *   2. an application's own request is honored verbatim,
+     *   3. ordinary system-default redraws use AUTO, including framework FULL
+     *      metadata that is not an explicit application cleanup.
+     */
+    int waveform;
+    if (panel_cleanup) {
+        waveform = E70Q10_WAVEFORM_GC16;
+    } else if (policy_app) {
+        waveform = decode_eink_waveform(update_policy);
+    } else {
+        waveform = E70Q10_WAVEFORM_AUTO;
+    }
+    /* First-frame/forced safety remains FULL even if a caller asks PARTIAL. */
+    const int update_mode = full_refresh ?
+            UPDATE_MODE_FULL : UPDATE_MODE_PARTIAL;
+    const unsigned int update_flags = explicit_policy ?
+            decode_eink_flags(update_policy) : 0;
+    bool all_submitted = true;
+    uint32_t sleep_markers[MXCFB_E70Q10_MAX_SLEEP_MARKERS];
+    uint32_t sleep_marker_count = 0;
+
+    for (int i = 0; i < region_count; i++) {
+        uint32_t marker = 0;
+        const int update_result = update_to_display(m, regions[i].left,
+                regions[i].top, regions[i].width, regions[i].height,
+                waveform, update_mode, wait_for_complete ? 1 : 0,
+                update_flags, 0, sleep_sequence, &marker);
+        if (update_result < 0) {
+            all_submitted = false;
+        } else if (marker != 0 && sleep_marker_count <
+                MXCFB_E70Q10_MAX_SLEEP_MARKERS) {
+            sleep_markers[sleep_marker_count++] = marker;
+        }
+    }
+    if (!all_submitted)
+        return;
+
+    record_sleep_submit(ctx, update_policy, sleep_markers,
+            sleep_marker_count);
+
+    /* Consume a forced-refresh request only after its GC16 ioctl succeeded. */
+    if (requested_full_refresh)
+        ctx->epdc_force_refresh_serial = force_refresh_serial;
+
+    clear_pending_epdc_damage(ctx);
+
+    if (ctx->epdc_shadow != NULL) {
+        /*
+         * The shadow represents the frame the panel is showing. Advance it over
+         * what changed and over what was just submitted; the rest of the panel
+         * still shows the older pixels, so copying them would claim the EPDC
+         * received content it never did.
+         */
+        for (int i = 0; i < region_count; i++)
+            union_epdc_region(&shadow_sync, &regions[i]);
+
+        const bool whole_frame = !ctx->epdc_shadow_valid ||
+                (shadow_sync.left <= 0 && shadow_sync.top <= 0 &&
+                 shadow_sync.width >= width && shadow_sync.height >= height);
+        const unsigned char* shadow_source = scan_source_valid ?
+                scan_source : frame;
+        if (whole_frame) {
+            memcpy(ctx->epdc_shadow, shadow_source, frame_size);
+        } else {
+            const int copy_left = std::max(0, shadow_sync.left);
+            const int copy_top = std::max(0, shadow_sync.top);
+            const int copy_right = std::min(width,
+                    shadow_sync.left + shadow_sync.width);
+            const int copy_bottom = std::min(height,
+                    shadow_sync.top + shadow_sync.height);
+            const size_t row_bytes =
+                    (size_t)(copy_right - copy_left) * bytes_per_pixel;
+            const size_t row_offset = (size_t)copy_left * bytes_per_pixel;
+            for (int y = copy_top; y < copy_bottom; y++) {
+                memcpy(ctx->epdc_shadow + (size_t)y * stride + row_offset,
+                       shadow_source + (size_t)y * stride + row_offset,
+                       row_bytes);
+            }
+        }
+        ctx->epdc_shadow_valid = true;
+    }
+}
+
+static inline uint8_t rgb565_red(uint16_t pixel)
+{
+    return static_cast<uint8_t>(((pixel >> 11) & 0x1f) * 255 / 31);
+}
+
+static inline uint8_t rgb565_green(uint16_t pixel)
+{
+    return static_cast<uint8_t>(((pixel >> 5) & 0x3f) * 255 / 63);
+}
+
+static inline uint8_t rgb565_blue(uint16_t pixel)
+{
+    return static_cast<uint8_t>((pixel & 0x1f) * 255 / 31);
+}
+
+static inline uint16_t pack_rgb565(uint8_t red, uint8_t green, uint8_t blue)
+{
+    return static_cast<uint16_t>(((red * 31 + 127) / 255) << 11 |
+            ((green * 63 + 127) / 255) << 5 |
+            ((blue * 31 + 127) / 255));
+}
+
+static uint16_t blend_straight_argb_over_rgb565(const uint8_t* source,
+        uint16_t destination)
+{
+    const unsigned int alpha = source[0];
+    if (alpha == 255)
+        return pack_rgb565(source[1], source[2], source[3]);
+    const unsigned int inverse = 255 - alpha;
+    const uint8_t red = static_cast<uint8_t>((source[1] * alpha
+            + rgb565_red(destination) * inverse + 127) / 255);
+    const uint8_t green = static_cast<uint8_t>((source[2] * alpha
+            + rgb565_green(destination) * inverse + 127) / 255);
+    const uint8_t blue = static_cast<uint8_t>((source[3] * alpha
+            + rgb565_blue(destination) * inverse + 127) / 255);
+    return pack_rgb565(red, green, blue);
+}
+
+/* Builds compact sleep-only regions from the tiles proven changed by blending. */
+static int build_sleep_overlay_regions(const bool* dirty_tiles, int cols,
+        int rows, int width, int height, epdc_region_t* regions, int max_regions)
+{
+    int region_count = 0;
+    int overall_left = cols;
+    int overall_top = rows;
+    int overall_right = 0;
+    int overall_bottom = 0;
+    for (int y = 0; y < rows; ++y) {
+        for (int x = 0; x < cols; ++x) {
+            if (!dirty_tiles[y * cols + x])
+                continue;
+            overall_left = std::min(overall_left, x);
+            overall_top = std::min(overall_top, y);
+            overall_right = std::max(overall_right, x + 1);
+            overall_bottom = std::max(overall_bottom, y + 1);
+        }
+    }
+    if (overall_right == 0 || overall_bottom == 0)
+        return 0;
+    for (int tile_y = 0; tile_y < rows; ++tile_y) {
+        int tile_x = 0;
+        while (tile_x < cols) {
+            while (tile_x < cols && !dirty_tiles[tile_y * cols + tile_x])
+                ++tile_x;
+            if (tile_x >= cols)
+                break;
+            const int run_left = tile_x;
+            while (tile_x < cols && dirty_tiles[tile_y * cols + tile_x])
+                ++tile_x;
+            const int run_right = tile_x;
+            bool merged = false;
+            const int pixel_left = run_left * EPDC_DIRTY_TILE;
+            const int pixel_right = std::min(width,
+                    run_right * EPDC_DIRTY_TILE);
+            const int pixel_top = tile_y * EPDC_DIRTY_TILE;
+            const int pixel_bottom = std::min(height,
+                    (tile_y + 1) * EPDC_DIRTY_TILE);
+            for (int i = 0; i < region_count; ++i) {
+                if (regions[i].left == pixel_left
+                        && regions[i].width == pixel_right - pixel_left
+                        && regions[i].top + regions[i].height == pixel_top) {
+                    regions[i].height = pixel_bottom - regions[i].top;
+                    merged = true;
+                    break;
+                }
+            }
+            if (merged)
+                continue;
+            if (region_count >= max_regions) {
+                regions[0].left = overall_left * EPDC_DIRTY_TILE;
+                regions[0].top = overall_top * EPDC_DIRTY_TILE;
+                regions[0].width = std::min(width,
+                        overall_right * EPDC_DIRTY_TILE) - regions[0].left;
+                regions[0].height = std::min(height,
+                        overall_bottom * EPDC_DIRTY_TILE) - regions[0].top;
+                align_epdc_region(&regions[0], width, height);
+                return 1;
+            }
+            regions[region_count].left = pixel_left;
+            regions[region_count].top = pixel_top;
+            regions[region_count].width = pixel_right - pixel_left;
+            regions[region_count].height = pixel_bottom - pixel_top;
+            align_epdc_region(&regions[region_count], width, height);
+            ++region_count;
+        }
+    }
+    return region_count;
+}
+
+static int fb_submitEinkSleepOverlay(framebuffer_device_t* dev,
+        const ridi_eink_sleep_overlay* overlay)
+{
+    if (dev == NULL || overlay == NULL ||
+            overlay->version != RIDI_EINK_SLEEP_OVERLAY_VERSION ||
+            overlay->fd < 0 || overlay->width <= 0 || overlay->height <= 0 ||
+            overlay->stride_bytes != overlay->width * 4 ||
+            overlay->sequence <= 0 || overlay->sequence > 0x3fff ||
+            (overlay->flags & RIDI_EINK_SLEEP_OVERLAY_STRAIGHT_ARGB) == 0) {
+        ALOGE("RIDI_SLEEP overlay invalid request dev=%p req=%p", dev, overlay);
+        return -EINVAL;
+    }
+
+    fb_context_t* ctx = reinterpret_cast<fb_context_t*>(dev);
+    begin_sleep_request(ctx, overlay->sequence);
+    private_module_t* m = reinterpret_cast<private_module_t*>(dev->common.module);
+    const int panel_width = m->info.xres;
+    const int panel_height = m->info.yres;
+    const int framebuffer_stride = m->finfo.line_length;
+    const size_t framebuffer_size = (size_t)framebuffer_stride * panel_height;
+    if (!ctx->epdc_display || !ctx->epdc_shadow_valid ||
+            ctx->epdc_shadow == NULL || ctx->epdc_shadow_size != framebuffer_size ||
+            overlay->alpha_left < 0 || overlay->alpha_top < 0 ||
+            overlay->alpha_right < overlay->alpha_left ||
+            overlay->alpha_bottom < overlay->alpha_top ||
+            overlay->alpha_right > overlay->width ||
+            overlay->alpha_bottom > overlay->height ||
+            overlay->dst_left < 0 || overlay->dst_top < 0 ||
+            overlay->dst_left + overlay->width > panel_width ||
+            overlay->dst_top + overlay->height > panel_height) {
+        ALOGE("RIDI_SLEEP overlay unavailable epdc=%d shadow=%d src=%dx%d "
+                "dst=%d,%d panel=%dx%d alpha=%d,%d-%d,%d",
+                ctx->epdc_display ? 1 : 0, ctx->epdc_shadow_valid ? 1 : 0,
+                overlay->width, overlay->height, overlay->dst_left,
+                overlay->dst_top, panel_width, panel_height,
+                overlay->alpha_left, overlay->alpha_top,
+                overlay->alpha_right, overlay->alpha_bottom);
+        return -EAGAIN;
+    }
+
+    const buffer_handle_t current = m->currentBuffer;
+    if (current == NULL || private_handle_t::validate(current) != 0)
+        return -ENODEV;
+    const private_handle_t* handle =
+            reinterpret_cast<const private_handle_t*>(current);
+    const int page = handle->fbPage >= 0 ? handle->fbPage :
+            handle->offset / E70Q10_FB_PAGE_SIZE;
+    if (!(handle->flags & private_handle_t::PRIV_FLAGS_FRAMEBUFFER) ||
+            page != ctx->epdc_scan_page)
+        return -EAGAIN;
+    if (handle->base == 0) {
+        void* address = NULL;
+        const int lockResult = m->base.lock(&m->base, current,
+                GRALLOC_USAGE_SW_READ_RARELY | GRALLOC_USAGE_SW_WRITE_RARELY,
+                0, 0, panel_width, panel_height, &address);
+        if (lockResult != 0 || address == NULL)
+            return lockResult != 0 ? lockResult : -EFAULT;
+        handle = reinterpret_cast<const private_handle_t*>(current);
+    }
+
+    if ((size_t)overlay->stride_bytes > SIZE_MAX / (size_t)overlay->height)
+        return -EOVERFLOW;
+    const size_t source_size =
+            (size_t)overlay->stride_bytes * (size_t)overlay->height;
+    const int ashmem_size = ashmem_get_size_region(overlay->fd);
+    if (ashmem_size < 0 || static_cast<size_t>(ashmem_size) < source_size) {
+        ALOGE("RIDI_SLEEP overlay invalid ashmem fd=%d size=%d required=%zu",
+                overlay->fd, ashmem_size, source_size);
+        return -EINVAL;
+    }
+    const uint8_t* source = reinterpret_cast<const uint8_t*>(mmap(NULL,
+            source_size, PROT_READ, MAP_SHARED, overlay->fd, 0));
+    if (source == reinterpret_cast<const uint8_t*>(MAP_FAILED)) {
+        ALOGE("RIDI_SLEEP overlay mmap failed fd=%d size=%zu errno=%d",
+                overlay->fd, source_size, errno);
+        return -errno;
+    }
+
+    uint8_t* framebuffer = reinterpret_cast<uint8_t*>(handle->base);
+    bool dirty = false;
+    int dirty_left = panel_width;
+    int dirty_top = panel_height;
+    int dirty_right = 0;
+    int dirty_bottom = 0;
+    const int tile_cols = (panel_width + EPDC_DIRTY_TILE - 1) / EPDC_DIRTY_TILE;
+    const int tile_rows = (panel_height + EPDC_DIRTY_TILE - 1) / EPDC_DIRTY_TILE;
+    if (tile_cols > EPDC_MAX_TILE_COLS || tile_rows > EPDC_MAX_TILE_ROWS) {
+        munmap(const_cast<uint8_t*>(source), source_size);
+        return -E2BIG;
+    }
+    bool dirty_tiles[EPDC_MAX_TILE_COLS * EPDC_MAX_TILE_ROWS];
+    memset(dirty_tiles, 0, sizeof(dirty_tiles));
+    bool has_transparent_pixels = overlay->alpha_left != 0 ||
+            overlay->alpha_top != 0 ||
+            overlay->alpha_right != overlay->width ||
+            overlay->alpha_bottom != overlay->height;
+
+    /* epdc_shadow advances only after successful SEND, so it is panel truth. */
+    for (int source_y = overlay->alpha_top;
+            source_y < overlay->alpha_bottom; ++source_y) {
+        const uint8_t* source_row = source
+                + (size_t)source_y * overlay->stride_bytes;
+        const int destination_y = overlay->dst_top + source_y;
+        const uint16_t* shadow_row = reinterpret_cast<const uint16_t*>(
+                ctx->epdc_shadow + (size_t)destination_y * framebuffer_stride);
+        for (int source_x = overlay->alpha_left;
+                source_x < overlay->alpha_right; ++source_x) {
+            const uint8_t* pixel = source_row + (size_t)source_x * 4;
+            if (pixel[0] == 0) {
+                has_transparent_pixels = true;
+                continue;
+            }
+            const int destination_x = overlay->dst_left + source_x;
+            const uint16_t result = blend_straight_argb_over_rgb565(pixel,
+                    shadow_row[destination_x]);
+            if (result == shadow_row[destination_x])
+                continue;
+            dirty = true;
+            dirty_left = std::min(dirty_left, destination_x);
+            dirty_top = std::min(dirty_top, destination_y);
+            dirty_right = std::max(dirty_right, destination_x + 1);
