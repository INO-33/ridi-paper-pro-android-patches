+static int fb_setUpdateRect(struct framebuffer_device_t* dev,
+        int l, int t, int w, int h)
+{
+    if (dev == NULL)
+        return -EINVAL;
+
+    fb_context_t* ctx = (fb_context_t*)dev;
+    /* One empty rectangle is HWC 1.5's explicit "nothing changed" value. */
+    if (l == 0 && t == 0 && w == 0 && h == 0) {
+        ctx->epdc_damage_valid = false;
+        ctx->epdc_damage_none = true;
+        return 0;
+    }
+    if (((w|h) <= 0) || ((l|t)<0))
+        return -EINVAL;
+
+    if (l >= static_cast<int>(dev->width) ||
+        t >= static_cast<int>(dev->height)) {
+        return -EINVAL;
+    }
+
+    const int right = l + w > static_cast<int>(dev->width) ?
+            dev->width : l + w;
+    const int bottom = t + h > static_cast<int>(dev->height) ?
+            dev->height : t + h;
+    if (right <= l || bottom <= t)
+        return -EINVAL;
+
+    /*
+     * fb0 itself is portrait. The EPDC driver transforms this logical damage
+     * into native panel coordinates together with its PxP pixel rotation.
+     */
+    ctx->epdc_damage_left = l;
+    ctx->epdc_damage_top = t;
+    ctx->epdc_damage_width = right - l;
+    ctx->epdc_damage_height = bottom - t;
+    ctx->epdc_damage_valid = true;
+    ctx->epdc_damage_none = false;
+    return 0;
+}
