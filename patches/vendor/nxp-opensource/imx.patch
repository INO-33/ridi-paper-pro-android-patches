+static int32_t hwc_get_eink_sleep_submit_sequence(
+        hwc_composer_device_1_t* dev)
+{
+    hwc_context_t* ctx = reinterpret_cast<hwc_context_t*>(dev);
+    if (ctx == NULL || ctx->mFramebuffer == NULL ||
+            ctx->mFramebuffer->reserved_proc[1] == NULL)
+        return 0;
