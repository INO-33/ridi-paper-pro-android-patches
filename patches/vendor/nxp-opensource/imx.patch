+            error = write_led_channel(channels[i], 1);
+            if (error && !result)
+                result = error;
+        }
+    }
+    pthread_mutex_unlock(&battery_led_lock);
+    if (result)
+        ALOGE("E70Q10 battery LED update failed: %d", result);
+    return result;
+}
