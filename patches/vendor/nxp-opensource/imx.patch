+    if (operation == RIDI_EINK_EXTENSION_GET_SLEEP_SUBMIT_SEQUENCE)
+        return hwc_get_eink_sleep_submit_sequence(dev);
+    if (operation != RIDI_EINK_EXTENSION_SUBMIT_SLEEP_OVERLAY || payload == NULL)
+        return -EINVAL;
