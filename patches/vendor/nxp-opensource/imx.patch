+            reinterpret_cast<get_eink_sleep_sequence_fn>(
+                    ctx->mFramebuffer->reserved_proc[1]);
+    return getSequence(ctx->mFramebuffer);
+}
+
+static int32_t hwc_ridi_eink_extension(hwc_composer_device_1_t* dev,
+        int32_t operation, void* payload)
+{
+    hwc_context_t* ctx = reinterpret_cast<hwc_context_t*>(dev);
+    if (ctx == NULL)
+        return -EINVAL;
+    if (operation == RIDI_EINK_EXTENSION_CANCEL_SLEEP_OVERLAY) {
+        const bool wasLatched = ctx->mSleepOverlayLatched;
+        ctx->mSleepOverlayLatched = false;
+        return wasLatched ? 1 : 0;
