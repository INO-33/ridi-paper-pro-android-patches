+/* The E70Q10 RGB channels are binary GPIO LEDs, not PWM outputs. */
+static pthread_mutex_t battery_led_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static int write_led_channel(const char *filename, int on)
+{
+    int fd, error = 0;
+    ssize_t written;
+    const char value = on ? '1' : '0';
+
+    fd = open(filename, O_WRONLY | O_CLOEXEC);
+    if (fd < 0)
+        return -errno;
+    do {
+        written = write(fd, &value, 1);
+    } while (written < 0 && errno == EINTR);
+    if (written != 1)
+        error = written < 0 ? -errno : -EIO;
+    close(fd);
+    return error;
+}
