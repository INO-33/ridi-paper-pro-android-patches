+    ctx->epdc_sleep_requested_sequence = sequence;
+    ctx->epdc_sleep_marker_sequence = sequence;
+    ctx->epdc_sleep_marker_count = std::min(marker_count,
+            (uint32_t)MXCFB_E70Q10_MAX_SLEEP_MARKERS);
+    if (ctx->epdc_sleep_marker_count != 0)
