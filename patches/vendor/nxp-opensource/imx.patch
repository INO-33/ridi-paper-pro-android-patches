+static int32_t merge_eink_policy(int32_t current, int32_t incoming)
+{
+    if (incoming == EINK_POLICY_UNSPECIFIED ||
+        (incoming & EINK_POLICY_VALID) == 0)
+        return current;
+    if (current == EINK_POLICY_UNSPECIFIED)
+        return incoming;
+    if ((current & EINK_POLICY_DISABLE) != 0)
+        return current;
+    if ((incoming & EINK_POLICY_DISABLE) != 0)
+        return incoming;
+
+    /*
+     * AUTOMATIC belongs to the waveform selector. Preserve it only from the
+     * policy that wins waveform priority so GC16|FULL cannot become AUTO|FULL
+     * when another layer contributes its default automatic mode.
+     */
+    const int32_t waveformSelectorMask =
+            EINK_WAVEFORM_MASK | EINK_AUTO_MODE_AUTOMATIC;
+    const int32_t waveformSelector =
+            eink_waveform_priority(incoming) > eink_waveform_priority(current)
+            ? (incoming & waveformSelectorMask)
+            : (current & waveformSelectorMask);
+    int32_t merged =
+            ((current | incoming) & ~waveformSelectorMask) | waveformSelector;
+    /*
+     * One application request among the composed layers makes the whole frame
+     * application-driven; the system-default marker must not survive it.
+     */
+    if ((current & EINK_POLICY_SYSTEM_DEFAULT) == 0 ||
+        (incoming & EINK_POLICY_SYSTEM_DEFAULT) == 0) {
+        merged &= ~EINK_POLICY_SYSTEM_DEFAULT;
+    }
+    return merged;
+}
