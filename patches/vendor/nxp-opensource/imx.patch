+static int eink_waveform_priority(int32_t policy)
+{
+    if ((policy & EINK_AUTO_MODE_AUTOMATIC) != 0)
+        return 50;
+    switch (policy & EINK_WAVEFORM_MASK) {
+    case 2: return 100; // GC16
+    case 7:             // REAGL/GLR16
+    case 8: return 90;  // REAGLD/GLD16
+    case 6: return 80;  // GL16
+    case 3: return 70;  // GC4
+    case 1: return 40;  // DU
+    case 4:             // ANIM
+    case 5: return 30;  // A2
+    default: return 0;
+    }
